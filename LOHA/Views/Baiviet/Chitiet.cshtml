@model LOHA.Models.Baiviet //chỉ nhận 1 bv không phải list

<div class="container mt-4">

    <a href="/Baiviet/Index" class="btn btn-secondary mb-3">
        ← Quay lại bảng feed
    </a>

    <div class="card">
        <div class="card-body">

            <!--Thông tin người đăng-->
            <div style="display:flex; align-items:center; margin-bottom:10px">
                <img src="/images/default.png"
                     style="width:40px;height:40px;border-radius:50%;margin-right:10px" />

                <div>
                    <strong>@Model.User?.Ten</strong> <!--nếu user khác null thì lấy tên, null thì bỏ qua-->
                    <span style="color:gray;font-size:13px">
                        @Model.Ngaydang
                    </span>
                </div>
            </div>

            <!--Nội dung bài viết-->
            <p>@Model.Noidung</p>

            @if (Model.Anh != null)
            {
                <img src="/baiviet/@Model.Anh"
                     style="max-width:100%;border-radius:10px" />
            }

            <hr />

            <!--Lượt thích-->
            <div>
                👍 @(Model.Thichs != null ? Model.Thichs.Count : 0) Lượt thích
            </div>

        </div>
    </div>

    <!--KHU VỰC BÌNH LUẬN-->

    <div class="mt-4">

        <h5>Bình luận</h5>

        @if (Model.Binhluans != null && Model.Binhluans.Count > 0)
        {
            foreach (var bl in Model.Binhluans)
            {
                <div style="margin-bottom:10px">

                    <strong>@bl.User?.Ten:</strong>
                    @bl.Noidung

                    <div style="font-size:12px;color:gray">
                        @bl.Ngaydang
                    </div>

                </div>
            }
        }
        else
        {
            <p style="color:gray">Chưa có bình luận</p>
        }

    </div>

    <!--FORM VIẾT BÌNH LUẬN-->

    <form method="post" action="/Baiviet/ThemBinhLuan" class="mt-3">

        <input type="hidden" name="baivietId" value="@Model.Id" /> <!--cmt thuộc bài viết nào-->

        <div class="input-group">

            <input type="text"
                   name="noidung"
                   class="form-control"
                   placeholder="Viết bình luận..." />

            <button class="btn btn-primary">
                Gửi
            </button>

        </div>

    </form>

</div>