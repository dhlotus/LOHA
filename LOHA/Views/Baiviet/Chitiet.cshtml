@model LOHA.Models.Baiviet

@{
    ViewData["Title"] = "Chi tiết bài viết";
    var userId = Context.Session.GetString("user");
    var currentUserId = ViewBag.CurrentUserId as int?;
    
    // Avatar mặc định
    string avatarDefault = "/images/default.png";
    string userAvatar = string.IsNullOrEmpty(Model.User?.Avatar) ? avatarDefault : Model.User.Avatar;
    
    // Lấy danh sách avatar người đã like (tối đa 3)
    var nguoiThichs = Model.Thichs?.Take(3).Select(t => t.User?.Avatar ?? avatarDefault).ToList() ?? new List<string>();
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<div class="container mt-4" style="max-width: 680px; padding-bottom: 20px;">

    <!-- ===== CARD BÀI VIẾT MAGAZINE UI ===== -->
    <div class="magazine-card">
        
        <!-- HEADER NỔI - Avatar đè lên mép trên -->
        <div class="magazine-header">
            <div class="magazine-avatar-wrapper">
                <img src="@userAvatar" class="magazine-avatar" alt="@Model.User?.Ten" />
            </div>
            <div class="magazine-author">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="magazine-name">@Model.User?.Ten</h5>
                    <span class="magazine-tag">
                        <i class="fa-regular fa-star"></i> Loha-Kin
                    </span>
                </div>
                <div class="magazine-meta">
                    <i class="fa-regular fa-clock"></i> @Model.Ngaydang.ToString("dd/MM/yyyy HH:mm")
                    <span class="mx-2">•</span>
                </div>
            </div>
            <div class="dropdown">
                <button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown">
                    <span class="material-icons-outlined">more_vert</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item text-danger" onclick="openDeleteModal(@Model.Id)"><i class="fa-regular fa-trash-can me-2"></i>Xóa bài viết</a></li>
                </ul>
            </div>
        </div>

        <!-- NỘI DUNG CHÍNH -->
        <div class="magazine-body">
            <!-- Nội dung đầy đủ -->
            <p class="magazine-content">@Model.Noidung</p>
        </div>

        <!-- ẢNH NỔI - Bo góc mạnh + Shadow -->
        @if (!string.IsNullOrEmpty(Model.Anh))
        {
            <div class="magazine-image-wrapper">
                <img src="/baiviet/@Model.Anh" class="magazine-image" alt="Bài viết" />
            </div>
        }

        <!-- THANH TƯƠNG TÁC NỔI - AVATAR STACK -->
        <div class="magazine-interaction">
            <!-- Avatar Stack người đã like -->
            <div class="magazine-avatar-stack" onclick="document.querySelector('.magazine-stats-popup').classList.toggle('show')">
                @if (nguoiThichs.Any())
                {
                    @foreach (var avt in nguoiThichs)
                    {
                        <img src="@avt" class="stack-avatar" />
                    }
                    @if (Model.Thichs.Count > 3)
                    {
                        <span class="stack-more">+@(Model.Thichs.Count - 3)</span>
                    }
                }
                else
                {
                    <div class="stack-empty">
                        <i class="fa-regular fa-heart"></i>
                    </div>
                }
            </div>
            
            <!-- Popup thống kê nhanh -->
            <div class="magazine-stats-popup">
                <span><i class="fa-regular fa-heart" style="color: #FF4D6D;"></i> @Model.Thichs.Count lượt thích</span>
                <span class="mx-2">•</span>
                <span><i class="fa-regular fa-comment" style="color: var(--loha-primary);"></i> @(Model.Binhluans?.Count ?? 0) bình luận</span>
            </div>
            
            <!-- Pill Tương tác -->
            <div class="magazine-action-pill">
                <button onclick="thichBaiViet(@Model.Id)" class="pill-btn @(ViewBag.Thichs?.Contains(Model.Id) == true ? "active" : "")" id="like-btn-@Model.Id">
                    <i class="fa-regular fa-heart"></i>
                </button>
                <button class="pill-btn" onclick="document.getElementById('noidung-binhluan').focus()">
                    <i class="fa-regular fa-comment"></i>
                </button>
            </div>
        </div>

        <!-- STATS ĐẦY ĐỦ (ẩn mặc định) -->
        <div class="magazine-full-stats">
            <div class="d-flex justify-content-around py-3 border-top border-bottom">
                <div class="stat-item">
                    <i class="fa-regular fa-heart" style="color: #FF4D6D;"></i>
                    <span id="total-like-@Model.Id">@Model.Thichs.Count</span>
                    <span>lượt thích</span>
                </div>
                <div class="stat-item">
                    <i class="fa-regular fa-comment" style="color: var(--loha-primary);"></i>
                    <span id="total-comment-@Model.Id">@(Model.Binhluans?.Count ?? 0)</span>
                    <span>bình luận</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== KHU VỰC BÌNH LUẬN ===== -->
    <div class="comment-section mt-4">
        <div class="comment-section-header">
            <h5>
                <i class="fa-regular fa-comments me-2" style="color: var(--loha-primary);"></i>
                Bình luận <span id="comment-count-header">(@(Model.Binhluans?.Count ?? 0))</span>
            </h5>
        </div>
    
        <div class="comment-section-body">
            <!-- ===== Ô INPUT BÌNH LUẬN (ĐẶT LÊN TRÊN) ===== -->
            @if (!string.IsNullOrEmpty(userId))
            {
                <div class="comment-input-wrapper-magazine">
                    <div class="comment-input-field">
                        <input type="text" id="noidung-binhluan" placeholder="Viết bình luận..."
                               onkeypress="if(event.key === 'Enter') guiBinhLuan(@Model.Id)" />
                        <button onclick="guiBinhLuan(@Model.Id)" class="comment-send-btn">
                            <i class="fa-regular fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light rounded-pill mt-3 text-center">
                    <i class="fa-regular fa-circle-info me-2"></i>
                    Vui lòng <a href="/User/DangNhap" class="text-decoration-none fw-bold" style="color: var(--loha-primary);">đăng nhập</a> để bình luận.
                </div>
            }
        
            <!-- ===== DANH SÁCH BÌNH LUẬN (CÓ THỂ KÉO XEM) ===== -->
            <div id="danh-sach-binhluan" class="comment-list" style="max-height: 400px; overflow-y: auto; padding-right: 8px;">
                @if (Model.Binhluans != null && Model.Binhluans.Any())
                {
                    @foreach (var bl in Model.Binhluans.OrderByDescending(b => b.Ngaydang))
                    {
                        string commentAvatar = string.IsNullOrEmpty(bl.User?.Avatar) ? avatarDefault : bl.User.Avatar;
                        bool coQuyenXoa = (currentUserId != null && currentUserId == bl.UserId)
                                       || (currentUserId != null && currentUserId == Model.UserId);
                    
                        <div class="comment-item-magazine" id="binhluan-@bl.Id">
                            <img src="@commentAvatar" class="comment-avatar-magazine" />
                            <div class="comment-bubble-magazine">
                                <div class="comment-header-magazine">
                                    <span class="comment-name">@bl.User?.Ten</span>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="comment-time">@bl.Ngaydang.ToString("HH:mm dd/MM")</span>
                                        @if (coQuyenXoa)
                                        {
                                            <button class="btn-delete-comment-magazine" onclick="xoaBinhLuan(@bl.Id)" title="Xóa bình luận">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <p class="comment-text-magazine">@bl.Noidung</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="comment-empty" id="khong-co-bl">
                        <i class="fa-regular fa-comment-dots"></i>
                        <p>Chưa có bình luận nào. Hãy là người đầu tiên!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== CSS MAGAZINE UI ===== -->
<style>
    /* Card chính - Magazine */
    .magazine-card {
        background: #FFFFFF;
        border-radius: 36px;
        box-shadow: 0 20px 40px -10px rgba(109, 93, 252, 0.08), 0 8px 20px rgba(0, 0, 0, 0.02);
        padding: 0 24px 24px;
        margin-bottom: 20px;
        position: relative;
        transition: all 0.3s ease;
        border: 1px solid rgba(109, 93, 252, 0.06);
    }

    /* Header - Avatar nổi */
    .magazine-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding-top: 20px;
        margin-bottom: 20px;
    }

    .magazine-avatar-wrapper {
        margin-top: -40px;
        position: relative;
        z-index: 2;
    }

    .magazine-avatar {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 12px 24px -8px rgba(109, 93, 252, 0.2);
        background: white;
    }

    .magazine-author {
        flex: 1;
        padding-top: 4px;
    }

    .magazine-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: #2D1B69;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .magazine-tag {
        background: linear-gradient(135deg, #F3F0FF, #EDE9FF);
        color: var(--loha-primary);
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .magazine-meta {
        font-size: 13px;
        color: #8A8A9E;
        margin-top: 6px;
        display: flex;
        align-items: center;
    }

    /* Body */
    .magazine-body {
        margin-bottom: 20px;
    }

    .magazine-headline {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1F1147;
        margin-bottom: 12px;
        line-height: 1.4;
        letter-spacing: -0.5px;
    }

    .magazine-content {
        font-size: 1rem;
        line-height: 1.7;
        color: #5E5A6E;
        margin-bottom: 0;
    }

    /* Ảnh nổi */
    .magazine-image-wrapper {
        margin: 20px -12px 24px;
        padding: 8px;
        background: white;
        border-radius: 32px;
        box-shadow: 0 20px 35px -8px rgba(109, 93, 252, 0.12);
    }

    .magazine-image {
        width: 100%;
        max-height: 600px;
        object-fit: cover;
        border-radius: 24px;
        display: block;
        transition: transform 0.3s ease;
    }

    /* Thanh tương tác */
    .magazine-interaction {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0 8px;
        position: relative;
    }

    /* Avatar Stack */
    .magazine-avatar-stack {
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .stack-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid white;
        margin-left: -8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

        .stack-avatar:first-child {
            margin-left: 0;
        }

    .stack-more {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--loha-primary);
        color: white;
        font-size: 11px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        margin-left: -8px;
    }

    .stack-empty {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #F3F0FF;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--loha-primary);
        font-size: 14px;
    }

    /* Stats Popup */
    .magazine-stats-popup {
        position: absolute;
        left: 0;
        top: -40px;
        background: white;
        padding: 8px 16px;
        border-radius: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        font-size: 13px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .magazine-stats-popup.show {
            opacity: 1;
            visibility: visible;
            top: -50px;
        }

    /* Action Pill */
    .magazine-action-pill {
        display: flex;
        gap: 4px;
        background: #F8F7FF;
        padding: 6px;
        border-radius: 60px;
        box-shadow: 0 4px 12px rgba(109, 93, 252, 0.08);
    }

    .pill-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: #5E5A6E;
        font-size: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .pill-btn:hover {
            background: white;
            color: var(--loha-primary);
            transform: scale(1.05);
        }

        .pill-btn.active {
            color: #FF4D6D;
            background: white;
        }

    /* Full Stats */
    .magazine-full-stats {
        padding-top: 8px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #5E5A6E;
    }

        .stat-item span:first-of-type {
            font-weight: 700;
            color: #2D1B69;
            margin-right: 4px;
        }

    /* Comment Section */
    .comment-section {
        background: white;
        border-radius: 28px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(109, 93, 252, 0.04);
    }

    .comment-section-header {
        margin-bottom: 20px;
    }

        .comment-section-header h5 {
            font-weight: 700;
            color: #2D1B69;
            margin: 0;
        }

    .comment-item-magazine {
        display: flex;
        gap: 14px;
        margin-bottom: 20px;
    }

    .comment-avatar-magazine {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .comment-bubble-magazine {
        flex: 1;
        background: #F8F9FE;
        padding: 14px 18px;
        border-radius: 20px 20px 20px 8px;
    }

    .comment-header-magazine {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .comment-name {
        font-weight: 700;
        color: #2D1B69;
        font-size: 14px;
    }

    .comment-time {
        font-size: 11px;
        color: #8A8A9E;
    }

    .comment-text-magazine {
        font-size: 14px;
        color: #5E5A6E;
        margin: 0;
        line-height: 1.5;
    }

    .comment-empty {
        text-align: center;
        padding: 40px 20px;
        color: #8A8A9E;
    }

        .comment-empty i {
            font-size: 40px;
            margin-bottom: 12px;
            opacity: 0.5;
        }

    /* Comment Input */
    .comment-input-wrapper-magazine {
        display: flex;
        gap: 14px;
        margin: 20px 0 14px;
        padding-top: 20px;
        border-top: 1px solid rgba(109, 93, 252, 0.08);
    }


    .comment-input-field {
        flex: 1;
        display: flex;
        align-items: center;
        background: #F8F9FE;
        border-radius: 60px;
        padding: 4px 8px 4px 20px;
        border: 1.5px solid transparent;
        transition: all 0.2s;
    }

        .comment-input-field:focus-within {
            border-color: var(--loha-primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(109, 93, 252, 0.06);
        }

        .comment-input-field input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 12px 0;
            font-size: 14px;
            outline: none;
        }

    .comment-send-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--loha-primary);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

        .comment-send-btn:hover {
            background: var(--loha-secondary);
            transform: scale(1.05);
        }

    /* Responsive */
    @@media (max-width: 576px) {
        .magazine-card {
            padding: 0 16px 20px;
            border-radius: 28px;
        }
        
        .magazine-avatar {
            width: 56px;
            height: 56px;
        }
        
        .magazine-headline {
            font-size: 1.2rem;
        }
        
        .magazine-action-pill {
            padding: 4px;
        }
        
        .pill-btn {
            width: 40px;
            height: 40px;
        }
    }
    /* Nút xóa bình luận */
    .btn-delete-comment-magazine {
        background: transparent;
        border: none;
        color: #8A8A9E;
        font-size: 12px;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 50%;
        transition: all 0.2s;
        opacity: 0;
    }

    .comment-item-magazine:hover .btn-delete-comment-magazine {
        opacity: 1;
    }

    .btn-delete-comment-magazine:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #EF4444;
    }

    /* Thanh cuộn cho danh sách bình luận */
    .comment-list::-webkit-scrollbar {
        width: 4px;
    }

    .comment-list::-webkit-scrollbar-track {
        background: #F3F0FF;
        border-radius: 10px;
    }

    .comment-list::-webkit-scrollbar-thumb {
        background: var(--loha-primary);
        border-radius: 10px;
    }

    .btn .material-icons-outlined {
        font-size: 20px;
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        // Like function
        function thichBaiViet(id) {
            fetch("/Baiviet/ThichBaiViet?baiVietId=" + id, { method: "POST" })
            .then(response => response.json())
            .then(data => {
                document.getElementById("total-like-" + id).innerText = data.soLuong;
                
                var btn = document.getElementById("like-btn-" + id);
                if (data.daThich) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
                
                // Reload để cập nhật avatar stack
                location.reload();
            });
        }

        // Gửi bình luận
        function guiBinhLuan(baivietId) {
            var noidung = document.getElementById("noidung-binhluan").value.trim();
            if (noidung === "") return;

            fetch("/Baiviet/ThemBinhLuan", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `baivietId=${baivietId}&noidung=${encodeURIComponent(noidung)}&anchor=`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }
                // Hàm xóa bình luận
        function xoaBinhLuan(id) {
            if (!confirm('Bạn có chắc muốn xóa bình luận này?')) return;
    
            fetch('/Baiviet/XoaBinhLuan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Xóa bình luận khỏi giao diện
                    document.getElementById('binhluan-' + id)?.remove();
            
                    // Cập nhật số lượng
                    document.getElementById('comment-count-header').innerText = '(' + data.soLuong + ')';
                    document.getElementById('total-comment-' + @Model.Id).innerText = data.soLuong;
            
                    // Nếu hết bình luận, hiện thông báo trống
                    if (data.soLuong === 0) {
                        document.getElementById('danh-sach-binhluan').innerHTML = `
                            <div class="comment-empty">
                                <i class="fa-regular fa-comment-dots"></i>
                                <p>Chưa có bình luận nào. Hãy là người đầu tiên!</p>
                            </div>
                        `;
                    }
                } else {
                    alert(data.message);
                }
            });
        }
                let deletePostId = 0;

                        // Khai báo global để popup trong _Layout có thể gọi
        window.confirmDeletePost = function() {
            var id = document.getElementById('confirmXoaBaiVietModal').getAttribute('data-post-id');
    
            fetch('/Baiviet/XoaBaiViet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(res => res.json())
            .then(data => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('confirmXoaBaiVietModal'));
                modal.hide();
        
                if (data.success) {
                    // Dùng Toast thay vì alert
                    showToast('Đã xóa bài viết thành công!', 'success');
                    // Chuyển về trang chủ sau 1 giây (để thấy toast)
                    setTimeout(() => {
                        window.location.href = '/Baiviet/Index';
                    }, 1000);
                } else {
                    showToast(data.message || 'Có lỗi xảy ra', 'error');
                }
            })
            .catch(error => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('confirmXoaBaiVietModal'));
                modal.hide();
                showToast('Có lỗi xảy ra', 'error');
            });
        };
                // Hàm hiển thị Toast thông báo
        function showToast(message, type = 'success') {
            let toastContainer = document.getElementById('toast-container');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'toast-container';
                toastContainer.style.cssText = 'position:fixed; top:20px; right:20px; z-index:9999;';
                document.body.appendChild(toastContainer);
            }
    
            const toast = document.createElement('div');
            toast.style.cssText = `
                background: ${type === 'success' ? '#10B981' : '#EF4444'};
                color: white;
                padding: 12px 20px;
                border-radius: 12px;
                margin-bottom: 10px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                display: flex;
                align-items: center;
                gap: 10px;
                animation: slideIn 0.3s ease;
                min-width: 250px;
            `;
    
            const icon = type === 'success' ? 'check_circle' : 'error_outline';
            toast.innerHTML = `
                <span class="material-icons-outlined">${icon}</span>
                <span style="flex:1;">${message}</span>
                <button onclick="this.parentElement.remove()" style="background:none;border:none;color:white;cursor:pointer;opacity:0.7;">×</button>
            `;
    
            toastContainer.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Thêm animation CSS
        if (!document.getElementById('toast-animation-style')) {
            const style = document.createElement('style');
            style.id = 'toast-animation-style';
            style.textContent = `
                @@keyframes slideIn {
                    from { transform: translateX(100%); opacity: 0; }
                    to { transform: translateX(0); opacity: 1; }
                }
            `;
            document.head.appendChild(style);
        }
        // Mở popup xác nhận xóa
        function openDeleteModal(id) {
            document.getElementById('confirmXoaBaiVietModal').setAttribute('data-post-id', id);
            var modal = new bootstrap.Modal(document.getElementById('confirmXoaBaiVietModal'));
            modal.show();
        }
    </script>
}