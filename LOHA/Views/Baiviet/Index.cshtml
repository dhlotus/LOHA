@model List<LOHA.Models.Baiviet>

@functions {
    public string Tinhthoigian(DateTime ngaydang)
    {
        var khoangthoigian = DateTime.Now - ngaydang;
        if (khoangthoigian.TotalMinutes < 1) return "Vừa xong";
        if (khoangthoigian.TotalMinutes < 60) return $"{(int)khoangthoigian.TotalMinutes} phút trước";
        if (khoangthoigian.TotalHours < 24) return $"{(int)khoangthoigian.TotalHours} giờ trước";
        if (khoangthoigian.TotalDays < 7) return $"{(int)khoangthoigian.TotalDays} ngày trước";
        return ngaydang.ToString("dd/MM/yyyy");
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #1E2A78;">
            <i class="fa-regular fa-newspaper me-2"></i>Bảng tin
        </h2>
        <span class="badge bg-primary rounded-pill px-3 py-2" id="total-posts">@Model.Count bài viết</span>
    </div>

    <div class="card mb-4 shadow-sm border-0" style="border-radius: 16px;">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <img src="/images/default.png" class="rounded-circle me-2" style="width:45px; height:45px; object-fit:cover; border: 1px solid #ddd;">
                
                <button type="button" class="btn btn-light rounded-pill flex-grow-1 text-start ps-3 text-muted border-0 me-2" 
                        data-bs-toggle="modal" data-bs-target="#modalDangBai" style="background-color: #f0f2f5; height: 45px;">
                    bạn đang nghĩ gì thế?
                </button>

                <button type="button" class="btn btn-light rounded-circle d-flex align-items-center justify-content-center border-0" 
                        id="btnQuickUpload" style="width: 45px; height: 45px; background-color: #f0f2f5;">
                    <i class="fa-solid fa-image text-success fs-5"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="loading-spinner" class="text-center py-4" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-2 text-secondary">Đang tải thêm bài viết...</p>
    </div>

    <div id="posts-container">
        @foreach (var bv in Model)
        {
            @await Html.PartialAsync("Baidang", bv)
        }
    </div>

    <div class="text-center my-4" id="load-more-container">
        <button class="btn btn-outline-primary rounded-pill px-5 py-2" onclick="loadMorePosts()" id="load-more-btn">
            <i class="fa-regular fa-circle-down"></i> Tải thêm bài viết
        </button>
    </div>

    <div class="text-center my-4 text-secondary" id="end-message" style="display: none;">
        <i class="fa-regular fa-circle-check me-2"></i>Đã hiển thị tất cả bài viết
    </div>
</div>

<div class="modal fade" id="modalDangBai" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="Taobaiviet" asp-controller="Baiviet" method="post" enctype="multipart/form-data">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title w-100 text-center fw-bold" style="color: #1E2A78;">Tạo bài viết</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body pt-0">
                    <textarea name="Noidung" class="form-control border-0 fs-5 mb-2" rows="4" 
                              placeholder="bạn đang nghĩ gì thế?" style="resize: none; box-shadow: none;" required></textarea>

                    <div id="containerPreview" class="position-relative d-none border rounded-3 overflow-hidden mb-3" style="background: #f8f9fa;">
                        <img id="imgPreview" src="#" class="w-100" style="max-height: 300px; object-fit: contain; display: block; margin: 0 auto;">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2 bg-white shadow-sm p-1" id="btnRemoveImg" style="z-index: 1055;"></button>
                    </div>

                    <div class="d-flex align-items-center justify-content-between border rounded-3 p-3 shadow-sm bg-light">
                        <span class="fw-bold text-secondary small">Thêm vào bài viết</span>
                        <div class="d-flex align-items-center">
                            <button type="button" id="btnTriggerUpload" class="btn btn-white rounded-circle text-success shadow-sm d-flex align-items-center justify-content-center" 
                                   style="background: white; width: 40px; height: 40px; border: 1px solid #eee;">
                                <i class="fa-solid fa-images fs-5"></i>
                            </button>
                            <input type="file" name="AnhFile" id="inputAnh" class="d-none" accept="image/*">
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top-0 p-3">
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow" style="border-radius: 12px; background: #1E2A78;">Đăng bài</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="deleteModal" class="custom-modal" onclick="closeDeleteModal()">
    <div class="custom-modal-content" onclick="event.stopPropagation()">
        <h5>Bạn có muốn xoá bài viết này không?</h5>
        <div class="text-end mt-3">
            <button class="btn btn-secondary me-2" onclick="closeDeleteModal()">Huỷ</button>
            <button class="btn btn-danger" onclick="confirmDelete()">Xoá</button>
        </div>
    </div>
</div>

<style>
    .post-item { animation: fadeInUp 0.5s ease-out; }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .post-card { transition: transform 0.2s, box-shadow 0.2s; cursor: pointer; }
    .post-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px -5px rgba(30, 42, 120, 0.1) !important; }
    .post-image-container { overflow: hidden; border-radius: 16px; }
    .post-image-container img { transition: transform 0.3s; }
    .post-image-container:hover img { transform: scale(1.02); }
    .like-btn.liked i { animation: likePop 0.3s ease-out; }
    @@keyframes likePop { 0% { transform: scale(1); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }
    
    .custom-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); justify-content: center; align-items: center; z-index: 9999; }
    .custom-modal-content { background: white; padding: 20px; border-radius: 10px; width: 350px; }
    .pointer-events-none { pointer-events: none; }

    @@media (max-width: 768px) {
        .post-actions .btn span { display: none; }
        .post-actions .btn i { margin-right: 0 !important; font-size: 1.2rem; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputAnh = document.getElementById('inputAnh');
        const btnTrigger = document.getElementById('btnTriggerUpload');
        const btnQuick = document.getElementById('btnQuickUpload');
        const imgPreview = document.getElementById('imgPreview');
        const containerPreview = document.getElementById('containerPreview');
        const modalElement = document.getElementById('modalDangBai');
        const bootstrapModal = new bootstrap.Modal(modalElement);

        // Click icon ở ngoài Bảng tin
        if (btnQuick) {
            btnQuick.addEventListener('click', function() {
                inputAnh.click();
            });
        }

        // Click icon bên trong Modal
        if (btnTrigger) {
            btnTrigger.addEventListener('click', function() {
                inputAnh.click();
            });
        }

        // Xử lý khi chọn file (Dùng chung cho cả 2 nút)
        if (inputAnh) {
            inputAnh.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                        containerPreview.classList.remove('d-none');
                        // Nếu đang ở ngoài thì bật Modal lên để người dùng gõ text
                        if (!modalElement.classList.contains('show')) {
                            bootstrapModal.show();
                        }
                    }
                    reader.readAsDataURL(this.files[0]);
                }
            });
        }

        document.getElementById('btnRemoveImg').onclick = function() {
            inputAnh.value = "";
            containerPreview.classList.add('d-none');
        };
    });

    // --- CÁC HÀM LOGIC CÒN LẠI GIỮ NGUYÊN ---
    let currentPage = 1;
    let loading = false;
    let hasMore = true;
    const postsPerPage = 5;

    function loadMorePosts() {
        if (loading || !hasMore) return;
        loading = true;
        document.getElementById('loading-spinner').style.display = 'block';
        document.getElementById('load-more-btn').disabled = true;
        currentPage++;

        fetch(`/Baiviet/TaiThemBaiViet?page=${currentPage}&pageSize=${postsPerPage}`)
            .then(response => response.json())
            .then(data => {
                if (data.html && data.html.trim() !== '') {
                    document.getElementById('posts-container').insertAdjacentHTML('beforeend', data.html);
                    if (!data.hasMore) {
                        hasMore = false;
                        document.getElementById('load-more-container').style.display = 'none';
                        document.getElementById('end-message').style.display = 'block';
                    }
                    document.getElementById('total-posts').innerText = data.totalPosts + ' bài viết';
                } else {
                    hasMore = false;
                    document.getElementById('load-more-container').style.display = 'none';
                    document.getElementById('end-message').style.display = 'block';
                }
                loading = false;
                document.getElementById('loading-spinner').style.display = 'none';
                document.getElementById('load-more-btn').disabled = false;
            })
            .catch(error => {
                loading = false;
                document.getElementById('loading-spinner').style.display = 'none';
                document.getElementById('load-more-btn').disabled = false;
            });
    }

    window.addEventListener('scroll', () => {
        if (!hasMore || loading) return;
        if (window.scrollY + window.innerHeight > document.documentElement.scrollHeight * 0.8) {
            loadMorePosts();
        }
    });

    function thichBaiViet(id, btn) {
        fetch("/Baiviet/ThichBaiViet?baiVietId=" + id, { method: "POST" })
        .then(response => response.json())
        .then(data => {
            const likeSpan = btn.querySelector('.like-count');
            if (likeSpan) likeSpan.innerText = data.soLuong;
            const totalLikeSpan = document.getElementById('total-like-' + id);
            if (totalLikeSpan) totalLikeSpan.innerText = data.soLuong;
            if (data.daThich) {
                btn.classList.remove('btn-light');
                btn.classList.add('btn-primary', 'liked');
            } else {
                btn.classList.remove('btn-primary', 'liked');
                btn.classList.add('btn-light');
            }
        });
    }

    function moBinhLuan(baivietId, btn) {
        const commentSection = document.getElementById('comment-section-' + baivietId);
        if (commentSection.style.display === 'none') {
            commentSection.style.display = 'block';
            btn.innerHTML = '<i class="fa-regular fa-comment-dots me-2"></i><span>Ẩn</span>';
        } else {
            commentSection.style.display = 'none';
            btn.innerHTML = '<i class="fa-regular fa-comment me-2"></i><span>Bình luận</span>';
        }
    }

    function guiBinhLuan(baivietId, inputId) {
        const input = document.getElementById(inputId);
        const noidung = input.value.trim();
        if (noidung === '') return;

        fetch('/Baiviet/ThemBinhLuan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `baivietId=${baivietId}&noidung=${encodeURIComponent(noidung)}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('comment-list-' + baivietId).insertAdjacentHTML('afterbegin', data.html);
                input.value = '';
                document.getElementById('comment-count-' + baivietId).innerText = data.soLuong;
            }
        });
    }

    let deletePostId = 0;
    function openDeleteModal(id) { deletePostId = id; document.getElementById("deleteModal").style.display = "flex"; }
    function closeDeleteModal() { document.getElementById("deleteModal").style.display = "none"; }
    function confirmDelete() {
        fetch('/Baiviet/XoaBaiViet', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + deletePostId })
        .then(res => res.json())
        .then(data => {
            if (data.success) { document.getElementById('post-' + deletePostId)?.remove(); closeDeleteModal(); }
        });
    }
</script>