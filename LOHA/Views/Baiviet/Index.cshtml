@model List<LOHA.Models.Baiviet>

@functions {
    public string Tinhthoigian(DateTime ngaydang)
    {
        var khoangthoigian = DateTime.Now - ngaydang;
        if (khoangthoigian.TotalMinutes < 1) return "Vừa xong";
        if (khoangthoigian.TotalMinutes < 60) return $"{(int)khoangthoigian.TotalMinutes} phút trước";
        if (khoangthoigian.TotalHours < 24) return $"{(int)khoangthoigian.TotalHours} giờ trước";
        if (khoangthoigian.TotalDays < 7) return $"{(int)khoangthoigian.TotalDays} ngày trước";
        return ngaydang.ToString("dd/MM/yyyy");
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container" style="max-width: 650px;">
    <!-- ===== TIÊU ĐỀ BẢNG TIN NÂNG CẤP ===== -->
    <div class="loha-feed-header">
        <div class="loha-feed-title">
            <div class="loha-feed-icon">
                <i class="fa-regular fa-newspaper"></i>
            </div>
            <h2>Bảng tin</h2>
            <span class="loha-feed-badge" id="total-posts">
                <span class="badge-number">@Model.Count</span>
                <span class="badge-text">bài mới</span>
            </span>
        </div>
    
        <div class="loha-feed-actions">
            <!-- Dành cho nút lọc, sắp xếp (tương lai) -->
        </div>
    </div>

    <div class="create-post-card">
        <div class="create-post-body">
            <img src="@(ViewBag.CurrentUserAvatar ?? "/images/default.png")" class="create-post-avatar" />
        
            <button type="button" class="create-post-button flex-grow-1" data-bs-toggle="modal" data-bs-target="#modalDangBai">
                <span class="material-icons-outlined">edit_note</span>
                <span>Bạn đang nghĩ gì thế?</span>
            </button>

            <button type="button" class="create-post-image-btn" id="btnQuickUpload">
                <span class="material-icons-outlined">image</span>
            </button>
        </div>
    </div>

    <div id="loading-spinner" class="text-center py-4" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-2 text-secondary">Đang tải thêm bài viết...</p>
    </div>

    <div id="posts-container">
        @foreach (var bv in Model)
        {
            @await Html.PartialAsync("Baidang", bv)
        }
    </div>

    <div class="text-center my-4" id="load-more-container">
        <button class="btn btn-outline-primary rounded-pill px-5 py-2" onclick="loadMorePosts()" id="load-more-btn">
            <i class="fa-regular fa-circle-down"></i> Tải thêm bài viết
        </button>
    </div>

    <div class="text-center my-4 text-secondary" id="end-message" style="display: none;">
        <i class="fa-regular fa-circle-check me-2"></i>Đã hiển thị tất cả bài viết
    </div>
</div>

<!-- ===== MODAL TẠO BÀI VIẾT - LOHA STYLE ===== -->
<div class="modal fade" id="modalDangBai" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px; background: #FFFFFF;">
            <form asp-action="Taobaiviet" asp-controller="Baiviet" method="post" enctype="multipart/form-data" id="formDangBai">
                
                <!-- Header -->
                <div class="modal-header border-0 px-4 pt-4 pb-2">
                    <h5 class="modal-title fw-bold" style="color: #2D1B69; font-size: 20px; letter-spacing: -0.3px;">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6D5DFC;">edit_note</span>
                        Tạo bài viết
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <!-- Body -->
                <div class="modal-body px-4 pt-2 pb-3">
                    <!-- Avatar + Textarea -->
                    <div class="d-flex gap-3">
                        <div class="post-avatar-wrapper flex-shrink-0" style="width: 48px; height: 48px;">
                            <img src="@(ViewBag.CurrentUserAvatar ?? "/images/default.png")" 
                                    class="post-avatar-img" 
                                    style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid white;" />
                        </div>
                        <textarea name="Noidung" 
                                    id="postContent" 
                                    class="form-control border-0 p-0" 
                                    rows="3" 
                                    placeholder="Bạn đang nghĩ gì thế?" 
                                    style="resize: none; box-shadow: none; font-size: 16px; color: #2D1B69; background: transparent;"></textarea>
                    </div>

                    <!-- Preview ảnh -->
                    <div id="containerPreview" class="position-relative d-none mt-3" style="border-radius: 20px; overflow: hidden; background: #F8F9FE;">
                        <img id="imgPreview" src="#" style="width: 100%; max-height: 350px; object-fit: cover; display: block;" />
                        <button type="button" class="btn position-absolute top-0 end-0 m-2" id="btnRemoveImg" 
                                style="background: rgba(0,0,0,0.5); color: white; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: none; backdrop-filter: blur(4px);">
                            <span class="material-icons-outlined" style="font-size: 18px;">close</span>
                        </button>
                    </div>

                    <!-- Toolbar đính kèm -->
                    <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top" style="border-color: #E9E7F5 !important;">
                        <span class="fw-medium" style="color: #5E5A6E; font-size: 14px;">Thêm vào bài viết</span>
                        <div class="d-flex gap-2">
                            <!-- Nút chọn ảnh -->
                            <button type="button" id="btnTriggerUpload" 
                                    class="btn rounded-circle d-flex align-items-center justify-content-center" 
                                    style="background: #F3F0FF; color: #6D5DFC; width: 44px; height: 44px; border: none; transition: all 0.2s;"
                                    onmouseover="this.style.background='#6D5DFC'; this.style.color='white';"
                                    onmouseout="this.style.background='#F3F0FF'; this.style.color='#6D5DFC';">
                                <span class="material-icons-outlined">image</span>
                            </button>
                            <input type="file" name="AnhFile" id="inputAnh" class="d-none" accept="image/*">
                        </div>
                    </div>
                </div>
                
                <!-- Footer -->
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="submit" class="btn w-100 py-3 fw-semibold text-white" 
                            id="submitPostBtn"
                            style="background: #E9E7F5; border-radius: 60px; font-size: 16px; border: none; transition: all 0.2s; color: #9CA3AF;"
                            disabled>
                        <span class="material-icons-outlined me-2" style="vertical-align: middle;">send</span>
                        Đăng bài
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== POPUP XÁC NHẬN XÓA BÀI VIẾT ===== -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4" style="background: #1E293B; color: white;">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3" style="background: rgba(239, 68, 68, 0.1) !important;">
                        <span class="material-icons-outlined" style="font-size: 48px; color: #EF4444;">delete_forever</span>
                    </div>
                </div>
                <h5 class="fw-bold mb-2" style="color: white;">Xóa bài viết?</h5>
                <p class="mb-4" style="color: rgba(255,255,255,0.7);">Bài viết sẽ bị xóa vĩnh viễn và không thể khôi phục.</p>
                <div class="d-flex gap-3 justify-content-center">
                    <button type="button" class="btn px-4 py-2 rounded-3" data-bs-dismiss="modal" 
                            style="background: rgba(255,255,255,0.1); color: white; border: none;">
                        <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">close</span>
                        Hủy
                    </button>
                    <button type="button" class="btn px-4 py-2 rounded-3" onclick="confirmDelete()"
                            style="background: #EF4444; color: white; border: none;">
                        <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">delete</span>
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ===== POPUP BÁO CÁO BÀI VIẾT (CHỈ 1 MODAL CHO TOÀN TRANG) ===== -->
<div class="modal fade" id="baoCaoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #1E2A78;">
                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">flag</span>
                    Báo cáo bài viết
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-secondary mb-3">Vui lòng chọn lý do báo cáo:</p>
                <div class="d-flex flex-column gap-2">
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDo" value="Spam" class="form-check-input me-2" checked>
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6C63FF;">mail</span>
                        <strong>Spam</strong>
                        <small class="d-block text-secondary ms-4">Bài viết quảng cáo, lặp lại nhiều lần</small>
                    </label>
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDo" value="Nội dung nhạy cảm" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #EF4444;">visibility_off</span>
                        <strong>Nội dung nhạy cảm</strong>
                        <small class="d-block text-secondary ms-4">Ảnh hoặc nội dung không phù hợp</small>
                    </label>
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDo" value="Quấy rối" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">warning</span>
                        <strong>Quấy rối</strong>
                        <small class="d-block text-secondary ms-4">Nội dung gây khó chịu, xúc phạm</small>
                    </label>
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDo" value="Lừa đảo" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #DC2626;">report</span>
                        <strong>Lừa đảo</strong>
                        <small class="d-block text-secondary ms-4">Thông tin sai sự thật, lừa đảo</small>
                    </label>
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDo" value="Khác" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #9CA3AF;">more_horiz</span>
                        <strong>Khác</strong>
                        <small class="d-block text-secondary ms-4">Lý do khác</small>
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning rounded-pill px-4" id="xacNhanBaoCao"
                        style="background: #F59E0B; border: none; color: white;">
                    <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">send</span>
                    Gửi báo cáo
                </button>
            </div>
        </div>
    </div>
</div>
<style>
    .post-item { animation: fadeInUp 0.5s ease-out; }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .post-card { transition: transform 0.2s, box-shadow 0.2s; cursor: pointer; }
    .post-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px -5px rgba(30, 42, 120, 0.1) !important; }
    .post-image-container { overflow: hidden; border-radius: 16px; }
    .post-image-container img { transition: transform 0.3s; }
    .post-image-container:hover img { transform: scale(1.02); }
    .like-btn.liked i { animation: likePop 0.3s ease-out; }
    @@keyframes likePop { 0% { transform: scale(1); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }
    
    .custom-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); justify-content: center; align-items: center; z-index: 9999; }
    .custom-modal-content { background: white; padding: 20px; border-radius: 10px; width: 350px; }
    .pointer-events-none { pointer-events: none; }

    @@media (max-width: 768px) {
        .post-actions .btn span { display: none; }
        .post-actions .btn i { margin-right: 0 !important; font-size: 1.2rem; }
    }
</style>

<script>
    
     document.addEventListener('DOMContentLoaded', function() {
        const inputAnh = document.getElementById('inputAnh');
        const btnTrigger = document.getElementById('btnTriggerUpload');
        const btnQuick = document.getElementById('btnQuickUpload');
        const imgPreview = document.getElementById('imgPreview');
        const containerPreview = document.getElementById('containerPreview');
        const postContent = document.getElementById('postContent');
        const submitBtn = document.getElementById('submitPostBtn');
        const modalElement = document.getElementById('modalDangBai');
        
        // Bootstrap modal
        let bootstrapModal = null;
        if (modalElement) {
            bootstrapModal = new bootstrap.Modal(modalElement);
        }

        // ===== LOGIC: CHỈ CẦN 1 TRONG 2 (NỘI DUNG HOẶC ẢNH) =====
        function checkPostContent() {
            const hasText = postContent && postContent.value.trim() !== '';
            const hasImage = inputAnh && inputAnh.files.length > 0;
            const isValid = hasText || hasImage;
            
            if (isValid) {
                submitBtn.disabled = false;
                submitBtn.classList.add('active');
            } else {
                submitBtn.disabled = true;
                submitBtn.classList.remove('active');
            }
        }
        
        // Lắng nghe sự kiện nhập text
        if (postContent) {
            postContent.addEventListener('input', checkPostContent);
        }

        // Click nút chọn ảnh (trong modal)
        if (btnTrigger) {
            btnTrigger.addEventListener('click', function() {
                inputAnh.click();
            });
        }
        
        // Click nút Quick Upload (ngoài modal - nếu có)
        if (btnQuick) {
            btnQuick.addEventListener('click', function() {
                inputAnh.click();
            });
        }

        // Xử lý khi chọn file
        if (inputAnh) {
            inputAnh.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                        containerPreview.classList.remove('d-none');
                    }
                    reader.readAsDataURL(this.files[0]);
                    
                    // Nếu modal chưa mở thì mở modal
                    if (modalElement && !modalElement.classList.contains('show')) {
                        if (bootstrapModal) bootstrapModal.show();
                    }
                } else {
                    containerPreview.classList.add('d-none');
                }
                checkPostContent();
            });
        }
        
        // Nút xóa ảnh preview
        const btnRemoveImg = document.getElementById('btnRemoveImg');
        if (btnRemoveImg) {
            btnRemoveImg.addEventListener('click', function() {
                inputAnh.value = '';
                containerPreview.classList.add('d-none');
                checkPostContent();
            });
        }
        
        // Reset form khi modal đóng
        if (modalElement) {
            modalElement.addEventListener('hidden.bs.modal', function() {
                postContent.value = '';
                inputAnh.value = '';
                containerPreview.classList.add('d-none');
                submitBtn.disabled = true;
                submitBtn.classList.remove('active');
            });
        }
    });
    let currentPage = 1;
    let loading = false;
    let hasMore = true;
    const postsPerPage = 5;

    function loadMorePosts() {
    if (loading || !hasMore) return;
    loading = true;
    document.getElementById('loading-spinner').style.display = 'block';
    document.getElementById('load-more-btn').disabled = true;
    currentPage++;

    fetch(`/Baiviet/TaiThemBaiViet?page=${currentPage}&pageSize=${postsPerPage}`)
        .then(response => response.json())
        .then(data => {
            if (data.html && data.html.trim() !== '') {
                const container = document.getElementById('posts-container');
                
                //  KIỂM TRA TRÙNG TRƯỚC KHI APPEND
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = data.html;
                
                // Lấy danh sách ID bài viết hiện có trong container
                const existingIds = new Set();
                container.querySelectorAll('[id^="post-"]').forEach(el => {
                    const id = el.id.replace('post-', '');
                    existingIds.add(id);
                });
                
                // Lọc và chỉ append bài viết CHƯA tồn tại
                const newPosts = tempDiv.children;
                let addedCount = 0;
                
                for (let post of newPosts) {
                    if (post.id && post.id.startsWith('post-')) {
                        const postId = post.id.replace('post-', '');
                        if (!existingIds.has(postId)) {
                            container.appendChild(post.cloneNode(true));
                            existingIds.add(postId);
                            addedCount++;
                        } else {
                            console.warn('🔄 Bài viết trùng lặp, bỏ qua: post-' + postId);
                        }
                    }
                }
                
                console.log(`✅ Đã thêm ${addedCount} bài viết mới`);
                
                // Cập nhật trạng thái hasMore dựa vào server
                if (!data.hasMore) {
                    hasMore = false;
                    document.getElementById('load-more-container').style.display = 'none';
                    document.getElementById('end-message').style.display = 'block';
                }
                
                // Cập nhật badge tổng số bài viết (từ server)
                const badgeNumber = document.querySelector('#total-posts .badge-number');
                if (badgeNumber) {
                    badgeNumber.innerText = data.totalPosts;
                }
            } else {
                hasMore = false;
                document.getElementById('load-more-container').style.display = 'none';
                document.getElementById('end-message').style.display = 'block';
            }
            
            loading = false;
            document.getElementById('loading-spinner').style.display = 'none';
            document.getElementById('load-more-btn').disabled = false;
        })
        .catch(error => {
            console.error('❌ Lỗi tải thêm bài viết:', error);
            loading = false;
            document.getElementById('loading-spinner').style.display = 'none';
            document.getElementById('load-more-btn').disabled = false;
        });
}

    window.addEventListener('scroll', () => {
        if (!hasMore || loading) return;
        if (window.scrollY + window.innerHeight > document.documentElement.scrollHeight * 0.8) {
            loadMorePosts();
        }
    });

    function thichBaiViet(id, btn) {
        fetch("/Baiviet/ThichBaiViet?baiVietId=" + id, { method: "POST" })
        .then(response => response.json())
        .then(data => {
            const likeSpan = btn.querySelector('.like-count');
            if (likeSpan) likeSpan.innerText = data.soLuong;
            const totalLikeSpan = document.getElementById('total-like-' + id);
            if (totalLikeSpan) totalLikeSpan.innerText = data.soLuong;
            if (data.daThich) {
                btn.classList.remove('btn-light');
                btn.classList.add('btn-primary', 'liked');
            } else {
                btn.classList.remove('btn-primary', 'liked');
                btn.classList.add('btn-light');
            }
        });
    }

    function moBinhLuan(baivietId, btn) {
        const commentSection = document.getElementById('comment-section-' + baivietId);
        const icon = btn.querySelector('i');
    
        if (commentSection.style.display === 'none' || commentSection.style.display === '') {
            commentSection.style.display = 'block';
            icon.className = 'fa-regular fa-comment-dots';  // Chỉ đổi icon
        } else {
            commentSection.style.display = 'none';
            icon.className = 'fa-regular fa-comment';       // Chỉ đổi icon
        }
    }

    function guiBinhLuan(baivietId, inputId) {
        const input = document.getElementById(inputId);
        const noidung = input.value.trim();
        if (noidung === '') return;

        fetch('/Baiviet/ThemBinhLuan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `baivietId=${baivietId}&noidung=${encodeURIComponent(noidung)}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('comment-list-' + baivietId).insertAdjacentHTML('afterbegin', data.html);
                input.value = '';
                document.getElementById('comment-count-' + baivietId).innerText = data.soLuong;
            }
        });
    }

    let deletePostId = 0;
        function openDeleteModal(id) {
        deletePostId = id;
        var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }
    function confirmDelete() {
        fetch('/Baiviet/XoaBaiViet', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + deletePostId
        })
        .then(res => res.json())
        .then(data => {
            // Đóng popup
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            modal.hide();
        
            if (data.success) {
                document.getElementById('post-' + deletePostId)?.remove();
                showToast('Đã xóa bài viết thành công', 'success');
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
            modal.hide();
            showToast('Có lỗi xảy ra', 'error');
        });
    }
    // Biến lưu ID bài viết đang báo cáo
var baiVietDangBaoCao = 0;

// Hàm mở popup báo cáo
function moPopupBaoCaoBaiViet(baiVietId) {
    baiVietDangBaoCao = baiVietId;
    document.querySelector('input[name="lyDo"][value="Spam"]').checked = true;
    var modal = new bootstrap.Modal(document.getElementById('baoCaoModal'));
    modal.show();
}

// Xử lý gửi báo cáo (gắn 1 lần duy nhất)
document.addEventListener('DOMContentLoaded', function() {
    const xacNhanBtn = document.getElementById('xacNhanBaoCao');
    if (xacNhanBtn) {
        // Xóa listener cũ (nếu có)
        xacNhanBtn.replaceWith(xacNhanBtn.cloneNode(true));
        const newBtn = document.getElementById('xacNhanBaoCao');
        newBtn.addEventListener('click', function() {
            var lyDo = document.querySelector('input[name="lyDo"]:checked').value;
            
            fetch('/User/BaoCaoBaiViet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'baiVietId=' + baiVietDangBaoCao + '&lyDo=' + encodeURIComponent(lyDo)
            })
            .then(response => response.json())
            .then(data => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('baoCaoModal'));
                modal.hide();
                
                if (data.success) {
                    showToast('Đã gửi báo cáo. Cảm ơn bạn!', 'success');
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(error => {
                showToast('Có lỗi xảy ra', 'error');
            });
        });
    }
});
    // Hàm hiển thị Toast
    function showToast(message, type = 'success') {
        let toastContainer = document.getElementById('toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'toast-container';
            toastContainer.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            document.body.appendChild(toastContainer);
        }
    
        const toast = document.createElement('div');
        toast.style.cssText = `
            background: ${type === 'success' ? '#10B981' : '#EF4444'};
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
            min-width: 250px;
        `;
    
        const icon = type === 'success' ? 'check_circle' : 'error_outline';
        toast.innerHTML = `
            <span class="material-icons-outlined">${icon}</span>
            <span style="flex: 1;">${message}</span>
            <button onclick="this.parentElement.remove()" style="background: none; border: none; color: white; cursor: pointer; opacity: 0.7; font-size: 18px;">×</button>
        `;
    
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    // Thêm animation CSS
    if (!document.getElementById('toast-animation-style')) {
        const style = document.createElement('style');
        style.id = 'toast-animation-style';
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        `;
        document.head.appendChild(style);
    }
</script>
