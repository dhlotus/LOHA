@model LOHA.Models.Baiviet

@{
    string avatarDefault = "/images/default.png";
}

<div class="post-item mb-4" id="post-@Model.Id">
    <div class="card border-0 shadow-sm post-card">
        <div class="card-body">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3 position-relative">
    
                <div class="d-flex align-items-center">

                    <a asp-controller="User"
                           asp-action="TrangCaNhan"
                           asp-route-id="@Model.UserId">
                        <img src="@avatarDefault"
                             class="rounded-circle me-2"
                             style="width: 48px; height: 48px; object-fit: cover; cursor:pointer;" />
                    </a>

                    <div>
                        <a asp-controller="User"
                               asp-action="TrangCaNhan"
                               asp-route-id="@Model.UserId"
                               class="text-decoration-none fw-bold"
                               style="color: #1E2A78;">
                            @Model.User?.Ten
                        </a>

                        <small class="text-secondary d-block">
                            <i class="fa-regular fa-clock me-1"></i>@Tinhthoigian(Model.Ngaydang)
                        </small>
                    </div>

                </div>

                @{
                    int? currentUserId = ViewBag.CurrentUserId as int?;
                }

                @* Nút 3 chấm - Dropdown menu *@
                <div class="dropdown">
                    <button class="btn btn-light btn-sm rounded-circle"
                            type="button"
                            id="dropdownMenu-@Model.Id"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenu-@Model.Id">
                        @if (currentUserId != null && currentUserId == Model.UserId)
                        {
                            @* Chủ bài viết: Hiện nút Xóa *@
                            <li>
                                <a class="dropdown-item text-danger" href="#" onclick="openDeleteModal(@Model.Id); return false;">
                                    <i class="fa-regular fa-trash-can me-2"></i>
                                    Xóa bài viết
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Không phải chủ bài viết: Hiện nút Báo cáo *@
                            <li>
                                <a class="dropdown-item text-warning" href="#" onclick="moPopupBaoCaoBaiViet(@Model.Id); return false;">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; font-size: 16px;">flag</span>
                                    Báo cáo bài viết
                                </a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
            
           
            <!-- Nội dung -->
            <p class="mb-3" style="line-height: 1.6;">@Model.Noidung</p>

            <!-- Ảnh -->
            @if (!string.IsNullOrEmpty(Model.Anh))
            {
                <div class="post-image-container mb-3">
                    <img src="/baiviet/@Model.Anh"
                         class="img-fluid w-100"
                         style="max-height: 400px; object-fit: contain; background: #f8f9fa;" />
                </div>
            }

            <!-- Stats -->
            <div class="d-flex justify-content-between text-secondary small py-2 border-top border-bottom">
                <div>
                    <i class="fa-regular fa-heart me-1" style="color: #FF4D6D;"></i>
                    <span id="total-like-@Model.Id">@Model.Thichs.Count</span> lượt thích
                </div>
                <div>
                    <i class="fa-regular fa-comment me-1" style="color: #6C63FF;"></i>
                    <span id="comment-count-@Model.Id">@(Model.Binhluans?.Count ?? 0)</span> bình luận
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 mt-3 post-actions">
                <button onclick="thichBaiViet(@Model.Id, this)"
                        class="btn flex-fill @(ViewBag.Thichs?.Contains(Model.Id) == true ? "btn-primary liked" : "btn-light") rounded-pill like-btn">
                    <i class="fa-solid fa-heart"></i>
                    <span>Thích</span>
                    <span class="like-count ms-1" id="like-count-@Model.Id">@Model.Thichs.Count</span>
                </button>

                <button onclick="moBinhLuan(@Model.Id, this)"
                        class="btn btn-light flex-fill rounded-pill">
                    <i class="fa-regular fa-comment me-2"></i>
                    <span>Bình luận</span>
                </button>

            </div>

            <!-- Khu vực bình luận (ẩn mặc định) -->
            <div id="comment-section-@Model.Id" style="display: none;" class="mt-3">
                <!-- Danh sách bình luận -->
                <div id="comment-list-@Model.Id" class="mb-3">
                    @if (Model.Binhluans != null && Model.Binhluans.Any())
                    {
                        foreach (var bl in Model.Binhluans.OrderByDescending(b => b.Ngaydang))
                        {
                            <div class="d-flex mb-2">
                                <img src="@avatarDefault"
                                     class="rounded-circle me-2"
                                     style="width: 32px; height: 32px; object-fit: cover;" />
                                <div class="bg-light p-2 rounded-3 flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold small">@bl.User?.Ten</span>
                                        <small class="text-secondary">@bl.Ngaydang.ToString("HH:mm")</small>
                                    </div>
                                    <p class="mb-0 small">@bl.Noidung</p>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Form bình luận -->
                <div class="d-flex gap-2">
                    <img src="@avatarDefault"
                         class="rounded-circle"
                         style="width: 32px; height: 32px; object-fit: cover;" />
                    <div class="input-group">
                        <input type="text"
                               class="form-control form-control-sm rounded-pill"
                               id="comment-input-@Model.Id"
                               placeholder="Viết bình luận..."
                               onkeydown="handleEnter(event, @Model.Id, 'comment-input-@Model.Id')" />
                              
                        <button class="btn btn-primary btn-sm rounded-pill ms-2 px-3"
                                onclick="guiBinhLuan(@Model.Id, 'comment-input-@Model.Id')">
                            <i class="fa-regular fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ===== POPUP BÁO CÁO BÀI VIẾT ===== -->
    <div class="modal fade" id="baoCaoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: #1E2A78;">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">flag</span>
                        Báo cáo bài viết
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="text-secondary mb-3">Vui lòng chọn lý do báo cáo:</p>
                
                    <div class="d-flex flex-column gap-2">
                        <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                            <input type="radio" name="lyDo" value="Spam" class="form-check-input me-2" checked>
                            <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6C63FF;">mail</span>
                            <strong>Spam</strong>
                            <small class="d-block text-secondary ms-4">Bài viết quảng cáo, lặp lại nhiều lần</small>
                        </label>
                    
                        <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                            <input type="radio" name="lyDo" value="Nội dung nhạy cảm" class="form-check-input me-2">
                            <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #EF4444;">visibility_off</span>
                            <strong>Nội dung nhạy cảm</strong>
                            <small class="d-block text-secondary ms-4">Ảnh hoặc nội dung không phù hợp</small>
                        </label>
                    
                        <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                            <input type="radio" name="lyDo" value="Quấy rối" class="form-check-input me-2">
                            <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">warning</span>
                            <strong>Quấy rối</strong>
                            <small class="d-block text-secondary ms-4">Nội dung gây khó chịu, xúc phạm</small>
                        </label>
                    
                        <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                            <input type="radio" name="lyDo" value="Lừa đảo" class="form-check-input me-2">
                            <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #DC2626;">report</span>
                            <strong>Lừa đảo</strong>
                            <small class="d-block text-secondary ms-4">Thông tin sai sự thật, lừa đảo</small>
                        </label>
                    
                        <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                            <input type="radio" name="lyDo" value="Khác" class="form-check-input me-2">
                            <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #9CA3AF;">more_horiz</span>
                            <strong>Khác</strong>
                            <small class="d-block text-secondary ms-4">Lý do khác</small>
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-warning rounded-pill px-4" id="xacNhanBaoCao"
                            style="background: #F59E0B; border: none; color: white;">
                        <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">send</span>
                        Gửi báo cáo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string Tinhthoigian(DateTime ngaydang)
    {
        var khoangthoigian = DateTime.Now - ngaydang;
        if (khoangthoigian.TotalMinutes < 1) return "Vừa xong";
        if (khoangthoigian.TotalMinutes < 60) return $"{(int)khoangthoigian.TotalMinutes} phút trước";
        if (khoangthoigian.TotalHours < 24) return $"{(int)khoangthoigian.TotalHours} giờ trước";
        if (khoangthoigian.TotalDays < 7) return $"{(int)khoangthoigian.TotalDays} ngày trước";
        return ngaydang.ToString("dd/MM/yyyy");
    }

}
<script>
    function handleEnter(event, postId, inputId) {
        if (event.key === "Enter") {
            event.preventDefault(); // tránh reload nếu có
            guiBinhLuan(postId, inputId);
        }
    }
        // Biến lưu ID bài viết đang báo cáo
    var baiVietDangBaoCao = 0;

    // Hàm mở popup báo cáo
    function moPopupBaoCaoBaiViet(baiVietId) {
        baiVietDangBaoCao = baiVietId;
    
        // Reset radio về Spam
        document.querySelector('input[name="lyDo"][value="Spam"]').checked = true;
    
        var modal = new bootstrap.Modal(document.getElementById('baoCaoModal'));
        modal.show();
    }

    // Xử lý gửi báo cáo
    document.getElementById('xacNhanBaoCao').addEventListener('click', function() {
        var lyDo = document.querySelector('input[name="lyDo"]:checked').value;
    
        fetch('/User/BaoCaoBaiViet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'baiVietId=' + baiVietDangBaoCao + '&lyDo=' + encodeURIComponent(lyDo)
        })
        .then(response => response.json())
        .then(data => {
            var modal = bootstrap.Modal.getInstance(document.getElementById('baoCaoModal'));
            modal.hide();
        
            if (data.success) {
                alert('Đã gửi báo cáo. Cảm ơn bạn!');
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra');
        });
    });
</script>