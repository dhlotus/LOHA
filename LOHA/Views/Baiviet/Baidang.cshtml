@model LOHA.Models.Baiviet

@{
    string avatarDefault = "/images/default.png";
    int? currentUserId = ViewBag.CurrentUserId as int?;
    string avatar = string.IsNullOrEmpty(Model.User?.Avatar) ? "/images/default.png" : Model.User.Avatar;
}

<div class="post-item mb-4" id="post-@Model.Id" style="position: relative;">
    <div class="post-card">
        <div class="card-body">
            
            <!-- ===== HEADER ===== -->
            <div class="post-header">
                <a asp-controller="User" asp-action="TrangCaNhan" asp-route-id="@Model.UserId" class="post-avatar-wrapper">
                    <img src="@avatar" class="post-avatar-img" />
                </a>
                <div class="post-user-info">
                    <a asp-controller="User" asp-action="TrangCaNhan" asp-route-id="@Model.UserId" class="post-user-name">
                        @Model.User?.Ten
                    </a>
                </div>
                
                @* Nút 3 chấm *@
                <div class="dropdown ms-auto">
                    <button class="post-menu-btn" type="button" data-bs-toggle="dropdown">
                        <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                    <ul class="dropdown-menu">
                        @if (currentUserId != null && currentUserId == Model.UserId)
                        {
                            <li><a class="dropdown-item text-danger" onclick="if(typeof showXoaPopup === 'function') showXoaPopup(@Model.Id); else if(typeof openDeleteModal === 'function') openDeleteModal(@Model.Id);">
                                    <i class="fa-regular fa-trash-can me-2"></i>
                                    Xóa
                                </a>
                            </li>
                        }
                        else
                        {
                            <li><a class="dropdown-item text-warning" onclick="moPopupBaoCaoBaiViet(@Model.Id)"><span class="material-icons-outlined me-2">flag</span>Báo cáo</a></li>
                        }
                    </ul>
                </div>
            </div>

            <!-- ===== NỘI DUNG ===== -->
            <p class="post-content">@Model.Noidung</p>

            <!-- ===== ẢNH ===== -->
            @if (!string.IsNullOrEmpty(Model.Anh))
            {
                <div class="post-image">
                    <img src="/baiviet/@Model.Anh" />
                </div>
            }

            <!-- ===== STATS ===== -->
            <div class="post-stats">
                <span><i class="fa-regular fa-heart"></i> <span id="total-like-@Model.Id">@Model.Thichs.Count</span></span>
                <span><i class="fa-regular fa-comment"></i> <span id="comment-count-@Model.Id">@(Model.Binhluans?.Count ?? 0)</span></span>
            </div>

            <!-- ===== PROGRESS ===== -->
            <div class="post-progress">
                <div class="post-progress-bar" style="width: 100%;"></div>
            </div>

            <!-- ===== THỜI GIAN ===== -->
            <div class="post-time">
                <i class="fa-regular fa-clock"></i> @Tinhthoigian(Model.Ngaydang)
            </div>

            <!-- ===== ACTIONS ===== -->
            <div class="post-actions">
                <button onclick="thichBaiViet(@Model.Id, this)" class="post-action-btn @(ViewBag.Thichs?.Contains(Model.Id) == true ? "liked" : "")">
                    <i class="fa-regular fa-heart"></i>
                </button>
                <button onclick="toggleBinhLuan(@Model.Id, this)" class="post-action-btn" id="comment-btn-@Model.Id">
                    <i class="fa-regular fa-comment"></i>
                </button>
            </div>

        </div>
    </div>
    <!-- ===== HỘP BÌNH LUẬN (CỘT PHẢI) ===== -->
    <div class="comment-panel" id="comment-panel-@Model.Id" style="display: none;">
        <div class="comment-panel-header">
            <h4>Bình luận (<span id="panel-comment-count-@Model.Id">@(Model.Binhluans?.Count ?? 0)</span>)</h4>
            <button class="comment-panel-close" onclick="closeBinhLuan(@Model.Id)">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
            
        <div class="comment-panel-body" id="comment-list-panel-@Model.Id">
            @if (Model.Binhluans != null && Model.Binhluans.Any())
            {
                @foreach (var bl in Model.Binhluans.OrderByDescending(b => b.Ngaydang))
                {
                    bool coQuyenXoa = (currentUserId != null && currentUserId == bl.UserId)
                                    || (currentUserId != null && currentUserId == Model.UserId);
    
                    // Lấy avatar của người comment
                    string commentAvatar = string.IsNullOrEmpty(bl.User?.Avatar) ? "/images/default.png" : bl.User.Avatar;
    
                    <div class="comment-item" id="binhluan-@bl.Id">
                        <img src="@commentAvatar" class="comment-avatar" />
                        <div class="comment-content">
                            <div class="comment-header">
                                <span class="comment-user">@bl.User?.Ten</span>
                                <div class="comment-meta">
                                    <small>@bl.Ngaydang.ToString("HH:mm")</small>
                                    @if (coQuyenXoa)
                                    {
                                        <button class="btn-delete-comment" onclick="xoaBinhLuan(@bl.Id)">
                                            <span class="material-icons-outlined">delete</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <p class="comment-text">@bl.Noidung</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="no-comment-text">Chưa có bình luận nào</p>
            }
        </div>
            
        <div class="comment-panel-footer">
            <div class="comment-input-wrapper">
                <input type="text" id="panel-comment-input-@Model.Id" placeholder="Viết bình luận..." />
                <button onclick="guiBinhLuanPanel(@Model.Id)">
                    <i class="fa-regular fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
    
    
</div>
<!-- ===== POPUP XÁC NHẬN XÓA BÌNH LUẬN ===== -->
<div class="modal fade" id="xoaBinhLuanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3">
                        <span class="material-icons-outlined" style="font-size: 40px; color: #EF4444;">delete</span>
                    </div>
                </div>
                <h5 class="fw-bold mb-2" style="color: #1E2A78;">Xóa bình luận?</h5>
                <p class="text-secondary mb-4">Bình luận sẽ bị xóa vĩnh viễn. Bạn có chắc chắn?</p>
                <input type="hidden" id="binhluanIdToDelete" />
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" onclick="xacNhanXoaBinhLuan()">
                        <span class="material-icons-outlined me-1" style="font-size: 18px;">delete</span>Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    /* Hiện nút xóa khi hover vào comment */
    .comment-item:hover .btn-delete-comment {
        opacity: 1 !important;
    }

    .btn-delete-comment:hover {
        background: rgba(239, 68, 68, 0.1) !important;
        border-radius: 50% !important;
    }
</style>
@functions {
    public string Tinhthoigian(DateTime ngaydang)
    {
        var khoangthoigian = DateTime.Now - ngaydang;
        if (khoangthoigian.TotalMinutes < 1) return "Vừa xong";
        if (khoangthoigian.TotalMinutes < 60) return $"{(int)khoangthoigian.TotalMinutes} phút trước";
        if (khoangthoigian.TotalHours < 24) return $"{(int)khoangthoigian.TotalHours} giờ trước";
        if (khoangthoigian.TotalDays < 7) return $"{(int)khoangthoigian.TotalDays} ngày trước";
        return ngaydang.ToString("dd/MM/yyyy");
    }

}
<script>
    function handleEnter(event, postId, inputId) {
        if (event.key === "Enter") {
            event.preventDefault(); // tránh reload nếu có
            guiBinhLuan(postId, inputId);
        }
    }
    
        // Biến lưu ID bình luận cần xóa
    var binhLuanIdToDelete = 0;

    // Mở popup xác nhận xóa bình luận
    function xoaBinhLuan(binhLuanId) {
        binhLuanIdToDelete = binhLuanId;
        var modal = new bootstrap.Modal(document.getElementById('xoaBinhLuanModal'));
        modal.show();
    }

    
        // Hiển thị thông báo dạng Toast
    function showToast(message, type = 'success') {
        // Tạo container toast nếu chưa có
        let toastContainer = document.getElementById('toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'toast-container';
            toastContainer.style.cssText = 'position:fixed; top:20px; right:20px; z-index:9999;';
            document.body.appendChild(toastContainer);
        }
    
        // Tạo toast
        const toast = document.createElement('div');
        toast.style.cssText = `
            background: ${type === 'success' ? '#10B981' : '#EF4444'};
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
            min-width: 250px;
        `;
    
        const icon = type === 'success' ? 'check_circle' : 'error_outline';
        toast.innerHTML = `
            <span class="material-icons-outlined">${icon}</span>
            <span style="flex:1;">${message}</span>
            <button onclick="this.parentElement.remove()" style="background:none;border:none;color:white;cursor:pointer;opacity:0.7;">×</button>
        `;
    
        toastContainer.appendChild(toast);
    
        // Tự động ẩn sau 3 giây
        setTimeout(() => toast.remove(), 3000);
    }

        // Kiểm tra xem style đã được thêm chưa
    if (!document.getElementById('toast-animation-style')) {
        const style = document.createElement('style');
        style.id = 'toast-animation-style';
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        `;
    }
    document.head.appendChild(style);
        // Gửi bình luận từ panel
    function guiBinhLuanPanel(baivietId) {
        const input = document.getElementById('panel-comment-input-' + baivietId);
        const noidung = input.value.trim();
    
        if (noidung === '') {
            // Focus lại vào input
            input.focus();
            // Hiện thông báo nhẹ (tùy chọn)
            showToast('Vui lòng nhập nội dung bình luận', 'error');
            return;
        }
    
        fetch('/Baiviet/ThemBinhLuan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `baivietId=${baivietId}&noidung=${encodeURIComponent(noidung)}&anchor=`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Thêm bình luận mới vào danh sách
                const commentList = document.getElementById('comment-list-panel-' + baivietId);
            
                // Xóa thông báo "Chưa có bình luận" nếu có
                const noComment = commentList.querySelector('.no-comment-text');
                if (noComment) noComment.remove();
            
                // Thêm HTML mới vào đầu danh sách
                commentList.insertAdjacentHTML('afterbegin', data.html);
            
                // Xóa nội dung input
                input.value = '';
            
                // Cập nhật số lượng bình luận trong panel header
                const countSpan = document.getElementById('panel-comment-count-' + baivietId);
                if (countSpan) countSpan.innerText = data.soLuong;
            
                // Cập nhật số lượng bình luận ở bài viết
                const postCountSpan = document.getElementById('comment-count-' + baivietId);
                if (postCountSpan) postCountSpan.innerText = data.soLuong;
            
                // Focus lại vào input để tiếp tục nhập
                input.focus();
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Có lỗi xảy ra', 'error');
        });
    }
        // Thêm sự kiện Enter cho input trong panel
    document.addEventListener('DOMContentLoaded', function() {
        // Sự kiện này sẽ được gắn khi panel được tạo
        // Chúng ta sẽ dùng event delegation
    });
        // Biến lưu ID bình luận cần xóa (global cho trang)
    var binhLuanIdToDelete = 0;

    // Hàm mở popup xác nhận xóa bình luận
    function xoaBinhLuan(binhLuanId) {
        binhLuanIdToDelete = binhLuanId;
        var modal = new bootstrap.Modal(document.getElementById('xoaBinhLuanModal'));
        modal.show();
    }

    // Hàm xác nhận xóa (gọi từ nút trong popup)
    function xacNhanXoaBinhLuan() {
        var modal = bootstrap.Modal.getInstance(document.getElementById('xoaBinhLuanModal'));
        modal.hide();
    
        fetch('/Baiviet/XoaBinhLuan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + binhLuanIdToDelete
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const commentElement = document.getElementById('binhluan-' + binhLuanIdToDelete);
                if (commentElement) {
                    const postCard = commentElement.closest('.post-item');
                    const postId = postCard.id.replace('post-', '');
                
                    commentElement.remove();
                
                    const commentCountSpan = document.getElementById('comment-count-' + postId);
                    if (commentCountSpan) commentCountSpan.innerText = data.soLuong;
                
                    const totalCommentSpan = document.getElementById('total-comment-' + postId);
                    if (totalCommentSpan) totalCommentSpan.innerText = data.soLuong;
                
                    showToast('Đã xóa bình luận', 'success');
                }
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Có lỗi xảy ra', 'error');
        });
    }
        // Dùng event delegation cho input trong panel
    document.addEventListener('keydown', function(e) {
        if (e.target.matches('input[id^="panel-comment-input-"]')) {
            if (e.key === 'Enter') {
                e.preventDefault(); // Ngăn xuống dòng
                const inputId = e.target.id;
                const baivietId = inputId.replace('panel-comment-input-', '');
                guiBinhLuanPanel(baivietId);
            }
        }
    });
</script>