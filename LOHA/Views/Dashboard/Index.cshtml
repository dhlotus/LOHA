@{
    ViewData["Title"] = "Tổng quan";
    Layout = "_LayoutLotus";
}

<div class="lotus-dashboard">
    <div class="lotus-welcome mb-4">
        <h2>Xin chào, @ViewBag.TenAdmin!</h2>
        <p class="text-white-50">Chào mừng trở lại bảng điều khiển LOTUS</p>
    </div>

    <!-- Thống kê -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="lotus-stat-card">
                <div class="lotus-stat-icon bg-primary">
                    <span class="material-icons-outlined">people</span>
                </div>
                <div class="lotus-stat-info">
                    <h3 id="tongNguoiDung">@ViewBag.TongNguoiDung</h3>
                    <p>Người dùng</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="lotus-stat-card">
                <div class="lotus-stat-icon bg-success">
                    <span class="material-icons-outlined">article</span>
                </div>
                <div class="lotus-stat-info">
                    <h3 id="tongBaiViet">@ViewBag.TongBaiViet</h3>
                    <p>Bài viết</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="lotus-stat-card">
                <div class="lotus-stat-icon bg-danger">
                    <span class="material-icons-outlined">flag</span>
                </div>
                <div class="lotus-stat-info">
                    <h3 id="baoCaoMoi">@ViewBag.BaoCaoMoi</h3>
                    <p>Báo cáo mới</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Hoạt động gần đây -->
    <div class="lotus-card">
        <div class="lotus-card-header d-flex justify-content-between align-items-center">
            <h5><span class="material-icons-outlined me-2">history</span>Hoạt động gần đây</h5>
            <button class="btn btn-sm btn-outline-light" onclick="loadHoatDong()">
                <span class="material-icons-outlined">refresh</span>
            </button>
        </div>
        <div class="lotus-card-body">
            <div id="hoatDongList">
                <div class="text-center py-3">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
            
            <!-- Phân trang -->
            <div id="pagination" class="d-flex justify-content-center mt-3">
                <!-- Sẽ được tạo bằng JavaScript -->
            </div>
        </div>
    </div>
</div>
<script>
        let currentPage = 1;
        let totalPages = 1;
        let intervalId = null;
        function loadThongKe() {
        fetch('/Dashboard/LayThongKe')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // So sánh giá trị cũ và mới
                    const oldNguoiDung = document.getElementById('tongNguoiDung').innerText;
                    const oldBaiViet = document.getElementById('tongBaiViet').innerText;
                    const oldBaoCao = document.getElementById('baoCaoMoi').innerText;
                
                    // Cập nhật số liệu
                    document.getElementById('tongNguoiDung').innerText = data.tongNguoiDung;
                    document.getElementById('tongBaiViet').innerText = data.tongBaiViet;
                    document.getElementById('baoCaoMoi').innerText = data.baoCaoMoi;
                
                    // Highlight nếu có thay đổi
                    if (oldNguoiDung != data.tongNguoiDung) {
                        document.getElementById('tongNguoiDung').style.color = '#10B981';
                        setTimeout(() => document.getElementById('tongNguoiDung').style.color = '', 1000);
                    }
                    if (oldBaiViet != data.tongBaiViet) {
                        document.getElementById('tongBaiViet').style.color = '#10B981';
                        setTimeout(() => document.getElementById('tongBaiViet').style.color = '', 1000);
                    }
                    if (oldBaoCao != data.baoCaoMoi) {
                        document.getElementById('baoCaoMoi').style.color = '#EF4444';
                        setTimeout(() => document.getElementById('baoCaoMoi').style.color = '', 1000);
                    }
                }
            });
    }

    function loadHoatDong(page = 1) {
        currentPage = page;
        fetch('/Dashboard/LayHoatDong?page=' + page + '&pageSize=30')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    totalPages = data.totalPages;
                    renderHoatDong(data.data);
                    renderPagination();
                }
            });
    }
     
        function renderHoatDong(data) {
        if (data.length === 0) {
            document.getElementById('hoatDongList').innerHTML = '<p class="text-white-50 text-center py-3">Chưa có hoạt động nào</p>';
            return;
        }

        let html = `
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th style="width: 100px;">Hành động</th>
                            <th>Mô tả</th>
                            <th style="width: 100px;">Loại</th>
                            <th style="width: 120px;">Admin</th>
                            <th style="width: 130px;">Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

        data.forEach(item => {
            let icon = 'info', color = '#6B7280', hanhDongText = '';
    
            switch(item.hanhDong) {
                case 'KHOA': icon = 'lock'; color = '#EF4444'; hanhDongText = 'Khóa'; break;
                case 'MO_KHOA': icon = 'lock_open'; color = '#10B981'; hanhDongText = 'Mở khóa'; break;
                case 'XOA_BAI': icon = 'delete'; color = '#F59E0B'; hanhDongText = 'Xóa bài'; break;
                case 'DONG_Y_BAO_CAO': icon = 'check_circle'; color = '#10B981'; hanhDongText = 'Đồng ý'; break;
                case 'TU_CHOI_BAO_CAO': icon = 'cancel'; color = '#EF4444'; hanhDongText = 'Từ chối'; break;
                case 'DONG_Y_BAO_CAO_USER': icon = 'person_off'; color = '#10B981'; hanhDongText = 'Đồng ý'; break;
                case 'TU_CHOI_BAO_CAO_USER': icon = 'person'; color = '#EF4444'; hanhDongText = 'Từ chối'; break;
            }

            // === XỬ LÝ MÔ TẢ CÓ LINK (ĐẶT TRONG ĐÂY) ===
            let moTaHtml = item.moTa;
        
            // Tìm bài viết #số
            moTaHtml = moTaHtml.replace(/#(\d+)/g, '<span class="text-info fw-semibold">#$1</span>');
        
            // USER #số
            moTaHtml = moTaHtml.replace(/User #(\d+)/g, '<a href="#" onclick="xemTruocNguoiDung($1); return false;" class="badge text-white text-decoration-none" style="font-size: 12px; padding: 4px 8px; cursor: pointer; transition: all 0.2s; background: #6D5DFC;" onmouseover="this.style.transform=\'scale(1.05)\'; this.style.background=\'#7B6DFF\'" onmouseout="this.style.transform=\'scale(1)\'; this.style.background=\'#6D5DFC\'">User #$1</a>');
        
            // Tìm (ID: số)
            moTaHtml = moTaHtml.replace(/\(ID:\s*(\d+)\)/g, '(<a href="#" onclick="xemTruocNguoiDung($1); return false;" class="badge text-white text-decoration-none" style="font-size: 12px; padding: 4px 8px; cursor: pointer; transition: all 0.2s; background: #A86DFC;" onmouseover="this.style.transform=\'scale(1.05)\'; this.style.background=\'#B87DFF\'" onmouseout="this.style.transform=\'scale(1)\'; this.style.background=\'#A86DFC\'">ID: $1</a>)');
            html += `
                <tr>
                    <td class="text-white-50">#${item.id}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="timeline-icon rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 28px; height: 28px; background: ${color}20; color: ${color};">
                                <span class="material-icons-outlined" style="font-size: 16px;">${icon}</span>
                            </div>
                            <span style="color: ${color};">${hanhDongText}</span>
                        </div>
                    </td>
                    <td>
                        <span class="text-white">${moTaHtml}</span>  <!-- ← DÙNG moTaHtml ĐÃ XỬ LÝ -->
                    </td>
                    <td>
                        <span class="badge bg-secondary">${item.loaiDoiTuong || '-'}</span>
                    </td>
                    <td class="text-white-50">${item.adminThucHien || '-'}</td>
                    <td class="text-white-50">
                        <span class="material-icons-outlined" style="font-size: 12px; vertical-align: middle;">schedule</span>
                        ${item.thoiGian}
                    </td>
                </tr>
            `;
        });

        html += `
                    </tbody>
                </table>
            </div>
        `;

        document.getElementById('hoatDongList').innerHTML = html;
    }

    function renderPagination() {
        if (totalPages <= 1) { document.getElementById('pagination').innerHTML = ''; return; }
        let html = '<nav><ul class="pagination pagination-sm">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link bg-dark text-white border-secondary" href="#" onclick="loadHoatDong(${currentPage - 1}); return false;">«</a></li>`;
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link bg-dark text-white border-secondary" href="#" onclick="loadHoatDong(${i}); return false;">${i}</a></li>`;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                html += '<li class="page-item disabled"><span class="page-link bg-dark text-white border-secondary">...</span></li>';
            }
        }
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link bg-dark text-white border-secondary" href="#" onclick="loadHoatDong(${currentPage + 1}); return false;">»</a></li>`;
        html += '</ul></nav>';
        document.getElementById('pagination').innerHTML = html;
    }

    // KHỞI CHẠY KHI TRANG LOAD XONG
       document.addEventListener('DOMContentLoaded', function() {
        console.log('📊 Dashboard ready!');
        loadHoatDong(1);
        loadThongKe();
        intervalId = setInterval(loadThongKe, 30000);
    });

    // Dọn dẹp khi rời trang
    window.addEventListener('beforeunload', function() {
        if (intervalId) clearInterval(intervalId);
    });

        // Xem trước người dùng
    function xemTruocNguoiDung(userId) {
        fetch('/Admin/BaoCaoNguoiDung/XemTruocNguoiDung?id=' + userId)
            .then(response => response.text())
            .then(html => {
                // Xóa popup cũ nếu có
                dongPopup();
        
                // Tạo overlay
                const overlay = document.createElement('div');
                overlay.className = 'popup-overlay';
                overlay.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9998; backdrop-filter: blur(4px);';
                overlay.onclick = dongPopup;
        
                // Tạo popup
                const popup = document.createElement('div');
                popup.className = 'popup-content';
                popup.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background: linear-gradient(145deg, #1E293B, #1A2234);
                    padding: 0;
                    border-radius: 24px;
                    z-index: 9999;
                    width: 420px;
                    max-width: 90vw;
                    max-height: 85vh;
                    overflow: hidden;
                    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(109, 93, 252, 0.1);
                    border: 1px solid rgba(109, 93, 252, 0.15);
                    animation: popupFadeIn 0.3s ease;
                `;
            
                popup.innerHTML = `
                    <!-- Header với gradient -->
                    <div style="background: linear-gradient(135deg, #6D5DFC, #A86DFC); padding: 18px 24px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <span class="material-icons-outlined" style="color: white; font-size: 22px;">person</span>
                                </div>
                                <h5 class="text-white mb-0 fw-bold" style="letter-spacing: -0.3px;">Thông tin người dùng</h5>
                            </div>
                            <button class="btn-close btn-close-white" onclick="dongPopup()" style="filter: brightness(0) invert(1); opacity: 0.8;"></button>
                        </div>
                    </div>
                
                    <!-- Body -->
                    <div style="padding: 24px; max-height: 55vh; overflow-y: auto;" class="custom-scrollbar">
                        ${html}
                    </div>
                
                    <!-- Footer -->
                    <div style="padding: 16px 24px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: flex-end; gap: 12px;">
                        <button class="btn px-4 py-2" onclick="dongPopup()" style="background: rgba(255,255,255,0.08); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 40px; font-weight: 500; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">
                            <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">close</span>
                            Đóng
                        </button>
                        <a href="/Admin/QuanLyNguoiDung/XemChiTiet/${userId}" class="btn px-4 py-2 text-white text-decoration-none" style="background: linear-gradient(135deg, #6D5DFC, #A86DFC); border: none; border-radius: 40px; font-weight: 500; transition: all 0.2s; box-shadow: 0 4px 12px rgba(109, 93, 252, 0.3);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(109, 93, 252, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(109, 93, 252, 0.3)'">
                            <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">open_in_new</span>
                            Xem chi tiết
                        </a>
                    </div>
                `;
            
                // Thêm animation CSS nếu chưa có
                if (!document.getElementById('popup-animation-style')) {
                    const style = document.createElement('style');
                    style.id = 'popup-animation-style';
                    style.textContent = `
                        @@keyframes popupFadeIn {
                            from { opacity: 0; transform: translate(-50%, -48%); }
                            to { opacity: 1; transform: translate(-50%, -50%); }
                        }
                        .custom-scrollbar::-webkit-scrollbar {
                            width: 4px;
                        }
                        .custom-scrollbar::-webkit-scrollbar-track {
                            background: rgba(255,255,255,0.05);
                            border-radius: 10px;
                        }
                        .custom-scrollbar::-webkit-scrollbar-thumb {
                            background: #6D5DFC;
                            border-radius: 10px;
                        }
                    `;
                    document.head.appendChild(style);
                }
        
                document.body.appendChild(overlay);
                document.body.appendChild(popup);
            });
    }
        function dongPopup() {
        // Xóa overlay
        const overlay = document.querySelector('.popup-overlay');
        if (overlay) overlay.remove();
    
        // Xóa popup
        const popup = document.querySelector('.popup-content');
        if (popup) popup.remove();
    }
</script>