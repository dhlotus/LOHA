        <div class="form-section">
            <div class="form-wrapper">
                <!-- Logo hiển thị trên mobile (ẩn trên desktop) -->
                <div class="mobile-logo d-md-none">
                    <img src="/images/logoLOHA.png" alt="LOHA" class="mobile-logo-img">
                </div>
        
                <h2 class="form-title">Đăng nhập vào LOHA</h2>
                @RenderBody()
                <div class="footer-lotus">
                    &copy; LOTUS
                </div>
            </div>
        </div>
