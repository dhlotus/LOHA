<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LOTUS Admin - @ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Google Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/lotus/css/lotus.css" asp-append-version="true" />
</head>
<body>
    <div class="lotus-wrapper">
        <!-- Sidebar -->
        <nav class="lotus-sidebar">
            <div class="lotus-logo">
                <span class="material-icons-outlined">local_florist</span>
                <span>LOTUS</span>
            </div>
            <ul class="lotus-menu">
                <li class="lotus-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a href="/Dashboard">
                        <span class="material-icons-outlined">dashboard</span>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li class="lotus-menu-item">
                    <a href="#">
                        <span class="material-icons-outlined">people</span>
                        <span>Người dùng</span>
                    </a>
                </li>
                <li class="lotus-menu-item">
                    <a href="#">
                        <span class="material-icons-outlined">article</span>
                        <span>Bài viết</span>
                    </a>
                </li>
                <li class="lotus-menu-item">
                    <a href="#">
                        <span class="material-icons-outlined">comment</span>
                        <span>Bình luận</span>
                    </a>
                </li>
                <li class="lotus-menu-item">
                    <a href="#">
                        <span class="material-icons-outlined">flag</span>
                        <span>Báo cáo</span>
                    </a>
                </li>
            </ul>
            <div class="lotus-footer">
                <a href="/Lotus/DangXuat" class="lotus-logout">
                    <span class="material-icons-outlined">logout</span>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="lotus-main">
            <header class="lotus-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                    <div class="lotus-admin-info">
                        <span class="material-icons-outlined">account_circle</span>
                        <span>@ViewBag.TenAdmin</span>
                    </div>
                </div>
            </header>
            <div class="lotus-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>