<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LOHA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- LOHA CSS -->
    <link rel="stylesheet" href="~/css/loha.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css"/>   
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <img src="/images/logoLOHA.png" alt="LOHA Logo" class="logo-img">
                <span class="logo-text">LOHA</span>
            </div>
            <h4 class="auth-title">@ViewData["Title"]</h4>

            @RenderBody()
        </div>

        <!-- Footer với copyright đã sửa -->
        <div class="auth-footer">
            © 2026 - From BĐH LOTUS<br />
            <small style="font-size: 12px; opacity: 0.8;">Phiên bản 1.0</small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>