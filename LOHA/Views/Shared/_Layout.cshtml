<!-- BÙI ĐỨC HÀ - LOTUS -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - LOHA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- SignalR JavaScript -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <!-- LOHA CSS -->
    <link rel="stylesheet" href="~/css/loha.css" asp-append-version="true" />

    <!-- 👉 CSS RESPONSIVE TÙY CHỈNH -->
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
@{
    // Lấy user hiện tại để dùng cho SignalR
    var userSession = Context.Session.GetString("user");
    var currentUser = userSession != null
        ? new { Id = 0 } // Sẽ được thay bằng ID thực tế
        : null;
}
<body>
    <!-- Mobile Header (chỉ hiện trên điện thoại) -->
    <div class="mobile-header d-lg-none" id="mobileHeader">
        <div class="container-fluid">
            <div class="d-flex align-items-center justify-content-between py-2">
                <span class="loha-logo fs-4">LOHA</span>
                <div class="d-flex gap-3">
                    <!-- Icon search chuyển sang trang tìm kiếm (có animation) -->
                    <a href="/User/TimKiem" class="search-trigger" style="color: #1E2A78;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </a>
                    <div class="position-relative">
                        <a href="/Chat/Index" style="color: #1E2A78;">
                            <i class="fa-regular fa-message fs-5"></i>
                        </a>
                        <span id="mobile-chat-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
                    </div>
                    <div class="position-relative">
                        <a href="/User/LoiMoiKetBan" style="color: #1E2A78;">
                            <i class="fa-regular fa-bell fs-5"></i>
                        </a>
                        <span id="mobile-notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar (Desktop) -->
    <nav class="loha-navbar d-none d-lg-flex">
        <!-- Logo bên trái -->
        <div class="loha-nav-left">
            <span class="loha-logo">LOHA</span>
        </div>

        <!-- Search Bar ở giữa -->
        <div class="loha-search-center">
            <form action="/User/TimKiem" method="get" class="loha-search-form">
                <div class="loha-search-mini">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text"
                           name="tuKhoa"
                           placeholder="Tìm kiếm bạn bè..."
                           value="@Context.Request.Query["tuKhoa"]"
                           autocomplete="off" />
                </div>
                <button type="submit" class="loha-search-btn-mini">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Tìm kiếm</span>
                </button>
            </form>
        </div>

        <!-- Icon điều hướng bên phải -->
        <div class="loha-nav-right">
            <!-- Icon Thông báo với Dropdown -->
            <div class="dropdown">
                <a href="#" class="loha-nav-icon text-decoration-none position-relative" data-bs-toggle="dropdown" aria-expanded="false" id="notificationDropdownBtn">
                    <i class="fa-regular fa-bell"></i>
                    <span id="notification-badge-desktop"
                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                          style="display: none; font-size: 10px; min-width: 18px; height: 18px; line-height: 18px; padding: 0;">
                        0
                    </span>
                </a>
                <div class="dropdown-menu dropdown-menu-end notification-dropdown p-0" id="notificationDropdown">
                    <!-- Header -->
                    <div class="notification-header">
                        <h6 class="notification-title">Thông báo</h6>
                        <span class="notification-count-badge" id="notification-total-badge">0</span>
                    </div>
        
                    <!-- Danh sách thông báo -->
                    <div class="notification-body" id="notification-list">
                        <!-- Loading -->
                        <div class="notification-loading">
                            <div class="spinner-border spinner-border-sm" style="color: var(--loha-primary);" role="status"></div>
                            <p>Đang tải thông báo...</p>
                        </div>
                    </div>
                </div>
            </div>
        
            <!-- Icon Tin nhắn -->
            <a href="/Chat/Index" class="loha-nav-icon text-decoration-none position-relative">
                <i class="fa-regular fa-message"></i>
                <span id="chat-badge-desktop"
                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                      style="display: none; font-size: 10px; min-width: 18px; height: 18px; line-height: 18px; padding: 0 5px;">
                    0
                </span>
            </a>
        
            <!-- Icon Profile -->
            <a href="/User/Trangcanhan" class="loha-nav-icon text-decoration-none">
                <i class="fa-regular fa-circle-user"></i>
            </a>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar trái (Desktop) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="loha-sidebar">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    }

                    <a href="/Baiviet/Index" class="loha-menu-item text-decoration-none @(currentController == "Baiviet" && currentAction == "Index" ? "active" : "")">
                        <i class="fa-solid fa-house"></i>
                        <span>Trang chủ</span>
                    </a>
                    <a href="/User/Trangcanhan" class="loha-menu-item text-decoration-none @(currentController == "User" && currentAction == "Trangcanhan" ? "active" : "")">
                        <i class="fa-solid fa-user"></i>
                        <span>Hồ sơ</span>
                    </a>
                    <a href="/User/BanBe" class="loha-menu-item text-decoration-none @(currentController == "User" && currentAction == "BanBe" ? "active" : "")">
                        <i class="fa-solid fa-user-group"></i>
                        <span>Bạn bè</span>
                    </a>
                    <a href="/Chat/Index" class="loha-menu-item text-decoration-none position-relative @(currentController == "Chat" && currentAction == "Index" ? "active" : "")">
                        <div class="d-flex align-items-center">
                            <i class="fa-regular fa-message me-2"></i>
                            <span>Tin nhắn</span>
                            <span id="chat-notification-badge-desktop"
                                  class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger"
                                  style="display: none; font-size: 10px; min-width: 18px; height: 18px; line-height: 18px; padding: 0 5px; margin-left: 16%; margin-top: 7%;">
                                0
                            </span>
                        </div>
                    </a>

                    <div class="loha-menu-item @(currentController == "User" && currentAction == "LoiMoiKetBan" ? "active" : "")" onclick="location.href='/User/LoiMoiKetBan'">
                        <div class="position-relative d-inline-block">
                            <i class="fa-regular fa-bell"></i>
                            <span id="notification-badge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="display: none; font-size: 10px; min-width: 18px; height: 18px; line-height: 18px; padding: 0 5px; margin-left: -50%; margin-top: 7%;">
                                0
                            </span>
                        </div>
                        <span class="ms-2">Lời mời kết bạn</span>
                    </div>

                    <div class="loha-divider"></div>

                    <a href="/User/DangXuat" class="loha-menu-item text-danger text-decoration-none">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>

                   
                </div>
                
            </div>

            <!-- Content chính (chiếm hết trên mobile) -->
            <div class="col-lg-6 col-12 d-flex flex-column">
                @RenderBody()
            </div>

            <!-- Sidebar phải (Desktop) - ĐÃ XÓA gợi ý và hoạt động -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="loha-brand px-3 py-2 text-center">
                    <!-- Logo -->
                    <img src="~/images/logoLOHA.png"
                         alt="LOHA Logo"
                         style="width: 40px; height: 40px; object-fit: cover; border-radius: 50%;"
                         class="mb-2" />

                    <!-- Tên thương hiệu -->
                    <div class="fw-bold" style="color: #1E2A78; font-size: 15px;">
                        LOHA
                    </div>

                    <!-- Người tạo -->
                    <div style="font-size: 12px; color: #6c757d;">
                        BĐH LOTUS
                    </div>

                    <!-- Slogan -->
                    <div style="font-size: 11px; color: #adb5bd;">
                        Connect • Share • Grow
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation (Mobile) -->
    <div class="bottom-nav d-lg-none">
        <a href="/Baiviet/Index" class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="fa-solid fa-house"></i>
            <span>Trang chủ</span>
        </a>
        <a href="/User/Trangcanhan" class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Trangcanhan" ? "active" : "")">
            <i class="fa-regular fa-user"></i>
            <span>Hồ sơ</span>
        </a>
        <a href="#" class="bottom-nav-item">
            <i class="fa-solid fa-user-group"></i>
            <span>Bạn bè</span>
        </a>
        <div class="loha-menu-item" onclick="location.href='/Chat/Index'">
            <i class="fa-regular fa-message"></i>
            <span>Tin nhắn</span>

            <!-- Chấm đỏ báo tin nhắn chưa đọc -->
            <span id="chat-notification-badge"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="display: none; font-size: 10px; min-width: 18px; height: 18px; line-height: 18px; padding: 0 5px; margin-left: -5px; margin-top: -5px;">
                0
            </span>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ===== HÀM CẬP NHẬT SỐ LỜI MỜI KẾT BẠN =====
        function capNhatThongBao() {
        fetch('/User/DemLoiMoiKetBan')
        .then(response => response.json())
        .then(data => {
        var badge = document.getElementById('notification-badge');
        if (badge) {
        if (data.count > 0) {
        badge.style.display = 'inline-block';
        badge.innerText = data.count > 99 ? '99+' : data.count;
        } else {
        badge.style.display = 'none';
        }
        }
        })
        .catch(error => console.error('Lỗi khi lấy thông báo:', error));
        }

        // ===== HÀM ĐẾM TIN NHẮN CHƯA ĐỌC =====
        function demTinNhanChuaDoc() {
        fetch('/Chat/DemTinNhanChuaDoc')
        .then(response => response.json())
        .then(data => {
        var badgeDesktop = document.getElementById('chat-notification-badge-desktop');
        if (badgeDesktop) {
        if (data.count > 0) {
        badgeDesktop.style.display = 'inline-block';
        badgeDesktop.innerText = data.count > 99 ? '99+' : data.count;
        } else {
        badgeDesktop.style.display = 'none';
        }
        }

        var badgeMobile = document.getElementById('chat-notification-badge');
        if (badgeMobile) {
        if (data.count > 0) {
        badgeMobile.style.display = 'inline-block';
        badgeMobile.innerText = data.count > 99 ? '99+' : data.count;
        } else {
        badgeMobile.style.display = 'none';
        }
        }
        })
        .catch(error => console.error('Lỗi đếm tin nhắn:', error));
        }

        // ===== THÔNG BÁO LOHA KIN =====
        var notificationBadge = document.getElementById('notification-badge-desktop');
        var notificationList = document.getElementById('notification-list');
        var notificationTotalBadge = document.getElementById('notification-total-badge');

        // Hàm tải thông báo
        function taiThongBao() {
        fetch('/ThongBao/LayThongBao')
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        hienThiThongBao(data.data);
        capNhatBadgeThongBao();
        }
        })
        .catch(error => {
        console.error('Lỗi tải thông báo:', error);
        if (notificationList) {
        notificationList.innerHTML = `
        <div class="notification-empty">
        <i class="fa-regular fa-circle-exclamation"></i>
        <p>Không thể tải thông báo</p>
        </div>
        `;
        }
        });
        }

        // Hàm hiển thị thông báo
        function hienThiThongBao(thongBaos) {
        if (!notificationList) return;
    
        if (!thongBaos || thongBaos.length === 0) {
        notificationList.innerHTML = `
        <div class="notification-empty">
        <i class="fa-regular fa-bell-slash"></i>
        <p>Chưa có thông báo nào</p>
        </div>
        `;
        if (notificationTotalBadge) notificationTotalBadge.textContent = '0';
        return;
        }
    
        var unreadCount = thongBaos.filter(tb => !tb.daDoc).length;
        if (notificationTotalBadge) notificationTotalBadge.textContent = unreadCount;
    
        var html = '';
        thongBaos.forEach(tb => {
        var iconClass = tb.loai === 'like' ? 'fa-heart' : 'fa-comment';
        var iconColor = tb.loai === 'like' ? 'like' : 'comment';
        var text = tb.loai === 'like'
        ? `<strong>${tb.soLuong}</strong> lượt thích mới`
        : `<strong>${tb.soLuong}</strong> bình luận mới`;
        var timeAgo = tinhThoiGian(tb.thoiGian);
        
        html += `
        <a href="/Baiviet/Chitiet/${tb.baiVietId}"
        class="notification-item ${tb.daDoc ? '' : 'unread'}"
        onclick="danhDauDaDoc(${tb.id})">
        <div class="notification-icon ${iconColor}">
        <i class="fa-regular ${iconClass}"></i>
        </div>
        <div class="notification-content">
        <div class="notification-text">${text}</div>
        <div class="notification-preview">${tb.noiDungBaiViet || 'Bài viết của bạn'}</div>
        <div class="notification-time">
        <i class="fa-regular fa-clock"></i> ${timeAgo}
        </div>
        </div>
        </a>
        `;
        });
    
        notificationList.innerHTML = html;
        }

        // Hàm cập nhật badge ngoài icon chuông
        function capNhatBadgeThongBao() {
        fetch('/ThongBao/DemThongBaoChuaDoc')
        .then(response => response.json())
        .then(data => {
        if (notificationBadge) {
        if (data.count > 0) {
        notificationBadge.style.display = 'inline-block';
        notificationBadge.innerText = data.count > 9 ? '9+' : data.count;
        } else {
        notificationBadge.style.display = 'none';
        }
        }
        });
        }

        // Hàm đánh dấu đã đọc
        function danhDauDaDoc(id) {
        fetch('/ThongBao/DanhDauDaDoc', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + id
        });
        }

        // Hàm tính thời gian tương đối
        function tinhThoiGian(thoiGian) {
        var now = new Date();
        var past = new Date(thoiGian);
        var diff = Math.floor((now - past) / 1000);
    
        if (diff < 60) return 'Vừa xong';
        if (diff < 3600) return Math.floor(diff / 60) + ' phút trước';
        if (diff < 86400) return Math.floor(diff / 3600) + ' giờ trước';
        if (diff < 604800) return Math.floor(diff / 86400) + ' ngày trước';
        return past.toLocaleDateString('vi-VN');
        }

        // ===== HIỆU ỨNG ẨN/HIỆN HEADER MOBILE =====
        (function() {
        var lastScrollTop = 0;
        var header = document.getElementById('mobileHeader');
        var ticking = false;

        if (!header) return;

        window.addEventListener('scroll', function() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (!ticking) {
        window.requestAnimationFrame(function() {
        if (scrollTop > lastScrollTop && scrollTop > 50) {
        header.classList.add('hide');
        } else if (scrollTop < lastScrollTop) {
        header.classList.remove('hide');
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        ticking = false;
        });

        ticking = true;
        }
        });

        window.addEventListener('scroll', function() {
        if (window.scrollY <= 0) {
        header.classList.remove('hide');
        }
        });
        })();

        // ===== COMMENT PANEL =====
        let currentOpenPostId = null;

        function toggleBinhLuan(baivietId, btn) {
        const panel = document.getElementById('comment-panel-' + baivietId);
        const isOpening = panel.style.display === 'none' || panel.style.display === '';
    
        if (currentOpenPostId !== null && currentOpenPostId !== baivietId) {
        const oldPanel = document.getElementById('comment-panel-' + currentOpenPostId);
        const oldBtn = document.getElementById('comment-btn-' + currentOpenPostId);
        if (oldPanel) oldPanel.style.display = 'none';
        if (oldBtn) oldBtn.classList.remove('active');
        }
    
        if (isOpening) {
        panel.style.display = 'flex';
        btn.classList.add('active');
        currentOpenPostId = baivietId;
        } else {
        panel.style.display = 'none';
        btn.classList.remove('active');
        currentOpenPostId = null;
        }
        }

        function closeBinhLuan(baivietId) {
        const panel = document.getElementById('comment-panel-' + baivietId);
        const btn = document.getElementById('comment-btn-' + baivietId);
        panel.style.display = 'none';
        btn.classList.remove('active');
        if (currentOpenPostId === baivietId) {
        currentOpenPostId = null;
        }
        }

        // ===== KHỞI TẠO KHI LOAD TRANG =====
        document.addEventListener('DOMContentLoaded', function() {
        capNhatThongBao();
        demTinNhanChuaDoc();
        capNhatBadgeThongBao();
        ketNoiSignalRThongBao(); // Gọi hàm kết nối SignalR
        });

        async function ketNoiSignalRThongBao() {
        const userId = await getCurrentUserId();
        console.log('UserId từ API:', userId);  // ← THÊM DÒNG NÀY
    
        if (!userId || userId === 0) {
        console.warn('Chưa có userId, không thể kết nối SignalR');
        return;
        }
    
        var connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub?userId=" + userId)
        .withAutomaticReconnect()
        .build();

        connection.on("CapNhatBadgeThongBao", function() {
        console.log('Nhận được CapNhatBadgeThongBao!');  // ← THÊM DÒNG NÀY
        capNhatBadgeThongBao();
        });

        connection.start()
        .then(() => console.log('SignalR thông báo đã kết nối'))
        .catch(err => console.error('SignalR lỗi:', err));
        }

        // Hàm lấy userId từ server
        async function getCurrentUserId() {
        try {
        const response = await fetch('/User/GetCurrentUserId');
        const data = await response.json();
        return data.userId;
        } catch {
        return 0;
        }
        }

        // ===== TỰ ĐỘNG CẬP NHẬT MỖI 30 GIÂY =====
        setInterval(capNhatThongBao, 30000);
        setInterval(demTinNhanChuaDoc, 30000);
        setInterval(capNhatBadgeThongBao, 30000);

        // ===== LOAD THÔNG BÁO KHI CLICK DROPDOWN =====
        document.getElementById('notificationDropdownBtn')?.addEventListener('click', function() {
        taiThongBao();
        });
    </script>
    
    <div class="modal fade" id="confirmXoaBaiVietModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3">
                            <i class="fa-regular fa-trash-can fa-3x text-danger"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">Xoá bài viết?</h5>
                    <p class="text-secondary mb-4">Bài viết sẽ bị xoá vĩnh viễn. Bạn có chắc chắn?</p>
                    <input type="hidden" id="postIdToDelete" value="" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="fa-regular fa-xmark me-2"></i>Huỷ
                        </button>
                        <button type="button" class="btn btn-danger rounded-pill px-4" onclick="window.confirmDeletePost?.()">
                            <i class="fa-regular fa-check me-2"></i>Xoá
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>