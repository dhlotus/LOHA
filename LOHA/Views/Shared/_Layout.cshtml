<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LOHA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome (dùng kit của bạn) -->
    <script src="https://kit.fontawesome.com/b0445c983b.js" crossorigin="anonymous"></script>

    <!-- LOHA CSS -->
    <link rel="stylesheet" href="~/css/loha.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar (Desktop) -->
    <nav class="loha-navbar d-flex align-items-center d-none d-lg-flex">
        <div class="d-flex align-items-center" style="width: 260px;">
            <span class="loha-logo">LOHA</span>
        </div>

        <div class="flex-grow-1 d-flex justify-content-center">
            <div class="loha-search">
                <i class="fa-regular fa-magnifying-glass"></i>
                <input type="text" placeholder="Tìm kiếm trên LOHA..." />
            </div>
        </div>

        <div class="d-flex align-items-center gap-2" style="width: 260px; justify-content: flex-end;">
            <div class="loha-nav-icon">
                <i class="fa-regular fa-bell"></i>
            </div>
            <div class="loha-nav-icon">
                <i class="fa-regular fa-message"></i>
            </div>
            <div class="loha-nav-icon">
                <i class="fa-regular fa-circle-user"></i>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar trái (Desktop) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="loha-sidebar">
                    <a href="/Baiviet/Index" class="loha-menu-item text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fa-regular fa-house"></i>
                        <span>Trang chủ</span>
                    </a>
                    <a href="/User/Trangcanhan" class="loha-menu-item text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "Trangcanhan" ? "active" : "")">
                        <i class="fa-regular fa-user"></i>
                        <span>Hồ sơ</span>
                    </a>
                    <a href="#" class="loha-menu-item text-decoration-none">
                        <i class="fa-regular fa-user-group"></i>
                        <span>Bạn bè</span>
                    </a>
                    <a href="#" class="loha-menu-item text-decoration-none">
                        <i class="fa-regular fa-message"></i>
                        <span>Tin nhắn</span>
                    </a>

                    <div class="loha-divider"></div>

                    <a href="/User/DangXuat" class="loha-menu-item text-danger text-decoration-none">
                        <i class="fa-regular fa-arrow-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>
                </div>
            </div>

            <!-- Content chính (chiếm hết trên mobile) -->
            <div class="col-lg-6 col-12">
                <main role="main" style="padding: 20px 0;" class="main-content">
                    @RenderBody()
                </main>
            </div>

            <!-- Sidebar phải (Desktop) - ĐÃ XÓA gợi ý và hoạt động -->
            <div class="col-lg-3 d-none d-lg-block">
                <!-- ĐỂ TRỐNG -->
            </div>
        </div>
    </div>

    <!-- Bottom Navigation (Mobile) -->
    <div class="bottom-nav d-lg-none">
        <a href="/Baiviet/Index" class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="fa-regular fa-house"></i>
            <span>Trang chủ</span>
        </a>
        <a href="/User/Trangcanhan" class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Trangcanhan" ? "active" : "")">
            <i class="fa-regular fa-user"></i>
            <span>Hồ sơ</span>
        </a>
        <a href="#" class="bottom-nav-item">
            <i class="fa-regular fa-user-group"></i>
            <span>Bạn bè</span>
        </a>
        <a href="#" class="bottom-nav-item">
            <i class="fa-regular fa-message"></i>
            <span>Tin nhắn</span>
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>