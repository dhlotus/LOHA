@model LOHA.Models.User

@{
    var activeTab = ViewBag.ActiveTab as string;
    var isMain = string.IsNullOrEmpty(activeTab);
}

<div class="container py-3">

    <!-- ================= TRANG CHÍNH ================= -->
    @if (isMain)
    {
        <!-- SUCCESS -->
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        <div class="profile-settings">
            <!-- Header với nút back -->
            <div class="settings-nav">
                <a asp-action="Trangcanhan" class="nav-back">
                    <span class="material-icons">arrow_back</span> Quay lại
                </a>
                <div class="nav-title">
                    <span>Cài đặt</span>
                    <h1>Thông tin cá nhân</h1>
                </div>
                <div class="nav-placeholder"></div>
            </div>

            <!-- Avatar Section -->
            <div class="avatar-section">
                <div class="avatar-wrapper">
                    <img src="/images/default.png" alt="Avatar" class="avatar-img">
                </div>
                <h3 class="avatar-name">@Model.Ten</h3>
                <p class="avatar-email">@Model.EmailorSDT</p>
            </div>

            <!-- Settings List -->
            <div class="settings-list">
                <!-- Đổi tên -->
                <a href="?tab=ten" class="setting-item">
                    <div class="setting-icon">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <div class="setting-info">
                        <h4>Đổi tên</h4>
                        <p>Cập nhật tên hiển thị của bạn</p>
                    </div>
                    <div class="setting-value">
                        <span class="current-value">@Model.Ten</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>

                <!-- Sửa ngày sinh -->
                <a href="?tab=ngaysinh" class="setting-item">
                    <div class="setting-icon">
                        <i class="fa-regular fa-calendar"></i>
                    </div>
                    <div class="setting-info">
                        <h4>Ngày sinh</h4>
                        <p>Thay đổi ngày tháng năm sinh</p>
                    </div>
                    <div class="setting-value">
                        <span class="current-value">@(Model.Ngaysinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>

                <!-- Đổi mật khẩu -->
                <a href="?tab=matkhau" class="setting-item">
                    <div class="setting-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div class="setting-info">
                        <h4>Mật khẩu</h4>
                        <p>Tăng cường bảo mật tài khoản</p>
                    </div>
                    <div class="setting-value">
                        <span class="current-value">••••••••</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>
            </div>

            <!-- Divider -->
            <div class="settings-divider"></div>

        </div>
    }

    <!-- ================= ĐỔI TÊN ================= -->
    @if (activeTab == "ten")
    {
        <div class="form-page-wrapper">
            <!-- Nút quay lại -->
            <div class="form-header">
                <div class="text-start mb-3">
                     <a asp-action="ChinhSua" class="btn-back-form">
                        <span class="material-icons">arrow_back</span> Quay lại
                    </a>
                </div>
                <h2 class="form-title">Đổi tên</h2>
                <p class="form-subtitle">Cập nhật tên hiển thị của bạn</p>
            </div>

            <!-- Form -->
            <div class="form-card">
                <form asp-action="ChinhSua" method="post">
                    <input type="hidden" name="activeTab" value="ten" />

                    <!-- Tên hiện tại -->
                    <div class="form-group">
                        <label class="form-label">Tên hiện tại</label>
                        <div class="form-value-display">
                            <span class="material-icons-outlined">person</span>
                            <span>@Model.Ten</span>
                        </div>
                    </div>

                    <!-- Cảnh báo block -->
                    @if (ViewBag.BlockTen == true)
                    {
                        <div class="alert-warning">
                            <i class="fa-regular fa-clock"></i>
                            <span>@ViewBag.MsgTen</span>
                        </div>
                    }

                   <!-- Tên mới -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Tên mới</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-regular fa-pen-to-square" style="color: #6C63FF;"></i>
                            </span>
                            <input name="Ten" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   value="@ViewBag.Ten" placeholder="Nhập tên mới" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("Ten")</span>
                    </div>

                    <!-- Mật khẩu xác nhận -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Mật khẩu xác nhận</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-solid fa-lock" style="color: #6C63FF;"></i>
                            </span>
                            <input name="MatKhauCu" type="password" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   placeholder="Nhập mật khẩu để xác nhận" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("MatKhauCu")</span>
                    </div>

                    <!-- Nút submit -->
                    <button type="submit" class="btn-submit-form">
                        <span class="material-icons" style="font-size: 20px;">check</span>
                        <span>Xác nhận thay đổi</span>
                    </button>
                </form>
            </div>
        </div>
    }
    <!-- ================= NGÀY SINH ================= -->
    @if (activeTab == "ngaysinh")
    {
        <div class="form-page-wrapper">
            <div class="form-header">
                <div class="text-start mb-3">
                    <a asp-action="ChinhSua" class="btn-back-form">
                        <span class="material-icons">arrow_back</span> Quay lại
                    </a>
                </div>
                <h2 class="form-title">Đổi ngày sinh</h2>
                <p class="form-subtitle">Cập nhật ngày tháng năm sinh</p>
            </div>

            <div class="form-card">
                <form asp-action="ChinhSua" method="post">
                    <input type="hidden" name="activeTab" value="ngaysinh" />

                    <div class="form-group">
                        <label class="form-label">Ngày sinh hiện tại</label>
                        <div class="form-value-display">
                            <i class="fa-regular fa-calendar"></i>
                            <span>@Model.Ngaysinh?.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    @if (ViewBag.BlockNgaySinh == true)
                    {
                        <div class="alert-warning">
                            <i class="fa-regular fa-clock"></i>
                            <span>@ViewBag.MsgNgaySinh</span>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Ngày sinh mới</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-regular fa-calendar" style="color: #6C63FF;"></i>
                            </span>
                            <input name="Ngaysinh" type="date" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   value="@(ViewBag.Ngaysinh != null ? ((DateTime)ViewBag.Ngaysinh).ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("Ngaysinh")</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Mật khẩu xác nhận</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-solid fa-lock" style="color: #6C63FF;"></i>
                            </span>
                            <input name="MatKhauCu" type="password" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   placeholder="Nhập mật khẩu để xác nhận" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("MatKhauCu")</span>
                    </div>

                    <button type="submit" class="btn-submit-form">
                        <i class="fa-solid fa-check"></i>
                        <span>Xác nhận thay đổi</span>
                    </button>
                </form>
            </div>
        </div>
    }
    

    <!-- ================= MẬT KHẨU ================= -->
    @if (activeTab == "matkhau")
    {
        <div class="form-page-wrapper">
            <div class="form-header">
                <div class="text-start mb-3">
                    <a asp-action="ChinhSua" class="btn-back-form">
                         <span class="material-icons">arrow_back</span> Quay lại
                    </a>
                </div>
                <h2 class="form-title">Đổi mật khẩu</h2>
                <p class="form-subtitle">Tăng cường bảo mật tài khoản của bạn</p>
            </div>

            <div class="form-card">
                <form asp-action="ChinhSua" method="post">
                    <input type="hidden" name="activeTab" value="matkhau" />

                    <!-- Mật khẩu hiện tại -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Mật khẩu hiện tại</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-solid fa-lock" style="color: #6C63FF;"></i>
                            </span>
                            <input name="MatKhauCu" type="password" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   placeholder="Nhập mật khẩu hiện tại" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("MatKhauCu")</span>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-solid fa-key" style="color: #6C63FF;"></i>
                            </span>
                            <input name="MatKhauMoi" type="password" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   placeholder="Tối thiểu 6 ký tự, có cả chữ và số" />
                        </div>
                        <span class="text-danger small mt-1">@Html.ValidationMessage("MatKhauMoi")</span>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="color: #1E2A78;">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text border rounded-start-3" style="background: #F8FAFF; border-color: #E5E7EB;">
                                <i class="fa-solid fa-check" style="color: #6C63FF;"></i>
                            </span>
                            <input name="XacNhanMatKhau" type="password" class="form-control border rounded-end-3" 
                                   style="background: #F8FAFF; border-color: #E5E7EB; padding: 12px;"
                                   placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span class="text-danger small mt-1" id="xacNhanMatKhauError">@Html.ValidationMessage("XacNhanMatKhau")</span>
                    </div>

                    <!-- Nút submit -->
                    <button type="submit" class="btn-submit-form">
                        <i class="fa-solid fa-check"></i>
                        <span>Xác nhận thay đổi</span>
                    </button>
                </form>
            </div>
        </div>
    }

</div>

<!-- ================= MODAL CONFIRM ================= -->
@if (ViewBag.ShowConfirm == true)
{
    <div class="modal fade show confirm-modal" id="confirmModal" tabindex="-1" style="display:block; background:rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body text-center p-4">
                    <!-- Icon -->
                    <div class="mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3">
                            <i class="fa-regular fa-circle-question fa-3x" style="color: #F59E0B;"></i>
                        </div>
                    </div>
                    
                    <!-- Tiêu đề -->
                    <h5 class="fw-bold mb-2" style="color: #1E2A78;">Xác nhận thay đổi</h5>
                    
                    <!-- Nội dung -->
                    <p class="text-secondary mb-4" style="font-size: 14px;">
                        Bạn có chắc chắn muốn thay đổi thông tin này không?
                    </p>
                    
                    <!-- Nút hành động -->
                    <div class="d-flex gap-3 justify-content-center">
                        <!-- Nút Hủy -->
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="dongModalVaGiuDuLieu()">
                            <span class="material-icons me-2" style="font-size: 18px;">close</span>
                            Hủy
                        </button>
    
                        <!-- Nút Xác nhận -->
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2" form="confirmForm">
                            <span class="material-icons me-2" style="font-size: 18px;">check_circle</span>
                            Ok
                        </button>
                    </div>

                    <!-- Form giữ nguyên -->
                    <form asp-action="ChinhSua" method="post" id="confirmForm">
                        <input type="hidden" name="confirm" value="true" />
                        <input type="hidden" name="activeTab" value="@activeTab" />
                        <input type="hidden" name="Ten" value="@ViewBag.Ten" />
                        <input type="hidden" name="Ngaysinh" value="@(ViewBag.Ngaysinh != null ? ((DateTime)ViewBag.Ngaysinh).ToString("yyyy-MM-dd") : "")" />
                        <input type="hidden" name="MatKhauCu" value="@ViewBag.MatKhauCu" />
                        <input type="hidden" name="MatKhauMoi" value="@ViewBag.MatKhauMoi" />
                        <input type="hidden" name="XacNhanMatKhau" value="@ViewBag.XacNhanMatKhau" />
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // ===== ĐẶT CÁC HÀM Ở ĐÂY (TRƯỚC KHI MODAL ĐƯỢC GỌI) =====
        
        // Hàm đóng modal và giữ dữ liệu
        function dongModalVaGiuDuLieu() {
            // Chỉ ẩn modal, không xóa
            var modal = document.getElementById('confirmModal');
            if (modal) {
                modal.style.display = 'none';
                // Không dùng modal.remove() - chỉ ẩn đi
            }
            // Dữ liệu trong input tự động giữ nguyên vì không reload
        }
        
        // Kiểm tra xác nhận mật khẩu realtime
        var matKhauMoi = document.querySelector('input[name="MatKhauMoi"]');
        var xacNhanMatKhau = document.querySelector('input[name="XacNhanMatKhau"]');
        var xacNhanError = document.createElement('span');
        
        // Đóng modal khi click ra ngoài
        document.addEventListener('DOMContentLoaded', function() {
            var modal = document.getElementById('confirmModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        dongModalVaGiuDuLieu();
                    }
                });
            }
        });
        // Kiểm tra xác nhận mật khẩu realtime cho form đổi mật khẩu
        var matKhauMoiInput = document.querySelector('input[name="MatKhauMoi"]');
        var xacNhanMatKhauInput = document.querySelector('input[name="XacNhanMatKhau"]');
        var xacNhanErrorSpan = document.getElementById('xacNhanMatKhauError');

        if (matKhauMoiInput && xacNhanMatKhauInput && xacNhanErrorSpan) {
            function checkPasswordMatch() {
                if (matKhauMoiInput.value !== xacNhanMatKhauInput.value) {
                    xacNhanErrorSpan.innerText = 'Mật khẩu xác nhận không khớp';
                    xacNhanErrorSpan.style.color = '#DC2626';
                } else {
                    xacNhanErrorSpan.innerText = '';
                }
            }
    
            matKhauMoiInput.addEventListener('input', checkPasswordMatch);
            xacNhanMatKhauInput.addEventListener('input', checkPasswordMatch);
        }
    </script>
}
<style>
    .custom-menu .nav-link {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        margin-bottom: 10px;
        border-radius: 10px;
        color: #0d6efd;
        padding: 12px 16px;
        transition: all 0.2s ease;
        font-weight: 500;
    }

    .custom-menu .nav-link:hover {
        background: #0d6efd;
        color: #fff;
        transform: translateX(5px);
    }

    .custom-menu .nav-link.active {
        background: #0d6efd;
        color: white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    /* ===== PROFILE SETTINGS ===== */
.profile-settings {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 20px 40px;
}

/* ===== NAVIGATION ===== */
.settings-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
}

.nav-back {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #F8FAFF;
    border-radius: 40px;
    color: #1E2A78;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid #E5E7EB;
}

.nav-back:hover {
    background: #6C63FF;
    color: white;
    border-color: #6C63FF;
    transform: translateX(-3px);
}
.nav-back i {
    font-size: 14px;
}
.nav-title {
    text-align: center;
}

.nav-title span {
    font-size: 13px;
    color: #6C63FF;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

.nav-title h1 {
    font-size: 20px;
    font-weight: 600;
    color: #1E2A78;
    margin: 4px 0 0;
}

.nav-placeholder {
    width: 40px;
}

/* ===== AVATAR SECTION ===== */
.avatar-section {
    text-align: center;
    margin-bottom: 32px;
}

.avatar-wrapper {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto 16px;
}

.avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.avatar-name {
    font-size: 20px;
    font-weight: 600;
    color: #1E2A78;
    margin-bottom: 4px;
}

.avatar-email {
    font-size: 13px;
    color: #6B7280;
}

/* ===== SETTINGS LIST ===== */
.settings-list {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
    margin-bottom: 24px;
}

.setting-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    text-decoration: none;
    transition: all 0.2s;
    border-bottom: 1px solid #E5E7EB;
}

.setting-item:last-child {
    border-bottom: none;
}

.setting-item:hover {
    background: #F8FAFF;
}

.setting-icon {
    width: 48px;
    height: 48px;
    background: #F0F2FF;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6C63FF;
    font-size: 20px;
}

.setting-info {
    flex: 1;
}

.setting-info h4 {
    font-size: 16px;
    font-weight: 600;
    color: #1E2A78;
    margin-bottom: 4px;
}

.setting-info p {
    font-size: 13px;
    color: #6B7280;
    margin: 0;
}

.setting-value {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #9CA3AF;
}

.current-value {
    font-size: 14px;
    color: #6B7280;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.setting-value i {
    font-size: 12px;
    transition: transform 0.2s;
}

.setting-item:hover .setting-value i {
    transform: translateX(3px);
    color: #6C63FF;
}

/* ===== DIVIDER ===== */
.settings-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #E5E7EB, transparent);
    margin: 24px 0;
}
/* ===== FORM PAGE WRAPPER ===== */
.form-page-wrapper {
    max-width: 680px;  
    margin: 0 auto;
    padding: 24px 20px 40px;
}

/* ===== FORM HEADER ===== */
.form-header {
    text-align: center;
    margin-bottom: 32px;
}

.btn-back-form {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: #F8FAFF;
    border-radius: 40px;
    color: #1E2A78;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid #E5E7EB;
    margin-bottom: 20px;
}

.btn-back-form:hover {
    background: #6C63FF;
    color: white;
    border-color: #6C63FF;
    transform: translateX(-3px);
}

.form-title {
    font-size: 28px;
    font-weight: 700;
    color: #1E2A78;
    margin-bottom: 8px;
}

.form-subtitle {
    font-size: 14px;
    color: #6B7280;
}

.btn-outline-secondary,
.btn-primary {
    min-width: 120px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* Icon trong nút */
.btn .material-icons {
    font-size: 18px;
    vertical-align: middle;
