@{
    ViewData["Title"] = "Xác nhận mã OTP";
    Layout = "_LayoutAuth";
    string email = ViewBag.Email ?? "";
}

<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7" style="width:100%; padding: 0;">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <!-- Logo -->
                    <div class="text-center mb-4">
                        <img src="/images/logoLOHA.png" alt="LOHA" style="width: 60px; height: 60px; object-fit: cover; border-radius: 14px;" />
                        <h3 class="fw-bold mt-3" style="color: #1E2A78;">Xác nhận mã OTP</h3>
                        <p class="text-secondary">
                            Mã xác nhận đã được gửi đến <strong style="color: #6C63FF;">@email</strong>
                        </p>
                    </div>

                    <!-- Toast Container -->
                    <div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

                    <!-- Form nhập OTP và mật khẩu mới -->
                    <form asp-action="DatLaiMatKhau" method="post">
                        <!-- Ẩn email để gửi về server -->
                        <input type="hidden" name="email" value="@email" />

                        <!-- Nhập mã OTP -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold" style="color: #1E2A78;">
                                <span class="material-icons-outlined me-2">pin</span>Mã OTP (6 số)
                            </label>
                            <input type="text"
                                   name="maOTP"
                                   class="form-control rounded-pill py-3 px-4 text-center fs-3 fw-bold"
                                   placeholder="000000"
                                   maxlength="6"
                                   required
                                   style="border-color: #E5E7EB; background: #F8FAFF; letter-spacing: 12px; color: #1E2A78;" />
                        </div>

                        <!-- Nhập mật khẩu mới -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="color: #1E2A78;">
                                <span class="material-icons-outlined me-2">lock</span>Mật khẩu mới
                            </label>
                            <div class="position-relative">
                                <input type="password"
                                       name="matKhauMoi"
                                       id="matKhauMoi"
                                       class="form-control rounded-pill py-3 px-4"
                                       placeholder="Ít nhất 6 ký tự, có chữ và số"
                                       required
                                       style="border-color: #E5E7EB; background: #F8FAFF; padding-right: 50px;" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2" 
                                        onclick="togglePassword('matKhauMoi', this)" style="color: #8A8A9E;">
                                    <span class="material-icons-outlined">visibility</span>
                                </button>
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold" style="color: #1E2A78;">
                                <span class="material-icons-outlined me-2">check_circle</span>Xác nhận mật khẩu
                            </label>
                            <div class="position-relative">
                                <input type="password"
                                       name="xacNhanMatKhau"
                                       id="xacNhanMatKhau"
                                       class="form-control rounded-pill py-3 px-4"
                                       placeholder="Nhập lại mật khẩu mới"
                                       required
                                       style="border-color: #E5E7EB; background: #F8FAFF; padding-right: 50px;" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2" 
                                        onclick="togglePassword('xacNhanMatKhau', this)" style="color: #8A8A9E;">
                                    <span class="material-icons-outlined">visibility</span>
                                </button>
                            </div>
                            <span id="loiXacNhan" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn w-100 rounded-pill py-3 fw-semibold" 
                                style="background: linear-gradient(135deg, #1E2A78, #6C63FF); 
                                       color: white; 
                                       border: none;
                                       transition: all 0.3s ease;">
                            Đặt lại mật khẩu <span class="material-icons-outlined ms-2" style="vertical-align: middle;">check</span>
                        </button>
                    </form>

                    <!-- Link quay lại -->
                    <div class="text-center mt-4">
                        <a asp-action="QuenMatKhau" class="text-decoration-none" style="color: #6C63FF;">
                            <span class="material-icons-outlined me-1">arrow_back</span>Gửi lại mã OTP
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Desktop: tăng kích thước */
    @@media (min-width: 992px) {
        .card-body {
            padding: 40px 50px !important;
        }
        
        h3 {
            font-size: 28px !important;
        }
        
        .form-control {
            padding: 14px 20px !important;
            font-size: 16px !important;
        }
        
        .btn {
            padding: 14px 0 !important;
            font-size: 16px !important;
        }
    }
    
    .material-icons-outlined {
        vertical-align: middle;
        font-size: 20px;
    }
</style>

<script>
    // Kiểm tra mật khẩu xác nhận có khớp không
    document.getElementById('xacNhanMatKhau').addEventListener('input', function() {
        var matKhau = document.getElementById('matKhauMoi').value;
        var xacNhan = this.value;
        var loiSpan = document.getElementById('loiXacNhan');

        if (matKhau !== xacNhan) {
            loiSpan.innerText = 'Mật khẩu xác nhận không khớp';
        } else {
            loiSpan.innerText = '';
        }
    });

    // Toggle hiển thị mật khẩu
    function togglePassword(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('.material-icons-outlined');
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }

    // ===== TOAST NOTIFICATION =====
    @if (TempData["ThongBao"] != null)
    {
            <text>
                showToast('@Html.Raw(TempData["ThongBao"])', 'success');
            </text>
    }

    @if (TempData["Loi"] != null)
    {
            <text>
                showToast('@Html.Raw(TempData["Loi"])', 'error');
            </text>
    }

    function showToast(message, type = 'success') {
        let toastContainer = document.getElementById('toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'toast-container';
            toastContainer.style.cssText = 'position:fixed; top:20px; right:20px; z-index:9999;';
            document.body.appendChild(toastContainer);
        }
        
        const toast = document.createElement('div');
        toast.style.cssText = `
            background: ${type === 'success' ? '#10B981' : '#EF4444'};
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
            min-width: 280px;
        `;
        
        const icon = type === 'success' ? 'check_circle' : 'error_outline';
        toast.innerHTML = `
            <span class="material-icons-outlined">${icon}</span>
            <span style="flex:1;">${message}</span>
            <button type="button" class="btn-close btn-close-white" onclick="this.parentElement.remove()"></button>
        `;
        
        toastContainer.appendChild(toast);
        setTimeout(() => {
            toast.style.animation = 'slideOut 0.3s ease forwards';
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    // Thêm animation
    if (!document.getElementById('toast-animation')) {
        const style = document.createElement('style');
        style.id = 'toast-animation';
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @@keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    }
</script>