@model LOHA.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LayoutLogin";
    var dangKyThanhCong = TempData["DangKyThanhCong"]?.ToString();
    var thongBao = TempData["ThongBao"]?.ToString() ?? "";
}
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
@if (!string.IsNullOrEmpty(dangKyThanhCong) && dangKyThanhCong == "true")
{
    <div class="popup-success" id="successPopup">
        <div class="popup-content">
            <div class="popup-icon">
                <i class="fa-regular fa-circle-check"></i>
            </div>
            <h5 class="popup-title">Thành công!</h5>
            <p class="popup-message">@thongBao</p>
            <div class="popup-progress">
                <div class="popup-progress-bar"></div>
            </div>
        </div>
    </div>
}

<form asp-action="DangNhap" method="post">
    <div class="input-group">
        <div class="email-wrapper">
            <input asp-for="EmailorSDT" class="login-input" type="text" placeholder="Số di động, tên người dùng hoặc email" />
            <span asp-validation-for="EmailorSDT" class="text-danger small"></span>
        </div>
    </div>

    <div class="input-group">
        <div class="password-wrapper">
            <input asp-for="Matkhau" class="login-input" type="password" placeholder="Mật khẩu" id="passwordInput" />
            <button type="button" class="toggle-password-btn" onclick="togglePassword()">
                <i class="fa-regular fa-eye" id="togglePasswordIcon"></i>
            </button>
        </div>
        <span asp-validation-for="Matkhau" class="text-danger small"></span>
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    }
    <button type="submit" class="login-btn" id="loginBtn">Đăng nhập</button>

    <a asp-action="QuenMatKhau" class="forgot-link">Quên mật khẩu?</a>
        
    <a href="/User/DangKy" class="register-btn">Tạo tài khoản mới</a>
</form>
<!-- ===== POPUP TÀI KHOẢN BỊ KHÓA ===== -->
@if (TempData["TaiKhoanBiKhoa"]?.ToString() == "true")
{
    <div class="modal fade" id="khoaTaiKhoanModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3">
                            <span class="material-icons-outlined" style="font-size: 48px; color: #DC2626;">lock</span>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2" style="color: #1E2A78;">Tài khoản bị khóa</h5>
                    <p class="text-secondary mb-4">
                        Tài khoản của bạn đã bị khóa do vi phạm điều khoản.<br />
                        Vui lòng liên hệ quản trị viên để được hỗ trợ.
                    </p>
                    <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal"
                            style="background: linear-gradient(135deg, #1E2A78, #6C63FF); border: none;">
                        <span class="material-icons-outlined me-1" style="vertical-align: middle;">close</span>
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Tự động hiển thị popup khi trang load
        document.addEventListener('DOMContentLoaded', function() {
            var modal = new bootstrap.Modal(document.getElementById('khoaTaiKhoanModal'));
            modal.show();
        });
    </script>
}
<script>
    // Kiểm tra input để active button
    function checkInputs() {
        var emailInput = document.querySelector('input[name="EmailorSDT"]');
        var passwordInput = document.getElementById('passwordInput');
        var loginBtn = document.getElementById('loginBtn');
        
        if (emailInput.value.trim() !== '' && passwordInput.value.trim() !== '') {
            loginBtn.classList.add('active');
            loginBtn.disabled = false;
        } else {
            loginBtn.classList.remove('active');
            loginBtn.disabled = true;
        }
    }

    document.querySelector('input[name="EmailorSDT"]')?.addEventListener('input', checkInputs);
    document.getElementById('passwordInput')?.addEventListener('input', checkInputs);
    
    // Khởi tạo trạng thái ban đầu
    checkInputs();

    // Tự động ẩn popup sau 3 giây
    setTimeout(function() {
        var popup = document.getElementById('successPopup');
        if (popup) {
            popup.style.animation = 'slideInRight 0.3s ease reverse forwards';
            setTimeout(function() {
                popup.remove();
            }, 300);
        }
    }, 3000);
        // Toggle hiển thị/ẩn mật khẩu
    function togglePassword() {
        var passwordInput = document.getElementById('passwordInput');
        var icon = document.getElementById('togglePasswordIcon');
    
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            passwordInput.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>