@model LOHA.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LayoutLogin";
    var dangKyThanhCong = TempData["DangKyThanhCong"]?.ToString();
    var thongBao = TempData["ThongBao"]?.ToString() ?? "";
}

@if (!string.IsNullOrEmpty(dangKyThanhCong) && dangKyThanhCong == "true")
{
    <div class="popup-success" id="successPopup">
        <div class="popup-content">
            <div class="popup-icon">
                <i class="fa-regular fa-circle-check"></i>
            </div>
            <h5 class="popup-title">Thành công!</h5>
            <p class="popup-message">@thongBao</p>
            <div class="popup-progress">
                <div class="popup-progress-bar"></div>
            </div>
        </div>
    </div>
}

<form asp-action="DangNhap" method="post">
    <div class="input-group">
        <input asp-for="EmailorSDT" class="login-input" type="text" placeholder="Số di động, tên người dùng hoặc email" />
        <span asp-validation-for="EmailorSDT" class="text-danger small"></span>
    </div>

    <div class="input-group">
        <input asp-for="Matkhau" class="login-input" type="password" placeholder="Mật khẩu" id="passwordInput" />
        <span asp-validation-for="Matkhau" class="text-danger small"></span>
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-custom">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>
    }
    <button type="submit" class="login-btn" id="loginBtn">Đăng nhập</button>

    <a href="#" class="forgot-link">Quên mật khẩu?</a>
        
    <a href="/User/DangKy" class="register-btn">Tạo tài khoản mới</a>
</form>

<script>
    // Kiểm tra input để active button
    function checkInputs() {
        var emailInput = document.querySelector('input[name="EmailorSDT"]');
        var passwordInput = document.getElementById('passwordInput');
        var loginBtn = document.getElementById('loginBtn');
        
        if (emailInput.value.trim() !== '' && passwordInput.value.trim() !== '') {
            loginBtn.classList.add('active');
            loginBtn.disabled = false;
        } else {
            loginBtn.classList.remove('active');
            loginBtn.disabled = true;
        }
    }

    document.querySelector('input[name="EmailorSDT"]')?.addEventListener('input', checkInputs);
    document.getElementById('passwordInput')?.addEventListener('input', checkInputs);
    
    // Khởi tạo trạng thái ban đầu
    checkInputs();

    // Tự động ẩn popup sau 3 giây
    setTimeout(function() {
        var popup = document.getElementById('successPopup');
        if (popup) {
            popup.style.animation = 'slideInRight 0.3s ease reverse forwards';
            setTimeout(function() {
                popup.remove();
            }, 300);
        }
    }, 3000);
</script>