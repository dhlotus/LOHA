@model LOHA.Models.User

<div class="container mt-4">
    <div class="position-relative">
        <img src="/images/cover.jpg" 
                class="img-fluid w-100 rounded" 
                style="height:350px; 
                       object-fit:cover;"/>

        <img src="/images/default.png"
             class="rounded-circle border border-white shadow"
             style="width: 160px;
                    height:160px;
                    object-fit:cover;
                    position:absolute;
                    bottom: -80px;
                    left: 40px"/>
    </div>

    <div style="margin: 20px; margin-left: 220px;">
        <h3 class="fw-bold">@Model.Ten</h3>
    </div>

    <div class="mt-lg-5 bg-white border rounded p-2">
        <div class="mt-4 bg-white border rounded p-2">
            <ul class="nav nav-tabs border-0 justify-content-center">
                <li class="nav-item mx-3">
                    <a class="nav-link active fw-bold text-primary border-bottom border-3">Bài Viết</a>
                </li>

                <li class="nav-item mx-3">
                    <a class="nav-link text-dark border-0">Ảnh</a>
                </li>

                <li class="nav-item mx-3">
                    <a></a>
                    <a class="nav-link text-dark border-0">Bạn bè</a>
                </li>
            </ul>
        </div>

        <!--đăng bài trong trang cá nhân-->
        <div class="card mb-3">
            <div class="card-body">

                <form action="/Baiviet/Taobaiviet" method="post" enctype="multipart/form-data">

                    <div class="d-flex">
                        <img src="/images/default.png"
                             class="rounded-circle me-2"
                             style="width:40px;height:40px;object-fit:cover" />

                        <textarea name="Noidung"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Bạn đang nghĩ gì?"
                                  style="max-height:140px"></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">

                        <input type="file" name="AnhFile" class="form-control w-50" />

                        <button class="btn btn-primary">
                            Đăng bài
                        </button>

                    </div>

                </form>

            </div>
        </div>
        @foreach (var bv in ViewBag.Baiviets)
        {
            <div class="card mt-3" id="bv-@bv.Id">
                <div class="card-body">

                    <div class="d-flex align-items-center mb-2">
                        <img src="/images/default.png"
                             class="rounded-circle me-2"
                             style="width:40px;height:40px;object-fit:cover" />

                        <div>
                            <b>@Model.Ten</b><br />
                            <small class="text-muted">@bv.Ngaydang</small>
                        </div>
                    </div>

                    <p>@bv.Noidung</p>

                    @if (bv.Anh != null)
                    {
                        <img src="~/baiviet/@bv.Anh"
                             class="img-fluid rounded mb-2"
                             style="width:100%; height:400px; object-fit:contain;" /> <!--đặt kích thước cố định cho tất cả ảnh-->
                    }

                    <div class="d-flex justify-content-around border-top pt-2">
                        <button onclick="thichBaiViet(@bv.Id)" 
                                class="btn w-50 @(ViewBag.Thichs.Contains(bv.Id) ? "btn-primary" : "btn-light")" 
                                id="btn-like-@bv.Id">
                            👍 <span id="soLike-@bv.Id">@bv.Thichs.Count</span>
                        </button>
                        <a href="/Baiviet/ChiTiet/@bv.Id" class="btn btn-light w-50">💬 Bình luận</a>
                    </div>

                </div>
            </div>
        }
        
    </div>
</div>
<script>
function thichBaiViet(id) {
    fetch("/Baiviet/ThichBaiViet?baiVietId=" + id, {
        method: "POST"
    })
    .then(response => response.json())
    .then(data => {
        // Cập nhật số like
        document.getElementById("soLike-" + id).innerText = data.soLuong;
        
        // Lấy nút like
        var btn = document.getElementById("btn-like-" + id);
        
        // Đổi màu dựa vào trạng thái mới
        if (data.daThich) {
            btn.classList.remove("btn-light");
            btn.classList.add("btn-primary");
        } else {
            btn.classList.remove("btn-primary");
            btn.classList.add("btn-light");
        }
    });
}
</script>