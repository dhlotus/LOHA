        // Hiển thị menu bài viết (bên phải icon 3 chấm)
    function showPostMenu(postId, btn) {
        event.stopPropagation();

        document.querySelectorAll('[id^="postMenu-"]').forEach(menu => {
            if (menu.id !== 'postMenu-' + postId) {
                menu.style.display = 'none';
            }
        });

        var menu = document.getElementById('postMenu-' + postId);
        if (menu.style.display === 'none') {
            menu.style.display = 'block';
            var rect = btn.getBoundingClientRect();
            menu.style.position = 'fixed';
            menu.style.top = (rect.top + 5) + 'px';
            menu.style.right = (window.innerWidth - rect.right) + 'px';
            menu.style.zIndex = '9999';
        } else {
            menu.style.display = 'none';
        }
    }

    // Đóng menu khi click ra ngoài
    document.addEventListener('click', function(e) {
        if (!e.target.closest('[id^="menuBtn-"]') && !e.target.closest('[id^="postMenu-"]')) {
            document.querySelectorAll('[id^="postMenu-"]').forEach(menu => {
                menu.style.display = 'none';
            });
        }
    });

