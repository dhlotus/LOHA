<!--BÙI ĐỨC HÀ - LOTUS ->
@model LOHA.Models.User

@{
    // Kiểm tra ảnh bìa mặc định
    string coverImage = "/images/cover.jpg"; // Ảnh bìa mặc định
    string avatarImage = "/images/default.png"; // Avatar mặc định
}
<div class="container-fluid mt-4 px-2 px-md-4">
    <!-- ===== COVER & AVATAR ===== -->
<div class="position-relative">
    <!-- Ảnh bìa -->
    <img src="@coverImage"
         class="img-fluid w-100 rounded-4 cover-img" />

    <!-- Avatar -->
    <div class="position-absolute avatar-wrapper">
        <img src="@avatarImage"
             class="rounded-circle border border-4 border-white shadow avatar-img" />
    </div>
</div>

<!-- ===== PROFILE INFO ===== -->
<div class="mt-5 pt-4 ms-md-5 ms-lg-6">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="fw-bold" style="color: #1E2A78;">@Model.Ten</h1>
        </div>

        <!-- 👉 NÚT KẾT BẠN  -->
        @if (ViewBag.CurrentUserId != Model.ID) // Nếu không phải trang của mình
        {
            if (ViewBag.DaLaBanBe)
            {
                <div class="dropdown">
                    <button class="btn btn-success rounded-pill px-4 dropdown-toggle"
                            type="button"
                            id="dropdownMenuButton-@Model.ID"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fa-solid fa-user-group"></i> Bạn bè
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@Model.ID">
                        <li>
                            <a class="dropdown-item text-danger"
                               href="#"
                               onclick="huyKetBan(@Model.ID); return false;">
                                <i class="fa-regular fa-user-slash me-2"></i>Huỷ kết bạn
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Chat/ChatVoi?userId=@Model.ID">
                                <i class="fa-regular fa-message me-2"></i>Nhắn tin
                            </a>
                        </li>
                    </ul>
                </div>
            }

            else if (ViewBag.DaGuiLoiMoi)
            {
                <button onclick="huyLoiMoiKetBan(@Model.ID)"
                        class="btn btn-warning rounded-pill px-4"
                        id="btnKetBan-@Model.ID">
                    <i class="fa-regular fa-clock me-2"></i>Đã gửi lời mời
                </button>
            }
            else
            {
                <button onclick="guiLoiMoiKetBan(@Model.ID)"
                        class="btn btn-primary rounded-pill px-4"
                        id="btnKetBan-@Model.ID">
                    <i class="fa-regular fa-user-plus me-2"></i>Kết bạn
                </button>
            }
        }
        else
        {
            <!-- Nếu là trang của mình thì hiện nút chỉnh sửa -->
            <button class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-regular fa-pen-to-square me-2"></i>Chỉnh sửa trang
            </button>
        }
    </div>

    <!-- Stats -->
    <div class="d-flex flex-wrap gap-3 mt-3">
        <div class="text-center">
            <span class="d-block fw-bold fs-4" style="color: #1E2A78;">@ViewBag.Baiviets.Count</span>
            <span class="text-secondary">Bài viết</span>
        </div>
        <div class="text-center">
            <span class="d-block fw-bold fs-4" style="color: #1E2A78;">@ViewBag.SoBanBe</span>
            <span class="text-secondary">Bạn bè</span>
        </div>
    </div>
</div>

<!-- ===== TABS ===== -->
<div class="d-flex flex-wrap gap-2 bg-white p-2 rounded-3 shadow-sm my-4">
    <button class="flex-fill btn btn-outline-primary rounded-pill py-2 active" onclick="switchTab('posts')">
        <i class="fa-regular fa-newspaper me-2"></i>Bài viết
    </button>
    <button class="flex-fill btn btn-outline-primary rounded-pill py-2" onclick="switchTab('photos')">
        <i class="fa-regular fa-images me-2"></i>Ảnh
    </button>
    <button class="flex-fill btn btn-outline-primary rounded-pill py-2" onclick="switchTab('friends')">
        <i class="fa-solid fa-user-group"></i> Bạn bè
    </button>
</div>

<!-- ===== CONTENT ===== -->
<div class="tab-content">
    <!-- Tab Bài viết -->
    <div id="posts-tab" class="tab-pane active">
        <!-- Form đăng bài -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form action="/Baiviet/Taobaiviet" method="post" enctype="multipart/form-data" id="postForm">
                    <div class="d-flex gap-3">
                        <img src="@avatarImage" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                        <textarea name="Noidung"
                                  class="form-control rounded-3" 
                                  rows="2"
                                  placeholder="Bạn đang nghĩ gì, @Model.Ten?"
                                  id="postContent"
                                  ></textarea>
                    </div>

                    <!-- Preview ảnh -->
                    <div id="imagePreviewArea" class="mt-3 position-relative" style="display: none;">
                        <img id="imagePreview" class="img-fluid rounded-3" style="max-height: 300px; width: 100%; object-fit: contain;" />
                        <button type="button" class="position-absolute top-0 end-0 m-2 btn btn-dark btn-sm rounded-circle"
                                onclick="removeImage()">
                            <i class="fa-regular fa-xmark"></i>
                        </button>
                    </div>

                    <!-- Toolbar -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div class="d-flex gap-2">
                            <label for="postImage" class="btn btn-outline-secondary rounded-pill">
                                <i class="fa-regular fa-image me-2"></i>Ảnh
                            </label>
                            <input type="file" name="AnhFile" id="postImage" class="d-none" accept="image/*" onchange="previewPostImage(this)" />

                            <button type="button" class="btn btn-outline-secondary rounded-pill" onclick="openEmojiPicker()">
                                <i class="fa-regular fa-face-smile me-2"></i>Cảm xúc
                            </button>
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitPostBtn" disabled>
                            <i class="fa-regular fa-paper-plane me-2"></i>Đăng
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Danh sách bài viết -->
        @if (ViewBag.Baiviets.Count == 0)
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="fa-regular fa-newspaper fa-4x text-secondary mb-3"></i>
                <h4 class="fw-bold">Chưa có bài viết nào</h4>
                <p class="text-secondary">Hãy là người đầu tiên viết bài!</p>
            </div>
        }
        else
        {
            @foreach (var bv in ViewBag.Baiviets)
            {
                <div class="card border-0 shadow-sm mb-3" id="post-@bv.Id">
                    <div class="card-body">
                        <!-- Header bài viết -->
                        <div class="d-flex align-items-center mb-3">
                            <img src="@avatarImage" class="rounded-circle me-2" style="width: 48px; height: 48px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <h5 class="mb-0 fw-bold">@Model.Ten</h5>
                                <small class="text-secondary">
                                    <i class="fa-regular fa-clock me-1"></i>@bv.Ngaydang.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <button class="btn btn-light btn-sm rounded-circle">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                        </div>

                        <!-- Nội dung bài viết -->
                        <p class="mb-3">@bv.Noidung</p>

                        <!-- Ảnh bài viết - TẤT CẢ ĐỒNG NHẤT -->
                        @if (!string.IsNullOrEmpty(bv.Anh))
                        {
                            <div class="mb-3 text-center bg-light rounded-3 p-2">
                                <img src="/baiviet/@bv.Anh"
                                     class="img-fluid rounded-3"
                                     style="max-height: 400px; width: 100%; object-fit: contain;" />
                            </div>
                        }

                        <!-- Stats - SỐ LƯỢNG BÌNH LUẬN BÊN PHẢI -->
                        <div class="d-flex justify-content-between text-secondary small py-2 border-top border-bottom">
                            <div>
                                <i class="fa-regular fa-heart me-1" style="color: #FF4D6D;"></i>
                                <span id="total-like-@bv.Id">@bv.Thichs.Count</span>
                            </div>
                            <div>
                                <span id="total-comment-@bv.Id">@(bv.Binhluans?.Count ?? 0)</span> bình luận
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 mt-2">
                            <button onclick="thichBaiViet(@bv.Id)"
                                    class="btn flex-fill @(ViewBag.Thichs.Contains(bv.Id) ? "btn-primary" : "btn-light") rounded-pill"
                                    id="like-btn-@bv.Id">
                                <i class="fa-regular fa-thumbs-up me-2"></i>
                                Thích <span id="like-count-@bv.Id">@bv.Thichs.Count</span>
                            </button>

                            <a href="/Baiviet/ChiTiet/@bv.Id" class="btn btn-light flex-fill rounded-pill">
                                <i class="fa-regular fa-comment me-2"></i>
                                Bình luận
                            </a>

                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Tab Ảnh -->
    <div id="photos-tab" class="tab-pane">
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-regular fa-images fa-4x text-secondary mb-3"></i>
            <h4 class="fw-bold">Chưa có ảnh nào</h4>
            <p class="text-secondary">Ảnh từ bài viết sẽ hiển thị ở đây</p>
        </div>
    </div>

    <!-- Tab Bạn bè -->
    <div id="friends-tab" class="tab-pane">
        @if (ViewBag.DanhSachBanBe != null && ViewBag.DanhSachBanBe.Count > 0)
        {
            <div class="row g-3">
                @foreach (var ban in ViewBag.DanhSachBanBe)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body d-flex align-items-center gap-3">
                                <!-- Avatar -->
                                <img src="/images/default.png"
                                     class="rounded-circle"
                                     style="width: 60px; height: 60px; object-fit: cover;" />

                                <!-- Thông tin -->
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">@ban.Ten</h6>
                                    <small class="text-secondary">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        Kết bạn từ
                                        @if (ViewBag.NgayKetBan != null && ViewBag.NgayKetBan.ContainsKey(ban.ID))
                                        {
                                            @ViewBag.NgayKetBan[ban.ID].ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span>Không xác định</span>
                                        }
                                    </small>
                                </div>

                                <!-- Nút nhắn tin -->
                                <a href="/Chat/ChatVoi?userId=@Model.ID" class="btn btn-outline-primary rounded-circle">
                                    <i class="fa-regular fa-message"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="fa-solid fa-user-group fa-4x text-secondary mb-3"></i>

                <h4 class="fw-bold">Chưa có bạn bè</h4>
                <p class="text-secondary">Hãy kết bạn để bắt đầu kết nối</p>
            </div>
        }
    </div>
</div>
</div>
<!-- POPUP XÁC NHẬN HUỶ KẾT BẠN -->
<div class="modal fade" id="confirmHuyKetBanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <!-- Icon cảnh báo -->
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3">
                        <i class="fa-regular fa-user-slash fa-3x text-danger"></i>
                    </div>
                </div>

                <!-- Tiêu đề -->
                <h5 class="fw-bold mb-2">Huỷ kết bạn?</h5>

                <!-- Nội dung -->
                <p class="text-secondary mb-4" id="confirmMessage">
                    Bạn có chắc muốn huỷ kết bạn với người này?
                </p>

                <!-- Nút hành động -->
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="fa-regular fa-xmark me-2"></i>Không
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmHuyKetBanBtn">
                        <i class="fa-regular fa-check me-2"></i>Huỷ kết bạn
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- JavaScript -->
<script>
    // Kiểm tra nội dung đăng bài
    function checkPostContent() {
        const content = document.getElementById('postContent').value.trim();
        const hasImage = document.getElementById('postImage').files.length > 0;
        const submitBtn = document.getElementById('submitPostBtn');

        submitBtn.disabled = !(content || hasImage);
    }

    document.getElementById('postContent').addEventListener('input', checkPostContent);

    // Preview ảnh
    function previewPostImage(input) {
        const preview = document.getElementById('imagePreview');
        const previewArea = document.getElementById('imagePreviewArea');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function(e) {
                preview.src = e.target.result;
                previewArea.style.display = 'block';
            }

            reader.readAsDataURL(input.files[0]);
        }
        checkPostContent();
    }

    function removeImage() {
        const input = document.getElementById('postImage');
        const previewArea = document.getElementById('imagePreviewArea');

        input.value = '';
        previewArea.style.display = 'none';
        checkPostContent();
    }

    // Switch tabs
    function switchTab(tabName) {
        // Update tab buttons
        document.querySelectorAll('.tab-pane').forEach(tab => tab.classList.remove('active', 'show'));
        document.getElementById(tabName + '-tab').classList.add('active', 'show');

        // Update nav buttons
        document.querySelectorAll('.btn-outline-primary').forEach(btn => {
            btn.classList.remove('active', 'btn-primary');
            btn.classList.add('btn-outline-primary');
        });
        event.target.closest('.btn').classList.remove('btn-outline-primary');
        event.target.closest('.btn').classList.add('active', 'btn-primary');
    }

    // Like function - CẬP NHẬT CẢ 2 CHỖ
    function thichBaiViet(id) {
        fetch("/Baiviet/ThichBaiViet?baiVietId=" + id, {
            method: "POST",
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            // Cập nhật số like ở nút
            document.getElementById("like-count-" + id).innerText = data.soLuong;

            // Cập nhật số like ở stats trên cùng
            document.getElementById("total-like-" + id).innerText = data.soLuong;

            // Đổi màu nút like
            var btn = document.getElementById("like-btn-" + id);
            if (data.daThich) {
                btn.classList.remove("btn-light");
                btn.classList.add("btn-primary");
            } else {
                btn.classList.remove("btn-primary");
                btn.classList.add("btn-light");
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }

    function openEmojiPicker() {
        alert('Tính năng đang phát triển');
    }

        // Sửa lại hàm guiLoiMoiKetBan (bỏ alert)
    function guiLoiMoiKetBan(nguoiNhanId) {
        fetch('/User/GuiLoiMoiKetBan', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'nguoiNhanId=' + nguoiNhanId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                var btn = document.getElementById('btnKetBan-' + nguoiNhanId);

                var newBtn = document.createElement('button');
                newBtn.className = 'btn btn-warning rounded-pill px-4';
                newBtn.id = 'btnKetBan-' + nguoiNhanId;
                newBtn.setAttribute('onclick', 'huyLoiMoiKetBan(' + nguoiNhanId + ')');
                newBtn.innerHTML = '<i class="fa-regular fa-clock me-2"></i>Đã gửi lời mời';

                btn.parentNode.replaceChild(newBtn, btn);

                // Cập nhật thông báo
                if (typeof capNhatThongBao === 'function') {
                    capNhatThongBao();
                }
            } else {
                console.error('Lỗi gửi lời mời:', data.message);
            }
        })
        .catch(error => {
            console.error('Lỗi kết nối:', error);
        });
    }

    // Sửa lại hàm huyLoiMoiKetBan (bỏ alert)
    function huyLoiMoiKetBan(nguoiNhanId) {
        fetch('/User/HuyLoiMoiKetBan', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'nguoiNhanId=' + nguoiNhanId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                var btn = document.getElementById('btnKetBan-' + nguoiNhanId);

                var newBtn = document.createElement('button');
                newBtn.className = 'btn btn-primary rounded-pill px-4';
                newBtn.id = 'btnKetBan-' + nguoiNhanId;
                newBtn.setAttribute('onclick', 'guiLoiMoiKetBan(' + nguoiNhanId + ')');
                newBtn.innerHTML = '<i class="fa-regular fa-user-plus me-2"></i>Kết bạn';

                btn.parentNode.replaceChild(newBtn, btn);

                // Cập nhật thông báo
                if (typeof capNhatThongBao === 'function') {
                    capNhatThongBao();
                }
            } else {
                console.error('Lỗi huỷ lời mời:', data.message);
            }
        })
        .catch(error => {
            console.error('Lỗi kết nối:', error);
        });
    }
    // Biến lưu ID tạm thời
    var banIdToDelete = 0;

    function huyKetBan(banId) {
        // Lưu ID vào biến tạm
        banIdToDelete = banId;

        // Hiện popup xác nhận
        var myModal = new bootstrap.Modal(document.getElementById('confirmHuyKetBanModal'));
        myModal.show();
    }

    // Xử lý khi click nút "Huỷ kết bạn" trong popup
    document.getElementById('confirmHuyKetBanBtn').addEventListener('click', function() {
        // Ẩn popup
        var modal = bootstrap.Modal.getInstance(document.getElementById('confirmHuyKetBanModal'));
        modal.hide();

        // Gửi request huỷ kết bạn
        fetch('/User/HuyKetBan', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'banId=' + banIdToDelete
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Tìm dropdown và thay thế bằng nút "Kết bạn"
                var dropdownDiv = document.querySelector('.dropdown');
                var newBtn = document.createElement('button');
                newBtn.className = 'btn btn-primary rounded-pill px-4';
                newBtn.id = 'btnKetBan-' + banIdToDelete;
                newBtn.setAttribute('onclick', 'guiLoiMoiKetBan(' + banIdToDelete + ')');
                newBtn.innerHTML = '<i class="fa-regular fa-user-plus me-2"></i>Kết bạn';

                dropdownDiv.parentNode.replaceChild(newBtn, dropdownDiv);
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra');
        });
    });
</script>

<!-- Style bổ sung cho ảnh bài viết -->
<style>
    /* Đảm bảo ảnh bài viết hiển thị đẹp và đồng nhất */
    .card img[src^="/baiviet/"] {
        transition: transform 0.2s;
    }

        .card img[src^="/baiviet/"]:hover {
            transform: scale(1.02);
            cursor: pointer;
        }

    /* Shadow nhẹ cho card */
    .card {
        transition: box-shadow 0.2s;
    }

    .card:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
    }

    .avatar-wrapper {
        bottom: -40px;
        left: 20px;
        z-index: 10;
    }

    .avatar-img {
        width: 90px;
        height: 90px;
        object-fit: cover;
    }

    @@media (min-width: 768px) {
        .avatar-wrapper {
            bottom: -60px;
            left: 40px;
        }

        .avatar-img {
            width: 150px;
            height: 150px;
        }
    }

    .cover-img {
        height: 200px;
        object-fit: cover;
    }

    @@media (min-width: 768px) {
        .cover-img {
            height: 350px;
        }
    }
</style>