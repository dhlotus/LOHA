            modal.hide();
        
            if (data.success) {
                alert('Đã gửi báo cáo. Cảm ơn bạn!');
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra');
        });
    });
</script>

