<!--BÙI ĐỨC HÀ - LOTUS -->
@model LOHA.Models.User

@{

    Layout = "_Layout";
    // Kiểm tra ảnh bìa mặc định
    string coverImage = !string.IsNullOrEmpty(Model.AnhNen)
     ? Model.AnhNen
     : "/images/cover.jpg";

    string avatarImage = !string.IsNullOrEmpty(Model.Avatar)
        ? Model.Avatar
        : "/images/default.png";

}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<!-- ===== COVER & AVATAR ===== -->
<div class="position-relative">
    
    <!-- ẢNH BÌA + ICON CAMERA -->
    <div class="position-relative">
        <img id="coverImg" src="@coverImage"
             class="img-fluid w-100 rounded-4"
             style="height: 200px; object-fit: cover;" />
        
        <!-- Icon camera cho ảnh bìa (chỉ hiện khi là chủ trang) -->
        @if (ViewBag.CurrentUserId == Model.ID)
        {
            <label for="uploadCover"
                   class="shadow"
                   style="position: absolute; bottom: 10px; right: 10px; background: white; border-radius: 50%; padding: 8px; cursor: pointer; z-index: 5;">
                <i class="fa-solid fa-camera"></i>
            </label>
            <input type="file" id="uploadCover" class="d-none" accept="image/*" />
        }
    </div>

    <!-- AVATAR + ICON CAMERA -->
    <div class="position-absolute" style="bottom: -40px; left: 20px; z-index: 10;">
        <div class="position-relative">
            <img id="avatarImg" src="@avatarImage"
                 class="rounded-circle border border-4 border-white shadow"
                 style="width: 90px; height: 90px; object-fit: cover;" />
            
            <!-- Icon camera cho avatar (chỉ hiện khi là chủ trang) -->
            @if (ViewBag.CurrentUserId == Model.ID)
            {
                <label for="uploadAvatar"
                       class="shadow"
                       style="position: absolute; bottom: 0; right: 0; background: white; border-radius: 50%; padding: 5px; cursor: pointer; z-index: 5;">
                    <i class="fa-solid fa-camera" style="font-size: 12px;"></i>
                </label>
                <input type="file" id="uploadAvatar" class="d-none" accept="image/*" />
            }
        </div>
    </div>

</div>

    <!-- ===== PROFILE INFO ===== -->
    <div class="mt-5 pt-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="fw-bold display-6 display-md-5" style="color: #1E2A78;">@Model.Ten</h1>
            </div>

        <!-- NÚT KẾT BẠN + BÁO CÁO -->
        @if (ViewBag.CurrentUserId != Model.ID)
        {
            <div class="d-flex gap-2">
                @if (ViewBag.DaLaBanBe)
                {
                    // Lấy nhóm mà người dùng hiện tại đã xếp cho người này
                    var nhomHienTai = ViewBag.NhomCuaToi ?? "Bạn bè";
    
                    <!-- Nút dropdown hiển thị tên nhóm + mũi tên -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary rounded-pill px-4 dropdown-toggle"
                                type="button"
                                id="dropdownNhom-@Model.ID"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="border-color: #E5E7EB; color: #1E2A78;">
                            <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">
                                @(nhomHienTai == "Gia đình" ? "family_restroom" :
                                  nhomHienTai == "Đồng nghiệp" ? "work" :
                                  nhomHienTai == "Khác" ? "more_horiz" : "people")
                            </span>
                            @nhomHienTai
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownNhom-@Model.ID">
                            <li>
                                <a class="dropdown-item text-danger" href="#" onclick="huyKetBan(@Model.ID); return false;">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; font-size: 18px;">person_remove</span>
                                    Huỷ kết bạn
                                </a>
                            </li>
                        </ul>
                    </div>
        
                    <!-- Nút Nhắn tin -->
                    <a href="/Chat/ChatVoi?userId=@Model.ID"
                           class="btn btn-primary rounded-pill px-4"
                           style="background: linear-gradient(135deg, #1E2A78, #6C63FF); border: none;">
                        <span class="material-icons-outlined me-1" style="vertical-align: middle;">chat_bubble</span>
                        Nhắn tin
                    </a>
                }
                else if (ViewBag.DaGuiLoiMoi)
                {
                    <button onclick="huyLoiMoiKetBan(@Model.ID)"
                            class="btn btn-secondary rounded-pill px-4"
                            id="btnKetBan-@Model.ID"
                            style="background: #E5E7EB; color: #6B7280; border: none;">
                        <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">schedule</span>
                        Đã gửi lời mời
                    </button>
                }
                else
                {
                    <button onclick="moPopupChonNhom(@Model.ID, '@Model.Ten')"
                            class="btn btn-primary rounded-pill px-4"
                            id="btnKetBan-@Model.ID"
                            style="background: linear-gradient(135deg, #1E2A78, #6C63FF); border: none;">
                        <span class="material-icons-outlined me-1" style="vertical-align: middle;">person_add</span>
                        Kết bạn
                    </button>
                }
        
                @* ===== NÚT 3 CHẤM - BÁO CÁO ===== *@
                <div class="dropdown">
                    <button class="btn btn-outline-secondary rounded-circle"
                            type="button"
                            id="dropdownMenuUser-@Model.ID"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="width: 42px; height: 42px; border-color: #E5E7EB;">
                        <i class="fa-solid fa-ellipsis"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuUser-@Model.ID">
                        <li>
                            <a class="dropdown-item text-warning" href="#" onclick="moPopupBaoCaoNguoiDung(@Model.ID, '@Model.Ten'); return false;">
                                <span class="material-icons-outlined me-2" style="vertical-align: middle; font-size: 18px;">flag</span>
                                Báo cáo người dùng
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        }

    </div>
    <!-- Stats -->
    <div class="d-flex flex-wrap gap-3 mt-3">
        <div class="text-center">
            <span class="d-block fw-bold fs-3" style="color: #1E2A78;">@ViewBag.Baiviets.Count</span>
            <span class="text-secondary small">Bài viết</span>
        </div>
        <div class="text-center">
            <span class="d-block fw-bold fs-3" style="color: #1E2A78;">@ViewBag.SoBanBe</span>
            <span class="text-secondary small">Bạn bè</span>
        </div>
    </div>
    <!-- ===== TABS ===== -->
    <ul class="nav nav-tabs profile-tabs mt-4" id="profileTab" role="tablist">
        <li class="nav-item flex-fill" role="presentation">
            <button class="nav-link active w-100" id="posts-tab-btn" data-bs-toggle="tab" data-bs-target="#posts" type="button" role="tab">
                <i class="fa-regular fa-newspaper me-2"></i>Bài viết
            </button>
        </li>
        <li class="nav-item flex-fill" role="presentation">
            <button class="nav-link w-100" id="photos-tab-btn" data-bs-toggle="tab" data-bs-target="#photos" type="button" role="tab">
                <i class="fa-regular fa-images me-2"></i>Ảnh
            </button>
        </li>
        @* Chỉ hiển thị tab Bạn bè khi đang xem trang cá nhân của CHÍNH MÌNH *@
        @if (ViewBag.CurrentUserId == Model.ID)
        {
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100" id="friends-tab-btn" data-bs-toggle="tab" data-bs-target="#friends" type="button" role="tab">
                    <i class="fa-solid fa-user-group me-2"></i>Bạn bè
                </button>
            </li>
        }
    </ul>

    <!-- ===== CONTENT ===== -->
    <div class="tab-content mt-3">
        <!-- Tab Bài viết -->
        <div class="tab-pane fade show active" id="posts" role="tabpanel">
            <!-- Form đăng bài -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <form action="/Baiviet/Taobaiviet" method="post" enctype="multipart/form-data" id="postForm">
                        <div class="d-flex gap-3">
                            <img src="@avatarImage" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                            <textarea name="Noidung"
                                      class="form-control rounded-3"
                                      rows="2"
                                      placeholder="Bạn đang nghĩ gì, @Model.Ten?"
                                      id="postContent"
                                      style="resize: none;"></textarea>
                        </div>

                        <!-- Preview ảnh -->
                        <div id="imagePreviewArea" class="mt-3 position-relative" style="display: none;">
                            <img id="imagePreview" class="img-fluid rounded-3" style="max-height: 300px; width: 100%; object-fit: contain;" />
                            <button type="button" class="position-absolute top-0 end-0 m-2 btn btn-dark btn-sm rounded-circle"
                                    onclick="removeImage()">
                                <i class="fa-regular fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Toolbar -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <div class="d-flex gap-2">
                                <label for="postImage" class="btn btn-outline-secondary rounded-pill">
                                    <i class="fa-regular fa-image me-2"></i>Ảnh
                                </label>
                                <input type="file" name="AnhFile" id="postImage" class="d-none" accept="image/*" onchange="previewPostImage(this)" />
                                <button type="button" class="btn btn-outline-secondary rounded-pill" onclick="openEmojiPicker()">
                                    <i class="fa-regular fa-face-smile me-2"></i>Cảm xúc
                                </button>
                            </div>
                            <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitPostBtn" disabled>
                                <i class="fa-regular fa-paper-plane me-2"></i>Đăng
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Danh sách bài viết -->
            @if (ViewBag.Baiviets.Count == 0)
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class="fa-regular fa-newspaper fa-4x text-secondary mb-3"></i>
                    <h4 class="fw-bold">Chưa có bài viết nào</h4>
                    <p class="text-secondary">Hãy là người đầu tiên viết bài!</p>
                </div>
            }
            else
            {
                var danhSachBaiViet = ViewBag.Baiviets as List<LOHA.Models.Baiviet>;
                @foreach (var bv in danhSachBaiViet)
                {
                    @await Html.PartialAsync("/Views/Baiviet/Baidang.cshtml", bv)
                }
            }
        </div>

        <!-- Tab Ảnh -->
        <div class="tab-pane fade" id="photos" role="tabpanel">
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="fa-regular fa-images fa-4x text-secondary mb-3"></i>
                <h4 class="fw-bold">Chưa có ảnh nào</h4>
                <p class="text-secondary">Ảnh từ bài viết sẽ hiển thị ở đây</p>
            </div>
        </div>

        <!-- Tab Bạn bè -->
        @* Chỉ hiển thị nội dung Tab Bạn bè khi đang xem trang cá nhân của CHÍNH MÌNH *@
        @if (ViewBag.CurrentUserId == Model.ID)
        {
            <div class="tab-pane fade" id="friends" role="tabpanel">
    
                <!-- ===== DROPDOWN LỌC NHÓM ===== -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: #1E2A78;">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle;">people</span>
                        Bạn bè
                    </h5>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary rounded-pill px-4 dropdown-toggle"
                                type="button"
                                id="dropdownLocNhom"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="border-color: #E5E7EB; color: #1E2A78;">
                            <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">filter_list</span>
                            @{
                                string nhomDangChon = ViewBag.NhomDangChon ?? "TatCa";
                                string tenHienThi = nhomDangChon == "TatCa" ? "Tất cả" : nhomDangChon;
                            }
                            @tenHienThi
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownLocNhom">
                            <li>
                                <a class="dropdown-item @(ViewBag.NhomDangChon == null || ViewBag.NhomDangChon == "TatCa" ? "active" : "")"
                                       href="?nhom=TatCa#friends">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle;">people</span>
                                    Tất cả
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewBag.NhomDangChon == "Bạn bè" ? "active" : "")"
                                       href="?nhom=Bạn bè#friends">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6C63FF;">people</span>
                                    Bạn bè
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewBag.NhomDangChon == "Gia đình" ? "active" : "")"
                                       href="?nhom=Gia đình#friends">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #FF6B6B;">family_restroom</span>
                                    Gia đình
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewBag.NhomDangChon == "Đồng nghiệp" ? "active" : "")"
                                       href="?nhom=Đồng nghiệp#friends">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #4ECDC4;">work</span>
                                    Đồng nghiệp
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(ViewBag.NhomDangChon == "Khác" ? "active" : "")"
                                       href="?nhom=Khác#friends">
                                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #9CA3AF;">more_horiz</span>
                                    Khác
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
    
                <!-- Danh sách bạn bè -->
                @if (ViewBag.DanhSachBanBe != null && ViewBag.DanhSachBanBe.Count > 0)
                {
                    <div class="row g-3">
                        @foreach (var ban in ViewBag.DanhSachBanBe)
                        {
                            string nhom = ViewBag.NhomCuaBan?[ban.ID] ?? "Bạn bè";
                            string iconNhom = nhom == "Gia đình" ? "family_restroom" :
                                             nhom == "Đồng nghiệp" ? "work" :
                                             nhom == "Khác" ? "more_horiz" : "people";
    
                            // Lấy avatar của bạn
                            string avatarBan = string.IsNullOrEmpty(ban.Avatar) ? "/images/default.png" : ban.Avatar;

                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body d-flex align-items-center gap-3 py-3">
                                        <!-- Avatar -->
                                        <img src="@avatarBan"
                                             class="rounded-circle"
                                             style="width: 50px; height: 50px; object-fit: cover;" />
            
                                        <!-- Tên và nhóm -->
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold mb-1">@ban.Ten</h6>
                                            <small class="text-secondary">
                                                <span class="material-icons-outlined" style="font-size: 14px; vertical-align: middle;">@iconNhom</span>
                                                @nhom
                                            </small>
                                        </div>
            
                                        <!-- Nút Nhắn tin -->
                                        <a href="/Chat/ChatVoi?userId=@ban.ID"
                                               class="btn btn-outline-primary rounded-pill px-4">
                                            <span class="material-icons-outlined me-1" style="vertical-align: middle;">chat_bubble</span>
                                            Nhắn tin
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                        <span class="material-icons-outlined" style="font-size: 48px; color: #9CA3AF;">people_outline</span>
                        <h4 class="fw-bold mt-3">Chưa có bạn bè</h4>
                        <p class="text-secondary">Hãy kết bạn để bắt đầu kết nối</p>
                    </div>
                }
            </div>
        }
        
    </div>
</div>

<!-- POPUP XÁC NHẬN HUỶ KẾT BẠN -->
<div class="modal fade" id="confirmHuyKetBanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3">
                        <i class="fa-regular fa-user-slash fa-3x text-danger"></i>
                    </div>
                </div>
                <h5 class="fw-bold mb-2">Huỷ kết bạn?</h5>
                <p class="text-secondary mb-4" id="confirmMessage">
                    Bạn có chắc muốn huỷ kết bạn với người này?
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="fa-regular fa-xmark me-2"></i>Không
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmHuyKetBanBtn">
                        <i class="fa-regular fa-check me-2"></i>Huỷ kết bạn
                    </button>
                </div>
            </div>
        </div>
    </div>
    
</div>
<!-- ===== POPUP CHỌN NHÓM KHI GỬI LỜI MỜI ===== -->
<div class="modal fade" id="chonNhomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #1E2A78;">
                    <span class="material-icons-outlined me-2" style="vertical-align: middle;">person_add</span>
                    Gửi lời mời kết bạn
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-secondary mb-3" id="tenNguoiNhanPopup">Thêm <strong></strong> vào nhóm:</p>
                
                <div class="d-flex flex-column gap-2">
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="nhom" value="Bạn bè" class="form-check-input me-2" checked>
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6C63FF;">people</span>
                        <strong>Bạn bè</strong>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="nhom" value="Gia đình" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #FF6B6B;">family_restroom</span>
                        <strong>Gia đình</strong>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="nhom" value="Đồng nghiệp" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #4ECDC4;">work</span>
                        <strong>Đồng nghiệp</strong>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="nhom" value="Khác" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #9CA3AF;">more_horiz</span>
                        <strong>Khác</strong>
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="xacNhanGuiLoiMoi"
                        style="background: linear-gradient(135deg, #1E2A78, #6C63FF); border: none;">
                    <span class="material-icons-outlined me-1" style="vertical-align: middle; font-size: 18px;">send</span>
                    Gửi lời mời
                </button>
            </div>
        </div>
    </div>
</div>
<!-- ===== POPUP BÁO CÁO NGƯỜI DÙNG ===== -->
<div class="modal fade" id="baoCaoNguoiDungModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: #1E2A78;">
                    <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">flag</span>
                    Báo cáo người dùng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-secondary mb-3" id="tenNguoiBiBaoCao">Báo cáo <strong></strong> với lý do:</p>
                
                <div class="d-flex flex-column gap-2">
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDoNguoiDung" value="Giả mạo" class="form-check-input me-2" checked>
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #EF4444;">person_off</span>
                        <strong>Giả mạo</strong>
                        <small class="d-block text-secondary ms-4">Tài khoản giả mạo người khác</small>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDoNguoiDung" value="Quấy rối" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #F59E0B;">warning</span>
                        <strong>Quấy rối</strong>
                        <small class="d-block text-secondary ms-4">Nhắn tin hoặc bình luận quấy rối</small>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
                        <input type="radio" name="lyDoNguoiDung" value="Spam" class="form-check-input me-2">
                        <span class="material-icons-outlined me-2" style="vertical-align: middle; color: #6C63FF;">mail</span>
                        <strong>Spam</strong>
                        <small class="d-block text-secondary ms-4">Đăng bài hoặc gửi tin nhắn spam</small>
                    </label>
                    
                    <label class="form-check-label p-3 border rounded-3" style="cursor: pointer;">
