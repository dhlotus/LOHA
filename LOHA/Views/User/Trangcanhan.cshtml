        // Toggle bình luận (hiện/ẩn khu vực bình luận)
    function moBinhLuan(baivietId, btn) {
        var commentSection = document.getElementById('comment-section-' + baivietId);

        if (commentSection.style.display === 'none' || commentSection.style.display === '') {
            commentSection.style.display = 'block';
            btn.innerHTML = '<i class="fa-regular fa-comment-dots me-2"></i><span>Ẩn bình luận</span>';

            // Focus vào ô input
            setTimeout(function() {
                var input = document.getElementById('comment-input-' + baivietId);
                if (input) input.focus();
            }, 100);
        } else {
            commentSection.style.display = 'none';
            btn.innerHTML = '<i class="fa-regular fa-comment me-2"></i><span>Bình luận</span>';
        }
    }

    // Gửi bình luận
    function guiBinhLuan(baivietId, inputId) {
        var input = document.getElementById(inputId);
        var noidung = input.value.trim();

        if (noidung === '') {
            // Không alert, chỉ focus lại
            input.focus();
            return;
        }

        fetch('/Baiviet/ThemBinhLuan', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'baivietId=' + baivietId + '&noidung=' + encodeURIComponent(noidung) + '&anchor='
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Thêm bình luận mới vào đầu danh sách
                var commentList = document.getElementById('comment-list-' + baivietId);
                commentList.insertAdjacentHTML('afterbegin', data.html);

                // Xóa input
                input.value = '';

                // Cập nhật số lượng bình luận
                var commentCount = document.getElementById('comment-count-' + baivietId);
                if (commentCount) commentCount.innerText = data.soLuong;

                // Cập nhật số bình luận ở stats (nếu có)
                var totalComment = document.getElementById('total-comment-' + baivietId);
                if (totalComment) totalComment.innerText = data.soLuong;

                // Hiệu ứng cho bình luận mới
                var newComment = commentList.firstElementChild;
                if (newComment) newComment.style.animation = 'fadeInUp 0.3s ease-out';
            } else {
                console.error('Lỗi:', data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }
