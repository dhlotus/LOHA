@{
    ViewData["Title"] = "Bạn bè";
    Layout = "_Layout";
    var danhSachBanBe = ViewBag.DanhSachBanBe as List<LOHA.Models.User>;
    var currentUserId = ViewBag.CurrentUserId as int?;
    
    // Phân loại bạn bè (demo - sau này lấy từ database)
    // Giả lập dữ liệu phân loại để demo giao diện
}

<!-- ===== CSS NÂNG CẤP CHO TRANG BẠN BÈ ===== -->
<style>
    /* Container chính - Nền trắng sữa */
    .banbe-container {
        max-width: 900px;
        background-color: #FCFAFF; /* Tím sữa cực nhạt */
    }

    /* ===== HEADER & SEARCH ===== */
    .banbe-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding: 16px 4px 0;
    }

    .banbe-title-section {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

        .banbe-title-section h2 {
            font-size: 32px;
            font-weight: 700;
            margin: 0;
            background: linear-gradient(135deg, #2D1B69 0%, #1F1147 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
        }

    .banbe-network-badge {
        background: #F3F0FF;
        padding: 6px 16px;
        border-radius: 40px;
        border: 1px solid rgba(109, 93, 252, 0.12);
    }

    .network-text {
        font-size: 14px;
        font-weight: 500;
        color: var(--loha-primary);
    }

    /* ===== CARD BẠN BÈ (NGANG) ===== */
    .banbe-card {
        border-radius: 24px !important;
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 10px 30px -5px rgba(109, 93, 252, 0.05) !important;
        border: none !important;
        padding: 12px 16px !important;
        margin-bottom: 16px;
    }

        .banbe-card:hover {
            transform: translateY(-5px) !important;
            box-shadow: 0 25px 40px -10px rgba(109, 93, 252, 0.12) !important;
        }

    /* Avatar Squircle */
    .banbe-avatar {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .banbe-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 22px; /* Squircle */
            box-shadow: 0 8px 20px rgba(109, 93, 252, 0.1);
            border: 2px solid white;
        }

    /* Thông tin */
    .banbe-info {
        flex: 1;
    }

    .banbe-name {
        color: #2D1B69;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.3px;
    }

    /* Tag phân loại */
    .relationship-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 8px;
    }

    /* Tag màu cho các nhóm */
    .tag-gia-dinh {
        background: #FFF3E0;
        color: #E65100;
    }

    .tag-dong-nghiep {
        background: #E3F2FD;
        color: #1565C0;
    }

    .tag-khac {
        background: #F5F5F5;
        color: #616161;
    }

    .tag-ban-be {
        background: #F3F0FF;
        color: #6D5DFC;
    }
    /* Nút hành động tròn */
    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #F8F7FF;
        color: #6D5DFC;
        border: none;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-icon-circle:hover {
            background: #6D5DFC;
            color: white;
            transform: scale(1.05);
            box-shadow: 0 6px 15px rgba(109, 93, 252, 0.2);
        }

    .btn-icon-outline {
        background: transparent;
        border: 1px solid #E9E7F5;
        color: #5E5A6E;
    }

        .btn-icon-outline:hover {
            background: #F8F7FF;
            border-color: #6D5DFC;
            color: #6D5DFC;
        }

    /* Responsive */
    @@media (max-width: 767px) {
        .banbe-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        
        .banbe-search {
            width: 100%;
        }
        
        .banbe-title-section h2 {
            font-size: 26px;
        }
        
        .banbe-avatar {
            width: 60px;
            height: 60px;
        }
        
            .banbe-avatar img {
                border-radius: 18px;
            }
        
        .btn-icon-circle {
            width: 40px;
            height: 40px;
        }
    }

    @@media (max-width: 480px) {
        .banbe-card .row {
            flex-direction: column !important;
        }
        
        .banbe-card .col-auto {
            margin-bottom: 12px;
        }
        
        .action-buttons {
            margin-top: 12px;
            justify-content: center;
        }
    }
</style>

<!-- ===== GIAO DIỆN CHÍNH ===== -->
<div class="container banbe-container">
    
    <!-- HEADER -->
    <div class="banbe-header">
        <div class="banbe-title-section">
            <h2>Bạn bè</h2>
            <span class="banbe-network-badge">
                <span class="network-text">🌐 Mạng lưới: @(danhSachBanBe?.Count ?? 0) kết nối</span>
            </span>
        </div>
    </div>

    <!-- DANH SÁCH BẠN BÈ -->
    @if (danhSachBanBe != null && danhSachBanBe.Count > 0)
    {
        <div class="row g-4" id="banbeListContainer">
            @foreach (var user in danhSachBanBe)
            {
                @await Html.PartialAsync("_BanBeCardPartial", user)
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-user-group fa-4x mb-3" style="color: #8A8A9E; opacity: 0.3;"></i>
            <h4 class="fw-bold" style="color: #2D1B69;">Chưa có bạn bè nào</h4>
            <p class="text-secondary">Hãy tìm kiếm và kết nối với mọi người!</p>
            <a href="/User/TimKiem" class="btn btn-lo-primary rounded-pill mt-3 px-4">
                <i class="fa-solid fa-magnifying-glass me-2"></i>Khám phá bạn bè
            </a>
        </div>
    }
</div>

<!-- ===== JAVASCRIPT ===== -->
<script>
    document.addEventListener('DOMContentLoaded', function() {

    function huyKetBan(banId) {
        if (!confirm('Bạn có chắc muốn hủy kết bạn?')) return;
    
        fetch('/User/HuyKetBan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'banId=' + banId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message);
            }
        });
    }
</script>