@model List<LOHA.Models.BaoCaoNguoiDung>
@{
    ViewData["Title"] = "Báo cáo người dùng";
    Layout = "_LayoutLotus";
}

<div class="lotus-dashboard">
    <div class="lotus-welcome mb-4">
        <h2><span class="material-icons-outlined me-2" style="vertical-align: middle;">person_off</span>Báo cáo người dùng</h2>
        <p class="text-white-50">Xem và xử lý các báo cáo người dùng</p>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="lotus-stat-card">
                <div class="lotus-stat-icon bg-warning">
                    <span class="material-icons-outlined">pending</span>
                </div>
                <div class="lotus-stat-info">
                    <h3>@Model.Count</h3>
                    <p>Báo cáo chờ xử lý</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách báo cáo -->
    @if (Model.Count == 0)
    {
        <div class="lotus-card">
            <div class="lotus-card-body text-center py-5">
                <span class="material-icons-outlined" style="font-size: 48px; color: #F59E0B;">check_circle</span>
                <h4 class="mt-3 text-white">Không có báo cáo nào</h4>
                <p class="text-white-50">Tất cả báo cáo đã được xử lý</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người báo cáo</th>
                        <th>Người bị báo cáo</th>
                        <th>Lý do</th>
                        <th>Thời gian</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bc in Model)
                    {
                        <tr id="baoCao-@bc.Id">
                            <td>#@bc.Id</td>
                            <td>@bc.NguoiBaoCao?.Ten</td>
                            <td>
                                <a href="#" onclick="xemTruocNguoiDung(@bc.NguoiBiBaoCaoId); return false;" class="text-info">
                                    @bc.NguoiBiBaoCao?.Ten
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-warning">@bc.LyDo</span>
                            </td>
                            <td>@bc.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success me-1" onclick="dongYBaoCao(@bc.Id, @bc.NguoiBiBaoCaoId)">
                                    <span class="material-icons-outlined" style="font-size: 16px;">check</span>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="tuChoiBaoCao(@bc.Id)">
                                    <span class="material-icons-outlined" style="font-size: 16px;">close</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Popup xem trước người dùng -->
<div class="modal fade" id="xemTruocUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">
                    <span class="material-icons-outlined me-2" style="vertical-align: middle;">person</span>
                    Thông tin người dùng
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="xemTruocUserContent">
                <div class="text-center py-3">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center">
                <span style="font-size: 16px; font-weight: 600; background: linear-gradient(135deg, #6D5DFC, #A86DFC); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: 1px;">✦ LOHA ✦</span>
                <a href="#" id="linkDenTrangCaNhan" target="_blank" style="display: none;"></a>
            </div>
        </div>
    </div>
</div>
<!-- Popup xác nhận xử lý báo cáo người dùng -->
<div class="modal fade" id="xacNhanBaoCaoUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3" id="modalIconWrapperUser">
                        <span class="material-icons-outlined" id="modalIconUser" style="font-size: 40px; color: #F59E0B;">help</span>
                    </div>
                </div>
                <h5 class="fw-bold mb-2" id="modalTitleUser">Xác nhận</h5>
                <p class="text-white-50 mb-4" id="modalMessageUser">Bạn có chắc muốn thực hiện hành động này?</p>
                <input type="hidden" id="actionTypeUser" />
                <input type="hidden" id="baoCaoIdUser" />
                <input type="hidden" id="userId" />
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <span class="material-icons-outlined me-1" style="font-size: 16px;">close</span>Hủy
                    </button>
                    <button type="button" class="btn btn-warning rounded-pill px-4" id="confirmActionBtnUser">
                        <span class="material-icons-outlined me-1" style="font-size: 16px;">check</span>Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
<script>
    // ===== TOAST FUNCTION =====
    function showToast(message, type = 'success') {
        let toastContainer = document.getElementById('toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'toast-container';
            toastContainer.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            document.body.appendChild(toastContainer);
        }
        
        const toast = document.createElement('div');
        toast.style.cssText = `
            background: ${type === 'success' ? '#10B981' : '#EF4444'};
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
            min-width: 280px;
        `;
        
        const icon = type === 'success' ? 'check_circle' : 'error_outline';
        toast.innerHTML = `
            <span class="material-icons-outlined">${icon}</span>
            <span style="flex: 1;">${message}</span>
            <button onclick="this.parentElement.remove()" style="background: none; border: none; color: white; cursor: pointer; opacity: 0.7; font-size: 18px;">×</button>
        `;
        
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    // Thêm animation CSS
    if (!document.getElementById('toast-animation-style')) {
        const style = document.createElement('style');
        style.id = 'toast-animation-style';
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        `;
        document.head.appendChild(style);
    }

    // ===== XEM TRƯỚC NGƯỜI DÙNG =====
    function xemTruocNguoiDung(userId) {
        var modal = new bootstrap.Modal(document.getElementById('xemTruocUserModal'));
        modal.show();
        
        var linkElement = document.getElementById('linkDenTrangCaNhan');
        if (linkElement) {
            linkElement.href = '/User/Trangcanhan?id=' + userId;
        }
        
        fetch('/Admin/BaoCaoNguoiDung/XemTruocNguoiDung?id=' + userId)
            .then(response => response.text())
            .then(html => {
                document.getElementById('xemTruocUserContent').innerHTML = html;
            })
            .catch(error => {
                document.getElementById('xemTruocUserContent').innerHTML = '<p class="text-danger">Lỗi tải thông tin</p>';
            });
    }

    // ===== MỞ POPUP XÁC NHẬN =====
    function moPopupXacNhanUser(type, baoCaoId, userId = 0) {
        document.getElementById('actionTypeUser').value = type;
        document.getElementById('baoCaoIdUser').value = baoCaoId;
        document.getElementById('userId').value = userId;
        
        const modalTitle = document.getElementById('modalTitleUser');
        const modalMessage = document.getElementById('modalMessageUser');
        const modalIcon = document.getElementById('modalIconUser');
        const modalIconWrapper = document.getElementById('modalIconWrapperUser');
        const confirmBtn = document.getElementById('confirmActionBtnUser');
        
        if (type === 'dongY') {
            modalTitle.innerText = 'Đồng ý báo cáo?';
            modalMessage.innerText = 'Đồng ý báo cáo sẽ KHÓA tài khoản này. Người dùng sẽ không thể đăng nhập. Bạn chắc chắn?';
            modalIcon.innerText = 'block';
            modalIcon.style.color = '#EF4444';
            modalIconWrapper.className = 'bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3';
            confirmBtn.className = 'btn btn-danger rounded-pill px-4';
            confirmBtn.innerHTML = '<span class="material-icons-outlined me-1" style="font-size: 16px;">block</span>Khóa tài khoản';
        } else {
            modalTitle.innerText = 'Từ chối báo cáo?';
            modalMessage.innerText = 'Báo cáo sẽ bị từ chối và chuyển sang trạng thái đã xử lý. Bạn chắc chắn?';
            modalIcon.innerText = 'close';
            modalIcon.style.color = '#F59E0B';
            modalIconWrapper.className = 'bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3';
            confirmBtn.className = 'btn btn-warning rounded-pill px-4';
            confirmBtn.innerHTML = '<span class="material-icons-outlined me-1" style="font-size: 16px;">close</span>Từ chối';
        }
        
        var modal = new bootstrap.Modal(document.getElementById('xacNhanBaoCaoUserModal'));
        modal.show();
    }

    // ===== XỬ LÝ XÁC NHẬN =====
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('confirmActionBtnUser').addEventListener('click', function() {
            const actionType = document.getElementById('actionTypeUser').value;
            const baoCaoId = document.getElementById('baoCaoIdUser').value;
            const userId = document.getElementById('userId').value;
            
            var modal = bootstrap.Modal.getInstance(document.getElementById('xacNhanBaoCaoUserModal'));
            modal.hide();
            
            if (actionType === 'dongY') {
                thucHienDongYBaoCaoUser(baoCaoId, userId);
            } else {
                thucHienTuChoiBaoCaoUser(baoCaoId);
            }
        });
    });

    // ===== THỰC HIỆN ĐỒNG Ý BÁO CÁO (KHÓA TÀI KHOẢN) =====
    function thucHienDongYBaoCaoUser(baoCaoId, userId) {
        fetch('/Admin/BaoCaoNguoiDung/DongYBaoCao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'baoCaoId=' + baoCaoId + '&userId=' + userId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('baoCao-' + baoCaoId).remove();
                showToast('Đã khóa tài khoản và xử lý báo cáo thành công!', 'success');
                
                if (document.querySelectorAll('tbody tr').length === 0) {
                    setTimeout(() => location.reload(), 1500);
                }
            } else {
                showToast(data.message || 'Có lỗi xảy ra', 'error');
            }
        })
        .catch(error => {
            showToast('Có lỗi xảy ra', 'error');
        });
    }

    // ===== THỰC HIỆN TỪ CHỐI BÁO CÁO =====
    function thucHienTuChoiBaoCaoUser(baoCaoId) {
        fetch('/Admin/BaoCaoNguoiDung/TuChoiBaoCao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'baoCaoId=' + baoCaoId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('baoCao-' + baoCaoId).remove();
                showToast('Đã từ chối báo cáo!', 'success');
                
                if (document.querySelectorAll('tbody tr').length === 0) {
                    setTimeout(() => location.reload(), 1500);
                }
            } else {
                showToast(data.message || 'Có lỗi xảy ra', 'error');
            }
        })
        .catch(error => {
            showToast('Có lỗi xảy ra', 'error');
        });
    }

    // ===== GỌI TỪ NÚT =====
    function dongYBaoCao(baoCaoId, userId) {
        moPopupXacNhanUser('dongY', baoCaoId, userId);
    }

    function tuChoiBaoCao(baoCaoId) {
        moPopupXacNhanUser('tuChoi', baoCaoId);
    }
</script>