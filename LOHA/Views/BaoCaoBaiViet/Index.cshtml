@model List<LOHA.Models.BaoCaoBaiViet>
@{
    ViewData["Title"] = "Báo cáo bài viết";
    Layout = "_LayoutLotus";
}

<div class="lotus-dashboard">
    <div class="lotus-welcome mb-4">
        <h2><span class="material-icons-outlined me-2" style="vertical-align: middle;">flag</span>Báo cáo bài viết</h2>
        <p class="text-white-50">Xem và xử lý các báo cáo bài viết từ người dùng</p>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="lotus-stat-card">
                <div class="lotus-stat-icon bg-warning">
                    <span class="material-icons-outlined">pending</span>
                </div>
                <div class="lotus-stat-info">
                    <h3>@Model.Count</h3>
                    <p>Báo cáo chờ xử lý</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách báo cáo -->
    @if (Model.Count == 0)
    {
        <div class="lotus-card">
            <div class="lotus-card-body text-center py-5">
                <span class="material-icons-outlined" style="font-size: 48px; color: #F59E0B;">check_circle</span>
                <h4 class="mt-3 text-white">Không có báo cáo nào</h4>
                <p class="text-white-50">Tất cả báo cáo đã được xử lý</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người báo cáo</th>
                        <th>Bài viết bị báo cáo</th>
                        <th>Người đăng</th>
                        <th>Lý do</th>
                        <th>Thời gian</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bc in Model)
                    {
                        <tr id="baoCao-@bc.Id">
                            <td>#@bc.Id</td>
                            <td>@bc.NguoiBaoCao?.Ten</td>
                            <td>
                                <a href="#" onclick="xemTruocBaiViet(@bc.BaiVietId); return false;" class="text-info">
                                    #@bc.BaiVietId
                                </a>
                            </td>
                            <td>@bc.BaiViet?.User?.Ten</td>
                            <td>
                                <span class="badge bg-warning">@bc.LyDo</span>
                            </td>
                            <td>@bc.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success me-1" onclick="dongYBaoCao(@bc.Id, @bc.BaiVietId)">
                                    <span class="material-icons-outlined" style="font-size: 16px;">check</span>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="tuChoiBaoCao(@bc.Id)">
                                    <span class="material-icons-outlined" style="font-size: 16px;">close</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Popup xem trước bài viết -->
<div class="modal fade" id="xemTruocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">
                    <span class="material-icons-outlined me-2" style="vertical-align: middle;">visibility</span>
                    Xem trước bài viết
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="xemTruocContent">
                <div class="text-center py-3">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center">
                <span style="font-size: 16px; font-weight: 600; background: linear-gradient(135deg, #6D5DFC, #A86DFC); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: 1px;">✦ LOHA ✦</span>
            </div>
        </div>
    </div>
</div>
<!-- Popup xác nhận xử lý báo cáo -->
<div class="modal fade" id="xacNhanBaoCaoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3" id="modalIconWrapper">
                        <span class="material-icons-outlined" id="modalIcon" style="font-size: 40px; color: #F59E0B;">help</span>
                    </div>
                </div>
                <h5 class="fw-bold mb-2" id="modalTitle">Xác nhận</h5>
                <p class="text-white-50 mb-4" id="modalMessage">Bạn có chắc muốn thực hiện hành động này?</p>
                <input type="hidden" id="actionType" />
                <input type="hidden" id="baoCaoId" />
                <input type="hidden" id="baiVietId" />
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <span class="material-icons-outlined me-1" style="font-size: 16px;">close</span>Hủy
                    </button>
                    <button type="button" class="btn btn-warning rounded-pill px-4" id="confirmActionBtn">
                        <span class="material-icons-outlined me-1" style="font-size: 16px;">check</span>Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
<script>
    // ===== TOAST FUNCTION =====
    function showToast(message, type = 'success') {
        let toastContainer = document.getElementById('toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'toast-container';
            toastContainer.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            document.body.appendChild(toastContainer);
        }
        
        const toast = document.createElement('div');
        toast.style.cssText = `
            background: ${type === 'success' ? '#10B981' : '#EF4444'};
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
            min-width: 280px;
        `;
        
        const icon = type === 'success' ? 'check_circle' : 'error_outline';
        toast.innerHTML = `
            <span class="material-icons-outlined">${icon}</span>
            <span style="flex: 1;">${message}</span>
            <button onclick="this.parentElement.remove()" style="background: none; border: none; color: white; cursor: pointer; opacity: 0.7; font-size: 18px;">×</button>
        `;
        
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    // Thêm animation CSS
    if (!document.getElementById('toast-animation-style')) {
        const style = document.createElement('style');
        style.id = 'toast-animation-style';
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        `;
        document.head.appendChild(style);
    }

    // ===== XEM TRƯỚC BÀI VIẾT =====
    function xemTruocBaiViet(baiVietId) {
        var modal = new bootstrap.Modal(document.getElementById('xemTruocModal'));
        modal.show();
        
        fetch('/Admin/BaoCaoBaiViet/XemTruocBaiViet?id=' + baiVietId)
            .then(response => response.text())
            .then(html => {
                document.getElementById('xemTruocContent').innerHTML = html;
            })
            .catch(error => {
                document.getElementById('xemTruocContent').innerHTML = '<p class="text-danger">Lỗi tải bài viết</p>';
            });
    }

    // ===== MỞ POPUP XÁC NHẬN =====
    function moPopupXacNhan(type, baoCaoId, baiVietId = 0) {
        document.getElementById('actionType').value = type;
        document.getElementById('baoCaoId').value = baoCaoId;
        document.getElementById('baiVietId').value = baiVietId;
        
        const modalTitle = document.getElementById('modalTitle');
        const modalMessage = document.getElementById('modalMessage');
        const modalIcon = document.getElementById('modalIcon');
        const modalIconWrapper = document.getElementById('modalIconWrapper');
        const confirmBtn = document.getElementById('confirmActionBtn');
        
        if (type === 'dongY') {
            modalTitle.innerText = 'Đồng ý báo cáo?';
            modalMessage.innerText = 'Đồng ý báo cáo sẽ XÓA bài viết này. Bạn chắc chắn?';
            modalIcon.innerText = 'delete';
            modalIcon.style.color = '#EF4444';
            modalIconWrapper.className = 'bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3';
            confirmBtn.className = 'btn btn-danger rounded-pill px-4';
            confirmBtn.innerHTML = '<span class="material-icons-outlined me-1" style="font-size: 16px;">delete</span>Xóa bài viết';
        } else {
            modalTitle.innerText = 'Từ chối báo cáo?';
            modalMessage.innerText = 'Báo cáo sẽ bị từ chối và chuyển sang trạng thái đã xử lý. Bạn chắc chắn?';
            modalIcon.innerText = 'close';
            modalIcon.style.color = '#F59E0B';
            modalIconWrapper.className = 'bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3';
            confirmBtn.className = 'btn btn-warning rounded-pill px-4';
            confirmBtn.innerHTML = '<span class="material-icons-outlined me-1" style="font-size: 16px;">close</span>Từ chối';
        }
        
        var modal = new bootstrap.Modal(document.getElementById('xacNhanBaoCaoModal'));
        modal.show();
    }

    // ===== XỬ LÝ XÁC NHẬN =====
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('confirmActionBtn').addEventListener('click', function() {
            const actionType = document.getElementById('actionType').value;
            const baoCaoId = document.getElementById('baoCaoId').value;
            const baiVietId = document.getElementById('baiVietId').value;
            
            var modal = bootstrap.Modal.getInstance(document.getElementById('xacNhanBaoCaoModal'));
            modal.hide();
            
            if (actionType === 'dongY') {
                thucHienDongYBaoCao(baoCaoId, baiVietId);
            } else {
                thucHienTuChoiBaoCao(baoCaoId);
            }
        });
    });

    // ===== THỰC HIỆN ĐỒNG Ý BÁO CÁO =====
    function thucHienDongYBaoCao(baoCaoId, baiVietId) {
        fetch('/Admin/BaoCaoBaiViet/DongYBaoCao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'baoCaoId=' + baoCaoId + '&baiVietId=' + baiVietId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('baoCao-' + baoCaoId).remove();
                showToast('Đã xóa bài viết và xử lý báo cáo thành công!', 'success');
                
                // Kiểm tra nếu hết báo cáo thì reload để hiện thông báo trống
                if (document.querySelectorAll('tbody tr').length === 0) {
                    setTimeout(() => location.reload(), 1500);
                }
            } else {
                showToast(data.message || 'Có lỗi xảy ra', 'error');
            }
        })
        .catch(error => {
            showToast('Có lỗi xảy ra', 'error');
        });
    }

    // ===== THỰC HIỆN TỪ CHỐI BÁO CÁO =====
    function thucHienTuChoiBaoCao(baoCaoId) {
        fetch('/Admin/BaoCaoBaiViet/TuChoiBaoCao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'baoCaoId=' + baoCaoId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('baoCao-' + baoCaoId).remove();
                showToast('Đã từ chối báo cáo!', 'success');
                
                // Kiểm tra nếu hết báo cáo thì reload
                if (document.querySelectorAll('tbody tr').length === 0) {
                    setTimeout(() => location.reload(), 1500);
                }
            } else {
                showToast(data.message || 'Có lỗi xảy ra', 'error');
            }
        })
        .catch(error => {
            showToast('Có lỗi xảy ra', 'error');
        });
    }

    // ===== GỌI TỪ NÚT (thay thế onclick cũ) =====
    function dongYBaoCao(baoCaoId, baiVietId) {
        moPopupXacNhan('dongY', baoCaoId, baiVietId);
    }

    function tuChoiBaoCao(baoCaoId) {
        moPopupXacNhan('tuChoi', baoCaoId);
    }
</script>