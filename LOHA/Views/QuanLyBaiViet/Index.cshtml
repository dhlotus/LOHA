@model List<LOHA.Models.Baiviet>
@{
    ViewData["Title"] = "Quản lý bài viết";
    Layout = "_LayoutLotus";
}

<div class="lotus-dashboard">
    <div class="lotus-welcome mb-4">
        <h2><span class="material-icons-outlined me-2" style="vertical-align: middle;">article</span>Quản lý bài viết</h2>
        <p class="text-white-50">Xem và quản lý tất cả bài viết trên hệ thống</p>
    </div>

    <!-- Bộ lọc -->
    <div class="lotus-card mb-4">
        <div class="lotus-card-header">
            <h5><span class="material-icons-outlined me-2">filter_list</span>Bộ lọc</h5>
        </div>
        <div class="lotus-card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control lotus-input" id="searchInput" placeholder="Tìm theo tên người đăng..." />
                </div>
                
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" onclick="filterPosts()">
                        <span class="material-icons-outlined me-1">search</span>Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách bài viết -->
    <div class="row g-3" id="postList">
        @foreach (var bv in Model)
        {
            <div class="col-12 post-item" data-user="@bv.User?.Ten" data-status="normal">
                <div class="lotus-card">
                    <div class="lotus-card-body p-3">
                        <div class="d-flex align-items-start gap-3">
                            <!-- Avatar -->
                            <img src="/images/default.png" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                            
                            <!-- Thông tin chính -->
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-1 text-white">@bv.User?.Ten</h6>
                                        <small class="text-white-50">
                                            ID: #@bv.Id | User ID: @bv.UserId |
                                            <span class="badge bg-secondary">Bài viết</span>
                                        </small>
                                    </div>
                                    <small class="text-white-50">@bv.Ngaydang.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                
                                <!-- Nội dung -->
                                <p class="text-white mb-2">
                                    @(bv.Noidung?.Length > 100 ? bv.Noidung.Substring(0, 100) + "..." : bv.Noidung)
                                </p>
                                
                                <!-- Ảnh (nếu có) -->
                                @if (!string.IsNullOrEmpty(bv.Anh))
                                {
                                    <img src="/baiviet/@bv.Anh" class="rounded mb-2" style="max-height: 100px; object-fit: cover;" />
                                }
                                
                                <!-- Stats & Actions -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-white-50 small">
                                        <span class="me-3"><i class="fa-regular fa-heart me-1"></i>@bv.Thichs?.Count ?? 0</span>
                                        <span><i class="fa-regular fa-comment me-1"></i>@bv.Binhluans?.Count ?? 0</span>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-danger" onclick="xoaBaiViet(@bv.Id)">
                                            <span class="material-icons-outlined" style="font-size: 16px;">delete</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Popup xác nhận xóa -->
<div class="modal fade" id="xoaBaiVietModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn xóa bài viết này?</p>
                <p class="text-danger small">Hành động này không thể hoàn tác!</p>
                <input type="hidden" id="xoaBaiVietId" />
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmXoaBaiViet()">Xóa</button>
            </div>
        </div>
    </div>
</div>

<script>
    function filterPosts() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    
        document.querySelectorAll('.post-item').forEach(item => {
            const userName = item.getAttribute('data-user').toLowerCase();
            const matchSearch = userName.includes(searchTerm);
        
            item.style.display = matchSearch ? 'block' : 'none';
        });
    }
    
    function xoaBaiViet(id) {
        document.getElementById('xoaBaiVietId').value = id;
        var modal = new bootstrap.Modal(document.getElementById('xoaBaiVietModal'));
        modal.show();
    }
    
    function confirmXoaBaiViet() {
        const id = document.getElementById('xoaBaiVietId').value;
        
        fetch('/Admin/QuanLyBaiViet/XoaBaiViet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'id=' + id
        })
        .then(response => response.json())
        .then(data => {
            var modal = bootstrap.Modal.getInstance(document.getElementById('xoaBaiVietModal'));
            modal.hide();
            
            if (data.success) {
                location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra');
        });
    }
</script>