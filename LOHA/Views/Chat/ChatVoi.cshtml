﻿<!-- BÙI ĐỨC HÀ - LOTUS -->
@model List<LOHA.Models.TinNhan>
@{
    if (ViewBag.NguoiNhan == null)
    {
        <div class="alert alert-danger">Không tìm thấy người dùng</div>
        return;
    }
    ViewData["Title"] = "Chat với " + ViewBag.NguoiNhan.Ten;
    string avatarNguoiNhan = string.IsNullOrEmpty(ViewBag.NguoiNhan?.Avatar) ? "/images/default.png" : ViewBag.NguoiNhan.Avatar;
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<div class="container-fluid px-2 px-md-3 py-3 py-md-4">
    <div class="chat-detail-container">
        <div class="chat-detail-card">
            
            <!-- ===== HEADER CHAT ===== -->
            <div class="chat-detail-header">
                <a href="/Chat/Index" class="chat-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                
                <div class="chat-header-avatar-wrapper">
                    <img src="@avatarNguoiNhan" class="chat-header-avatar" />
                </div>
                
                <div class="chat-header-info flex-grow-1">
                    <h5>@ViewBag.NguoiNhan.Ten</h5>
                </div>
                
                <!-- Icon menu (tùy chọn) -->
                <button class="chat-action-btn">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>
            </div>

            <!-- ===== KHUNG TIN NHẮN ===== -->
            <div class="chat-messages" id="khungChat">
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var tin in Model)
                    {
                        if (tin.NguoiGuiID == ViewBag.CurrentUserId)
                        {
                            <!-- Tin nhắn của mình (bên phải) -->
                            <div class="message-sent">
                                <div style="max-width: 70%;">
                                    <div class="message-bubble">
                                        <p class="mb-1">@tin.NoiDung</p>
                                    </div>
                                    <div class="message-time">
                                        @tin.ThoiGian.ToString("HH:mm")
                                        <span class="message-status">
                                            @if (tin.DaXem)
                                            {
                                                <i class="fa-solid fa-check-double" style="color: #6D5DFC;"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-check"></i>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Tin nhắn của đối phương (bên trái) -->
                            <div class="message-received">
                                <div class="message-avatar-wrapper">
                                    <img src="@avatarNguoiNhan" class="message-avatar" />
                                </div>
                                <div class="message-content">
                                    <div class="message-bubble">
                                        <p class="mb-1">@tin.NoiDung</p>
                                    </div>
                                    <div class="message-time">@tin.ThoiGian.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <span class="material-icons-outlined" style="font-size: 64px; color: #6D5DFC; opacity: 0.4;">chat_bubble_outline</span>
                        </div>
                        <h5 class="fw-bold" style="color: #2D1B69;">Chưa có tin nhắn nào</h5>
                        <p class="text-secondary">Hãy bắt đầu cuộc trò chuyện ngay!</p>
                    </div>
                }
            </div>

            <!-- ===== INPUT BAR (GLASSMORPHISM) ===== -->
            <div class="chat-input-bar">
                <div class="chat-input-wrapper">
                    <input type="text" id="noiDungTinNhan" placeholder="Nhập tin nhắn..." onkeypress="if(event.key === 'Enter') guiTinNhan()" />
                </div>
    
                <button class="chat-send-btn" onclick="guiTinNhan()">
                    <i class="fa-regular fa-paper-plane"></i>
                </button>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        var connection = null;
        var currentUserId = @ViewBag.CurrentUserId;
        var nguoiNhanId = @(ViewBag.NguoiNhan?.ID ?? 0);
        var avatarNguoiNhan = '@Html.Raw(avatarNguoiNhan)';

        document.addEventListener('DOMContentLoaded', function() {
        scrollToBottom();
        ketNoiSignalR();
        });

        function scrollToBottom() {
        var khungChat = document.getElementById('khungChat');
        if (khungChat) {
        khungChat.scrollTop = khungChat.scrollHeight;
        }
        }

        function ketNoiSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub?userId=" + currentUserId) 
                .withAutomaticReconnect()
                .build();

            connection.on("NhanTinMoi", function(nguoiGuiId, nguoiNhanId, noiDung, thoiGian) {
                // ✅ KIỂM TRA ĐÚNG: Người nhận có phải là mình không?
                // (nguoiNhanId từ server là ID người nhận TIN NHẮN)
                if (nguoiNhanId == currentUserId) {
                    var thoiGianFormatted = new Date(thoiGian).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        
                    var html = `
                        <div class="message-received">
                            <div class="message-avatar-wrapper">
                                <img src="${avatarNguoiNhan}" class="message-avatar" />
                            </div>
                            <div class="message-content">
                                <div class="message-bubble">
                                    <p class="mb-1">${noiDung}</p>
                                </div>
                                <div class="message-time">${thoiGianFormatted}</div>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('khungChat').insertAdjacentHTML('beforeend', html);
                    scrollToBottom();
                }
            });

            connection.start().then(function() {
                // Sau khi kết nối thành công, join vào phòng chat
                var roomId = currentUserId < nguoiNhanId 
                    ? `chat-${currentUserId}-${nguoiNhanId}` 
                    : `chat-${nguoiNhanId}-${currentUserId}`;
        
                connection.invoke("JoinPhongChat", roomId).catch(function(err) {
                    console.error('Lỗi join phòng:', err);
                });
            }).catch(function(err) {
                console.error('Lỗi kết nối SignalR:', err);
            });
        }

        function guiTinNhan() {
        var input = document.getElementById('noiDungTinNhan');
        var noiDung = input.value.trim();
                
        if (noiDung === '') return;
                
        var now = new Date();
        var thoiGian = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;

        fetch('/Chat/GuiTinNhan', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'nguoiNhanId=' + nguoiNhanId + '&noiDung=' + encodeURIComponent(noiDung)
        })
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        var html = `
        <div class="message-sent">
        <div style="max-width: 70%;">
        <div class="message-bubble">
        <p class="mb-1">${noiDung}</p>
        </div>
        <div class="message-time">
        ${thoiGian}
        <span class="message-status">
        <i class="fa-solid fa-check"></i>
        </span>
        </div>
        </div>
        </div>
        `;
                        
        document.getElementById('khungChat').insertAdjacentHTML('beforeend', html);
        input.value = '';
        scrollToBottom();
        } else {
        console.error('Lỗi:', data.message);
        }
        })
        .catch(error => {
        console.error('Error:', error);
        });
        }
    </script>
}