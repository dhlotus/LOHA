﻿<!-- BÙI ĐỨC HÀ - LOTUS -->
@model List<LOHA.Models.TinNhan>
@{
    if (ViewBag.NguoiNhan == null)
    {
        <div class="alert alert-danger">Không tìm thấy người dùng</div>
        return;
    }
    ViewData["Title"] = "Chat với " + ViewBag.NguoiNhan.Ten;
    string avatarNguoiNhan = string.IsNullOrEmpty(ViewBag.NguoiNhan?.Avatar) ? "/images/default.png" : ViewBag.NguoiNhan.Avatar;
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<div class="container-fluid px-2 px-md-3 py-3 py-md-4">
    <div class="chat-detail-container">
        <div class="chat-detail-card">
            
            <!-- ===== HEADER CHAT ===== -->
            <div class="chat-detail-header">
                <a href="/Chat/Index" class="chat-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                
                <div class="chat-header-avatar-wrapper">
                    <img src="@avatarNguoiNhan" class="chat-header-avatar" />
                </div>
                
                <div class="chat-header-info flex-grow-1">
                    <h5>@ViewBag.NguoiNhan.Ten</h5>
                </div>
                
                <!-- Dropdown menu 3 chấm -->
                <div class="dropdown">
                    <button class="chat-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item text-danger" href="#" onclick="moPopupXoaTinNhan(); return false;">
                                <i class="fa-regular fa-trash-can me-2"></i>Xóa tin nhắn
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- ===== KHUNG TIN NHẮN ===== -->
            <div class="chat-messages" id="khungChat">
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var tin in Model)
                    {
                        if (tin.NguoiGuiID == ViewBag.CurrentUserId)
                        {
                            <!-- Tin nhắn của mình (bên phải) -->
                            <div class="message-sent">
                                <div style="max-width: 70%;">
                                    <div class="message-bubble">
                                        <p class="mb-1">@tin.NoiDung</p>
                                    </div>
                                    <div class="message-time">
                                        @tin.ThoiGian.ToString("HH:mm")
                                        <span class="message-status">
                                            @if (tin.DaXem)
                                            {
                                                <i class="fa-solid fa-check-double" style="color: #6D5DFC;"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-check"></i>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Tin nhắn của đối phương (bên trái) -->
                            <div class="message-received">
                                <div class="message-avatar-wrapper">
                                    <img src="@avatarNguoiNhan" class="message-avatar" />
                                </div>
                                <div class="message-content">
                                    <div class="message-bubble">
                                        <p class="mb-1">@tin.NoiDung</p>
                                    </div>
                                    <div class="message-time">@tin.ThoiGian.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <span class="material-icons-outlined" style="font-size: 64px; color: #6D5DFC; opacity: 0.4;">chat_bubble_outline</span>
                        </div>
                        <h5 class="fw-bold" style="color: #2D1B69;">Chưa có tin nhắn nào</h5>
                        <p class="text-secondary">Hãy bắt đầu cuộc trò chuyện ngay!</p>
                    </div>
                }
            </div>

            <!-- ===== INPUT BAR (GLASSMORPHISM) ===== -->
            <div class="chat-input-bar">
                <div class="chat-input-wrapper">
                    <input type="text" id="noiDungTinNhan" placeholder="Nhập tin nhắn..." onkeypress="if(event.key === 'Enter') guiTinNhan()" />
                </div>
    
                <button class="chat-send-btn" onclick="guiTinNhan()">
                    <i class="fa-regular fa-paper-plane"></i>
                </button>
            </div>
            
        </div>
    </div>
</div>
<!-- ===== POPUP XÁC NHẬN XÓA TIN NHẮN ===== -->
<div class="modal fade" id="xoaTinNhanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4" style="background: #1E293B; color: white;">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3" style="background: rgba(239, 68, 68, 0.1) !important;">
                        <span class="material-icons-outlined" style="font-size: 48px; color: #EF4444;">delete_forever</span>
                    </div>
                </div>
                <h5 class="fw-bold mb-2" style="color: white;">Xóa tin nhắn?</h5>
                <p class="mb-4" style="color: rgba(255,255,255,0.7);">Toàn bộ lịch sử trò chuyện với <strong>@ViewBag.NguoiNhan.Ten</strong> sẽ bị xóa vĩnh viễn và không thể khôi phục.</p>
                <div class="d-flex gap-3 justify-content-center">
                    <button type="button" class="btn px-4 py-2 rounded-3" data-bs-dismiss="modal"
                            style="background: rgba(255,255,255,0.1); color: white; border: none;">
                        <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">close</span>
                        Hủy
                    </button>
                    <button type="button" class="btn px-4 py-2 rounded-3" onclick="xacNhanXoaTinNhan()"
                            style="background: #EF4444; color: white; border: none;">
                        <span class="material-icons-outlined me-1" style="font-size: 16px; vertical-align: middle;">delete</span>
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        var connection = null;
        var currentUserId = @ViewBag.CurrentUserId;
        var nguoiNhanId = @(ViewBag.NguoiNhan?.ID ?? 0);
        var avatarNguoiNhan = '@Html.Raw(avatarNguoiNhan)';

        document.addEventListener('DOMContentLoaded', function() {
        scrollToBottom();
        ketNoiSignalR();
        });

        function scrollToBottom() {
        var khungChat = document.getElementById('khungChat');
        if (khungChat) {
        khungChat.scrollTop = khungChat.scrollHeight;
        }
        }

        function ketNoiSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub?userId=" + currentUserId) 
                .withAutomaticReconnect()
                .build();

            connection.on("NhanTinMoi", function(nguoiGuiId, nguoiNhanId, noiDung, thoiGian) {
                // ✅ KIỂM TRA ĐÚNG: Người nhận có phải là mình không?
                // (nguoiNhanId từ server là ID người nhận TIN NHẮN)
                if (nguoiNhanId == currentUserId) {
                    var thoiGianFormatted = new Date(thoiGian).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        
                    var html = `
                        <div class="message-received">
                            <div class="message-avatar-wrapper">
                                <img src="${avatarNguoiNhan}" class="message-avatar" />
                            </div>
                            <div class="message-content">
                                <div class="message-bubble">
                                    <p class="mb-1">${noiDung}</p>
                                </div>
                                <div class="message-time">${thoiGianFormatted}</div>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('khungChat').insertAdjacentHTML('beforeend', html);
                    scrollToBottom();
                }
            });

            connection.start().then(function() {
                // Sau khi kết nối thành công, join vào phòng chat
                var roomId = currentUserId < nguoiNhanId 
                    ? `chat-${currentUserId}-${nguoiNhanId}` 
                    : `chat-${nguoiNhanId}-${currentUserId}`;
        
                connection.invoke("JoinPhongChat", roomId).catch(function(err) {
                    console.error('Lỗi join phòng:', err);
                });
            }).catch(function(err) {
                console.error('Lỗi kết nối SignalR:', err);
            });
        }

        function guiTinNhan() {
        var input = document.getElementById('noiDungTinNhan');
        var noiDung = input.value.trim();
                
        if (noiDung === '') return;
                
        var now = new Date();
        var thoiGian = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;

        fetch('/Chat/GuiTinNhan', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'nguoiNhanId=' + nguoiNhanId + '&noiDung=' + encodeURIComponent(noiDung)
        })
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        var html = `
        <div class="message-sent">
        <div style="max-width: 70%;">
        <div class="message-bubble">
        <p class="mb-1">${noiDung}</p>
        </div>
        <div class="message-time">
        ${thoiGian}
        <span class="message-status">
        <i class="fa-solid fa-check"></i>
        </span>
        </div>
        </div>
        </div>
        `;
                        
        document.getElementById('khungChat').insertAdjacentHTML('beforeend', html);
        input.value = '';
        scrollToBottom();
        } else {
        console.error('Lỗi:', data.message);
        }
        })
        .catch(error => {
        console.error('Error:', error);
        });
        }
        // ===== XÓA TIN NHẮN =====
        function moPopupXoaTinNhan() {
            var modal = new bootstrap.Modal(document.getElementById('xoaTinNhanModal'));
            modal.show();
        }

        function xacNhanXoaTinNhan() {
            fetch('/Chat/XoaTinNhan?nguoiNhanId=' + nguoiNhanId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                }
            })
            .then(response => response.json())
            .then(data => {
                // Đóng popup
                var modal = bootstrap.Modal.getInstance(document.getElementById('xoaTinNhanModal'));
                modal.hide();
        
                if (data.success) {
                    // Xóa hết tin nhắn trong khung chat
                    document.getElementById('khungChat').innerHTML = `
                        <div class="text-center py-5">
                            <div class="mb-4">
                                <span class="material-icons-outlined" style="font-size: 64px; color: #6D5DFC; opacity: 0.4;">chat_bubble_outline</span>
                            </div>
                            <h5 class="fw-bold" style="color: #2D1B69;">Chưa có tin nhắn nào</h5>
                            <p class="text-secondary">Hãy bắt đầu cuộc trò chuyện ngay!</p>
                        </div>
                    `;
                    showToast('Đã xóa toàn bộ tin nhắn', 'success');
                } else {
                    showToast(data.message || 'Có lỗi xảy ra', 'error');
                }
            })
            .catch(error => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('xoaTinNhanModal'));
                modal.hide();
                showToast('Có lỗi xảy ra', 'error');
                console.error('Lỗi:', error);
            });
        }

        // Hàm hiển thị Toast thông báo (nếu chưa có)
        function showToast(message, type = 'success') {
            let toastContainer = document.getElementById('toast-container');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'toast-container';
                toastContainer.style.cssText = 'position:fixed; top:20px; right:20px; z-index:9999;';
                document.body.appendChild(toastContainer);
            }
    
            const toast = document.createElement('div');
            toast.style.cssText = `
                background: ${type === 'success' ? '#10B981' : '#EF4444'};
                color: white;
                padding: 12px 20px;
                border-radius: 12px;
                margin-bottom: 10px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                display: flex;
                align-items: center;
                gap: 10px;
                animation: slideIn 0.3s ease;
                min-width: 250px;
            `;
    
            const icon = type === 'success' ? 'check_circle' : 'error_outline';
            toast.innerHTML = `
                <span class="material-icons-outlined">${icon}</span>
                <span style="flex:1;">${message}</span>
                <button onclick="this.parentElement.remove()" style="background:none;border:none;color:white;cursor:pointer;opacity:0.7;">×</button>
            `;
    
            toastContainer.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}