@model List<LOHA.Models.User>
@{
    var currentUserId = ViewBag.CurrentUserId;
    var tinCuoiDict = ViewBag.TinCuoi as Dictionary<int, LOHA.Models.TinNhan>;
}

@foreach (var user in Model)
{
    var tinCuoi = tinCuoiDict != null && tinCuoiDict.ContainsKey(user.ID)
        ? tinCuoiDict[user.ID]
        : null;

    string avatarUser = string.IsNullOrEmpty(user.Avatar) ? "/images/default.png" : user.Avatar;
    bool isUnread = tinCuoi != null && !tinCuoi.DaXem && tinCuoi.NguoiNhanID == currentUserId;
    
    <div class="chat-card-wrapper">
        <a href="/Chat/ChatVoi?userId=@user.ID" class="chat-card" data-username="@user.Ten.ToLower()">
            <div class="chat-avatar-wrapper">
                <img src="@avatarUser" class="chat-avatar" />
            </div>
        
            <div class="chat-info">
                <div class="chat-header">
                    <span class="chat-name">@user.Ten</span>
                    @if (tinCuoi != null)
                    {
                        <span class="chat-time">@tinCuoi.ThoiGian.ToString("HH:mm")</span>
                    }
                </div>
            
                <div class="chat-preview">
                    @if (tinCuoi != null)
                    {
                        <span class="chat-last-message">
                            @if (tinCuoi.NguoiGuiID == currentUserId)
                            {
                                <span style="opacity: 0.7;">Bạn: </span>
                            }
                            @tinCuoi.NoiDung
                        </span>
                    
                        @if (isUnread)
                        {
                            <span class="chat-badge-new"></span>
                        }
                    }
                    else
                    {
                        <span class="chat-last-message" style="opacity: 0.5;">👋 Bắt đầu trò chuyện</span>
                    }
                </div>
            </div>
        </a>
        <div class="chat-card-menu">
            <button class="chat-menu-btn" onclick="moPopupXoaChatNhanh(@user.ID, '@user.Ten')">
                <i class="fa-solid fa-ellipsis-vertical"></i>
            </button>
        </div>
    </div>
}