@using Microsoft.AspNetCore.Http
@{
    var user = Context.Session.GetString("user");
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - makefb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/makefb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a href="/User/Trangcanhan" class="navbar-brand">LOTUS</a>

                <div class="d-flex">
                    @if(user != null) // kiểm tra đăng nhập
                    {
                        <span class="text-white me-3">Xin chào: @user</span>
                        <a class="btn btn-light" href="/User/DangXuat">Đăng xuất</a>
                    } else // chưa đăng nhập thì hiện đăng nhập hoặc đăng ký
                    {
                        <a class="btn btn-light me-2" href="/User/DangNhap">Đăng nhập</a>
                        <a class="btn btn-light me-2" href="/User/DangKy">Đăng ký</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
