@model makefb.Models.LoginViewModel;

<form asp-action="DangNhap" method="post">
    <div class="mb-3">
        <label>Email hoặc SĐT</label>
        <input asp-for="EmailorSDT" class="form-control" type="text"/>
        <span asp-validation-for="EmailorSDT" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Mật khẩu</label>
        <input asp-for="Matkhau" class="form-control" type="password"/>
        <span asp-validation-for="Matkhau" class="text-danger"></span>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <button type="submit" class="btn btn-primary">
        Đăng nhập
    </button>
    <p class="p-5">Bạn chưa có tài khoản <a href="/User/DangKy" class="btn-link">Đăng ký</a></p>
</form>