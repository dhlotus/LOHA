@model User // view nhân dữ liệu kiểu user ____ đẩy code mới

<div class="container mt-4">
    <div class="position-relative">
        <img src="/images/cover.jpg" 
                class="img-fluid w-100 rounded" 
                style="height:350px; 
                       object-fit:cover;"/>

        <img src="/images/default.png"
             class="rounded-circle border border-white shadow"
             style="width: 160px;
                    height:160px;
                    object-fit:cover;
                    position:absolute;
                    bottom: -80px;
                    left: 40px"/>
    </div>

    <div style="margin: 20px; margin-left: 220px;">
        <h3 class="fw-bold">@Model.Ten</h3>
    </div>

    <div class="mt-lg-5 bg-white border rounded p-2">
        <div class="mt-4 bg-white border rounded p-2">
            <ul class="nav nav-tabs border-0 justify-content-center">
                <li class="nav-item mx-3">
                    <a class="nav-link active fw-bold text-primary border-bottom border-3">Bài Viết</a>
                </li>

                <li class="nav-item mx-3">
                    <a class="nav-link text-dark border-0">Ảnh</a>
                </li>

                <li class="nav-item mx-3">
                    <a></a>
                    <a class="nav-link text-dark border-0">Bạn bè</a>
                </li>
            </ul>
        </div>
        <div class="mt-3">
            <div class="row">
                
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Giới thiệu</h5>

                            <p>
                                <strong>Tên: </strong> @Model.Ten
                            </p>

                            <p>
                                <strong>Email / SĐT: </strong> @Model.EmailorSDT
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-8 bg-white border rounded p-3">

                    <h5 class="fw-bold mb-3">Bài viết</h5>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex">
                                <img src="/images/default.png" 
                                     class="rounded-circle me-2"
                                     style="width:40px;
                                            height: 40px;
                                            object-fit:cover"/>
                                <textarea class="form-control" 
                                          rows="2"
                                          max-line="5"
                                          placeholder="Bạn đang nghĩ gì?"
                                          style="max-height:140px"></textarea>
                            </div>
                            
                            <div class="text-end mt-2">
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <button class="btn btn-light border">
                                        📷 Ảnh / Video
                                    </button>

                                    <button class="btn btn-primary">
                                        Bài đăng
                                    </button>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    <!--khung bài viết-->
                    <div class="card">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-2">
                                <img src="/images/default.png" 
                                     class="rounded-circle me-2"
                                     style="width:40px; height:40px; object-fit:cover"/>

                                <div>
                                    <strong>@Model.Ten</strong> <br />
                                    <small class="text-muted">Bây giờ</small>
                                </div>
                            </div>
                            <p>
                                Status nha
                            </p>
                            <img src="/images/cover.jpg" class="img-fluid rounded" />
                            <hr />
                            <!--cảm xúc-->

                            <div class="d-flex justify-content-around text-muted">
                                <button class="btn btn-light">
                                    👍 Thích
                                </button>

                                <button class="btn btn-light">
                                    💬 Bình luận
                                </button>

                                <button class="btn btn-light">
                                    ↗ Chia sẻ
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
        
    </div>
</div>
